i_ctxMitigated   = input.bool(false, "Mostrar traspasadas (frontera gris: mit + barridas + EQ tomadas)", group = GRP_CTX)
// Inputs de deteccion — MISMOS defaults que el Visual (paridad de deteccion; ADR-017).
i_swingLen       = input.int(5,      "Swing length",                    minval = 2, group = GRP_CTX)
