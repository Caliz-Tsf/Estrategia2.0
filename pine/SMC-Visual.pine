i_swingLen    = input.int(5, "Swing length",    minval = 2, group = GRP_STRUCT)
i_internalLen = input.int(3, "Internal length", minval = 1, group = GRP_STRUCT)
i_showMajor   = input.bool(true,  "Mostrar estructura dominante (50)", group = GRP_STRUCT)
i_showMajorSwings = input.bool(false, "Mostrar HH/HL/LH/LL dominantes", group = GRP_STRUCT)
i_showSwings  = input.bool(true, "Mostrar swings (HH/HL/LH/LL)", group = GRP_STRUCT)
i_showStruct  = input.bool(true,  "Mostrar BOS/CHoCH (swing)",   group = GRP_STRUCT)
i_showInternal = input.bool(false, "Mostrar BOS/CHoCH interno",  group = GRP_STRUCT)
i_showOB         = input.bool(true,  "Mostrar Order Blocks",              group = GRP_OB)
i_obHighVolFactor = input.float(2.0, "Filtro volatilidad (x ATR200)", minval = 0.5, step = 0.1, group = GRP_OB)
i_obMitClose     = input.bool(false, "Mitigacion por cierre (vs mecha)",  group = GRP_OB)
i_showFVG      = input.bool(true,  "Mostrar Fair Value Gaps",          group = GRP_FVG)
i_fvgThreshold = input.float(0.25, "Umbral tamaño (x ATR14)", minval = 0.0, step = 0.05, group = GRP_FVG)
i_showCE       = input.bool(true,  "Mostrar nivel CE (50%)",           group = GRP_FVG)
i_showPD       = input.bool(true,  "Mostrar Premium/Discount",         group = GRP_PD)
i_pdSwingLen   = input.int(50,     "Swing P/D (rango dominante)", minval = 10, group = GRP_PD)
i_pdEqBand     = input.float(5.0,  "Banda equilibrium (± %)", minval = 0.0, maxval = 25.0, step = 0.5, group = GRP_PD)
i_showEQHL     = input.bool(true,  "Mostrar Equal Highs/Lows",         group = GRP_EQHL)
i_eqThreshold  = input.float(0.1,  "Umbral igualdad (x ATR14)", minval = 0.0, maxval = 0.5, step = 0.05, group = GRP_EQHL)
i_eqlLength    = input.int(3,      "Barras confirmacion EQH/EQL", minval = 1, group = GRP_EQHL)
i_showPools    = input.bool(true,  "Mostrar pools de liquidez (BSL/SSL)", group = GRP_LIQ)
i_poolTol      = input.float(0.1,  "Tolerancia cluster (x ATR14)", minval = 0.0, maxval = 0.5, step = 0.05, group = GRP_LIQ)
i_minTouches   = input.int(2,      "Toques minimos para pool", minval = 2, group = GRP_LIQ)
i_showSwept    = input.bool(true,  "Mostrar pools barridos (historial)", group = GRP_LIQ)
i_showSweeps   = input.bool(true,  "Mostrar marcadores de sweep (trampa)", group = GRP_LIQ)
i_maxShowSweeps= input.int(20,     "Max marcadores de sweep (recientes)", minval = 1, group = GRP_LIQ)
i_sessionProfile = input.string("FX-London-NY", "Perfil de sesión", options = ["FX-London-NY", "FX-Asia", "None"], group = GRP_KZ)
