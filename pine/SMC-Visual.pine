indicator("SMC Engine — Visual", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// === INPUTS ===
// Grupos canonicos (reglas-dev §1.3). Esqueleto: solo toggles base; cada
// concepto añade su grupo en su tarea (T02+).
GRP_STRUCT = "Estructura"
GRP_OB     = "Order Blocks"
GRP_FVG    = "Fair Value Gaps"
GRP_PD     = "Premium/Discount"
GRP_PANEL  = "Panel"
i_showPanel   = input.bool(true, "Mostrar panel de estado", group = GRP_PANEL)
i_swingLen    = input.int(5, "Swing length",    minval = 2, group = GRP_STRUCT)
i_internalLen = input.int(3, "Internal length", minval = 1, group = GRP_STRUCT)
i_showSwings  = input.bool(true, "Mostrar swings (HH/HL/LH/LL)", group = GRP_STRUCT)
i_showStruct  = input.bool(true,  "Mostrar BOS/CHoCH (swing)",   group = GRP_STRUCT)
i_showInternal = input.bool(false, "Mostrar BOS/CHoCH interno",  group = GRP_STRUCT)
i_showOB         = input.bool(true,  "Mostrar Order Blocks",              group = GRP_OB)
i_obHighVolFactor = input.float(2.0, "Filtro volatilidad (x ATR200)", minval = 0.5, step = 0.1, group = GRP_OB)
i_obMitClose     = input.bool(false, "Mitigacion por cierre (vs mecha)",  group = GRP_OB)
i_showFVG      = input.bool(true,  "Mostrar Fair Value Gaps",          group = GRP_FVG)
i_fvgThreshold = input.float(0.25, "Umbral tamaño (x ATR14)", minval = 0.0, step = 0.05, group = GRP_FVG)
i_showCE       = input.bool(true,  "Mostrar nivel CE (50%)",           group = GRP_FVG)
i_showPD       = input.bool(true,  "Mostrar Premium/Discount",         group = GRP_PD)
i_pdSwingLen   = input.int(50,     "Swing P/D (rango dominante)", minval = 10, group = GRP_PD)
i_pdEqBand     = input.float(5.0,  "Banda equilibrium (± %)", minval = 0.0, maxval = 25.0, step = 0.5, group = GRP_PD)

// === LIBRARY CORE ===
// ---------------------------------------------------------------------------
// Nucleo de deteccion SMC/ICT. BYTE-IDENTICO en SMC-Visual y SMC-Strategy
// (lo vigila scripts/check-core-sync.ps1 — regla dura #2). El core NO dibuja y
// NO llama request.security(): solo tipos, constantes y funciones puras
// (entradas -> detecciones). La version exportable equivalente vive en
// SMC-Library.pine [D-PINE-01]. Esqueleto F1-S1.1-T01: tipos + constantes +
// arrays acotados; las f_detect*/f_compute* se añaden en T02+.
// ---------------------------------------------------------------------------
// Constantes 'kind' por categoria [reglas-dev §1.2 · PINE-PLAN §2]
KIND_OB          = 1
KIND_FVG         = 2
KIND_BREAKER     = 3
KIND_REJECTION   = 4
KIND_MITIGATION  = 5
KIND_OTE         = 6
KIND_GP          = 7
KIND_BOS          = 20
KIND_CHOCH        = 21
KIND_MSS          = 22
KIND_SWEEP        = 23
KIND_GRAB         = 24
KIND_JUDAS        = 25
KIND_DISPLACEMENT = 26
KIND_IDM          = 27
KIND_EMACROSS     = 28
KIND_EMABOUNCE    = 29
KIND_FLIP         = 30
KIND_HH = 40
KIND_HL = 41
KIND_LH = 42
KIND_LL = 43
DIR_BULL     = 1
DIR_BEAR     = -1
ZS_ACTIVE    = 0
ZS_PARTIAL   = 1
ZS_MITIGATED = 2
ZS_INVALID   = 3
PD_DISCOUNT    = -1
PD_EQUILIBRIUM = 0
PD_PREMIUM     = 1
MAX_ZONES  = 50
MAX_EVENTS = 100
MAX_SWINGS = 100
MAX_POOLS  = 50
MAX_BARBUF = 500
type SMC_Zone
    float  top
    float  bottom
    int    dir
    int    barIdx
    int    barTime
    int    state        = 0
    float  mitigatedPct = 0.0
    string tf           = ""
    int    kind         = 0
type SMC_Event
    float  price
    int    dir
    int    barIdx
    int    barTime
    string tf   = ""
    int    kind = 0
type SMC_Swing
    float  price
    int    barIdx
    int    barTime
    int    kind  = 0
    bool   swept = false
type SMC_Pool
    float  level
    int    dir
    int    touches  = 1
    int    barTime
    bool   swept    = false
    string tf       = ""
type SMC_TFState
    int    bias           = 0
    float  lastBOSPrice   = na
    int    lastBOSDir     = 0
    int    lastBOSTime    = 0
    float  lastCHoCHPrice = na
    int    lastCHoCHDir   = 0
    int    lastCHoCHTime  = 0
    float  pdHigh         = na
    float  pdLow          = na
    float  ema20          = na
    float  ema50          = na
    float  ema200         = na
f_pushZone(array<SMC_Zone> a, SMC_Zone z, int maxN) =>
    array.push(a, z)
    if array.size(a) > maxN
        array.shift(a)
    array.size(a)
f_pushEvent(array<SMC_Event> a, SMC_Event e, int maxN) =>
    array.push(a, e)
    if array.size(a) > maxN
        array.shift(a)
    array.size(a)
f_pushSwing(array<SMC_Swing> a, SMC_Swing s, int maxN) =>
    array.push(a, s)
    if array.size(a) > maxN
        array.shift(a)
    array.size(a)
f_pushPool(array<SMC_Pool> a, SMC_Pool p, int maxN) =>
    array.push(a, p)
    if array.size(a) > maxN
        array.shift(a)
    array.size(a)

// --- Swings + clasificacion HH/HL/LH/LL [reglas-smc-ict §1.1/§1.2] · T02 ---
// f_detectSwings: pivote simetrico estricto. high[len] > high de las len velas a
// cada lado (low simetrico). Equivale a ta.pivothigh/low(len, len). Confirmado al
// cierre de la vela t+len -> latencia len velas, cero repaint [§1.1]. Devuelve
// [precioHigh, precioLow] del pivote centrado len velas atras; na si no hay.
f_detectSwings(int len) =>
    [ta.pivothigh(len, len), ta.pivotlow(len, len)]

// f_classifySwing: etiqueta el swing recien confirmado contra el swing previo del
// MISMO tipo (high vs high, low vs low) [§1.2]. isHigh = true si es swing high.
// Recorre los swings almacenados de atras hacia adelante hasta el ultimo del mismo
// tipo. Igualdad exacta de precio: no reclasifica -> hereda el kind previo
// (candidato EQH/EQL). Primer swing del tipo (sin referencia): seed HH/LL.
// INVARIANTE [T02 · obs. validador 97/100]: la clasificacion filtra por tipo
// (sHigh == isHigh), asi que un swing high y un swing low confirmados en la MISMA
// vela t (caso spike, casi imposible con swingLen=5 en H1) se etiquetan de forma
// independiente y NO interfieren. No se asume alternancia high/low aguas abajo:
// BOS/CHoCH/MSS/EQH/EQL leen por tipo. Anotado para revision Fable pre-Fase 4
// (docs/notas-revision-fable.md) por paridad MQL5 (golden tests, ADR-002).
f_classifySwing(bool isHigh, float price, array<SMC_Swing> swings) =>
    int   prevKind  = na
    float prevPrice = na
    if array.size(swings) > 0
        for i = array.size(swings) - 1 to 0
            SMC_Swing s = array.get(swings, i)
            bool sHigh = s.kind == KIND_HH or s.kind == KIND_LH
            if sHigh == isHigh
                prevKind  := s.kind
                prevPrice := s.price
                break
    int kind = na
    if isHigh
        kind := na(prevPrice) ? KIND_HH : price > prevPrice ? KIND_HH : price < prevPrice ? KIND_LH : prevKind
    else
        kind := na(prevPrice) ? KIND_LL : price > prevPrice ? KIND_HL : price < prevPrice ? KIND_LL : prevKind
    kind

// --- Estructura de mercado: BOS / CHoCH [reglas-smc-ict §1.3/§1.4] · T03 ---
// Modelo de bias estructural (reglas, seccion "Modelo de bias estructural"): por
// escala se mantiene el ultimo swing high y el ultimo swing low confirmados
// (highLevel/lowLevel) con un flag 'crossed' que evita re-disparar sobre el mismo
// nivel, y un 'bias' (+1/-1) fijado por la ultima ruptura. La distincion BOS vs
// CHoCH la da el bias vigente al romper [reglas §1.3/§1.4]:
//   - close rompe el nivel que EXTIENDE la tendencia -> BOS  (continuacion).
//   - close rompe el nivel que PROTEGE  la tendencia -> CHoCH (cambio de caracter).
// Ruptura por CIERRE estricto (close > highLevel / close < lowLevel), NO por mecha
// [§1.3]; el flag 'crossed' replica el 'topBroken/btmBroken' del oraculo de paridad
// scripts/ver05/detect.py (ADR-002) y el 'pivot.crossed' de LuxAlgo displayStructure
// (ref :551-612, v5->v6). El guard barstate.isconfirmed (en DETECCION) hace que el
// cierre que rompe sea definitivo -> anti-repaint [D-PINE-03]. Escala swing
// (swingLen) y escala interna (internalLen) se trackean en SMC_Structure separados;
// el bias mayor es el de la escala swing: una ruptura INTERNA no voltea el bias swing
// [§1.4]. okHigh/okLow permiten el guard de nivel-distinto del interno (no duplicar
// la senal swing cuando el pivote interno coincide, cf. LuxAlgo extraCondition
// internalHigh.currentLevel != swingHigh.currentLevel).
type SMC_Structure
    float highLevel   = na
    int   highBarIdx  = na
    int   highTime    = na
    bool  highCrossed = false
    float lowLevel    = na
    int   lowBarIdx   = na
    int   lowTime     = na
    bool  lowCrossed  = false
    int   bias        = 0

// f_setStructureHigh/Low: fija un swing recien confirmado como nivel estructural
// vigente y resetea 'crossed' (nivel fresco, aun no roto). Por construccion del
// pivote, el close de la barra de confirmacion nunca rompe el nivel recien fijado.
f_setStructureHigh(SMC_Structure st, float price, int barIdx, int barTime) =>
    st.highLevel   := price
    st.highBarIdx  := barIdx
    st.highTime    := barTime
    st.highCrossed := false

f_setStructureLow(SMC_Structure st, float price, int barIdx, int barTime) =>
    st.lowLevel   := price
    st.lowBarIdx  := barIdx
    st.lowTime    := barTime
    st.lowCrossed := false

// f_detectStructure: evalua ruptura por cierre del nivel estructural vigente y, si
// hay, muta el estado (crossed + bias) y devuelve el SMC_Event (na si no hay).
// Prioriza el lado alcista (else-if): un mismo close no puede superar el highLevel y
// perforar el lowLevel salvo niveles invertidos, caso que no ocurre con estructura
// sana; el oraculo ver05 usa dos if separados y produce la misma lista en la ventana
// validada. price = nivel roto; barIdx/barTime = barra de ruptura; kind = BOS|CHoCH.
f_detectStructure(SMC_Structure st, int breakBarIdx, int breakTime, bool okHigh, bool okLow) =>
    SMC_Event ev = na
    if okHigh and not na(st.highLevel) and not st.highCrossed and close > st.highLevel
        int tag = st.bias == DIR_BEAR ? KIND_CHOCH : KIND_BOS
        st.highCrossed := true
        st.bias        := DIR_BULL
        ev := SMC_Event.new(st.highLevel, DIR_BULL, breakBarIdx, breakTime, "", tag)
    else if okLow and not na(st.lowLevel) and not st.lowCrossed and close < st.lowLevel
        int tag = st.bias == DIR_BULL ? KIND_CHOCH : KIND_BOS
        st.lowCrossed := true
        st.bias        := DIR_BEAR
        ev := SMC_Event.new(st.lowLevel, DIR_BEAR, breakBarIdx, breakTime, "", tag)
    ev

// f_updateTFState: consolida la ultima ruptura estructural de escala SWING en el
// snapshot SMC_TFState (bias headline + ultimo BOS y ultimo CHoCH). Es el formato
// PLANO que cruzara request.security al MTF [Sprint 1.4] y alimentara el scoring
// [Sprint 2.1] (los UDT no viajan por security; ver PINE-PLAN §4). Solo entra el
// evento de escala SWING -> una ruptura INTERNA no toca el bias mayor [§1.4]. El
// bias = ev.dir (ya sincronizado con structSwing.bias tras f_detectStructure). ev =
// evento swing (na si no hubo ruptura en la barra). Devuelve el state mutado.
f_updateTFState(SMC_TFState state, SMC_Event ev) =>
    if not na(ev)
        state.bias := ev.dir
        if ev.kind == KIND_BOS
            state.lastBOSPrice := ev.price
            state.lastBOSDir   := ev.dir
            state.lastBOSTime  := ev.barTime
        else if ev.kind == KIND_CHOCH
            state.lastCHoCHPrice := ev.price
            state.lastCHoCHDir   := ev.dir
            state.lastCHoCHTime  := ev.barTime
    state

// --- Order Blocks + mitigacion [reglas-smc-ict §2.1] · T05 ---
// Porta el algoritmo de Order Blocks de LuxAlgo (storeOrdeBlock :502-525,
// deleteOrderBlocks :478-500; v5->v6). El OB es la vela origen del impulso que rompe
// estructura: en ruptura ALCISTA, la vela de MINIMO de la pierna [pivote roto ->
// ruptura]; en BAJISTA, la de MAXIMO. El SWAP high<->low en barras de alta
// volatilidad ((hi-lo) >= highVolFactor*vol) excluye la vela de impulso -> el OB es la
// ultima consolidacion ANTES del impulso. Zona = [low, high] de esa vela (obBounds
// high/low, §2.1). En vez de referencia historica dinamica de series (fragil: RE10045
// fuera de la historia cargada + sin equivalente MQL5), recorre buffers ROLLING de
// barras (bHighs/bLows/bIdxs/bTimes/bVols, que el consumidor puebla cada barra
// confirmada) -> runtime-safe y portable a golden tests MQL5 (ADR-002). Recorre el
// buffer de atras hacia adelante incluyendo barras con originBarIdx <= barIdx <
// ev.barIdx (excluye la barra de ruptura, igual que el slice de LuxAlgo). Solo con
// ruptura CONFIRMADA -> no repinta [§2.1, D-PINE-03]. Devuelve SMC_Zone ZS_ACTIVE o na.
// LIMITE: si originBarIdx (pivote roto) quedo a mas de MAX_BARBUF barras atras, sale del
// buffer rolling y se devuelve na SIN aviso (~21 dias en H1). Replicar el limite en MQL5
// (golden tests, ADR-002); si en Fase 3 estorba, subir MAX_BARBUF o loggear el miss.
f_detectOB(SMC_Event ev, int originBarIdx, array<float> bHighs, array<float> bLows, array<int> bIdxs, array<int> bTimes, array<float> bVols, float highVolFactor, int kind) =>
    SMC_Zone z = na
    if not na(ev) and not na(originBarIdx)
        int n = array.size(bIdxs)
        int   bestPos = na
        float bestVal = na
        if n > 0
            for p = n - 1 to 0
                int bi = array.get(bIdxs, p)
                if bi < originBarIdx
                    break
                if bi < ev.barIdx
                    float hi = array.get(bHighs, p)
                    float lo = array.get(bLows, p)
                    bool hv = (hi - lo) >= (highVolFactor * array.get(bVols, p))
                    if ev.dir == DIR_BULL
                        float pv = hv ? hi : lo
                        if na(bestVal) or pv < bestVal
                            bestVal := pv
                            bestPos := p
                    else
                        float pv = hv ? lo : hi
                        if na(bestVal) or pv > bestVal
                            bestVal := pv
                            bestPos := p
        if not na(bestPos)
            z := SMC_Zone.new(array.get(bHighs, bestPos), array.get(bLows, bestPos), ev.dir, array.get(bIdxs, bestPos), array.get(bTimes, bestPos), ZS_ACTIVE, 0.0, "", kind)
    z

// f_updateZoneMitigation: maquina de estados de mitigacion/invalidacion del UDT
// SMC_Zone [§2.1]. Mas rica que el borrado binario de LuxAlgo (deleteOrderBlocks
// ref :481-500): cuatro estados + mitigatedPct. useClose = fuente (§2.1
// obMitigation): true exige CIERRE dentro; false (HIGHLOW, default) basta la mecha.
// OB ALCISTA (soporte, el precio entra desde arriba): borde cercano = top, borde
// lejano/protector = bottom. PARCIAL si la fuente perfora el top sin llegar al
// bottom (mitigatedPct = (top-src)/altura); MITIGADA si la fuente alcanza el bottom
// (borde lejano, "hizo su trabajo"); INVALIDA si una vela CIERRA bajo el bottom
// (borde protector roto -> candidato a Breaker §Tier2). Bajista simetrico (entra
// desde abajo; protector = top; invalida si close > top). La invalidacion (close)
// tiene prioridad sobre la mitigacion (mecha). ZS_INVALID es terminal; ZS_MITIGATED
// no regresa a PARCIAL (guard state < ZS_MITIGATED) pero puede escalar a INVALID.
// Anti-repaint: llamar dentro de barstate.isconfirmed.
f_updateZoneMitigation(SMC_Zone z, bool useClose) =>
    if z.state != ZS_INVALID
        float height = z.top - z.bottom
        if z.dir == DIR_BULL
            float src = useClose ? close : low
            if close < z.bottom
                z.state := ZS_INVALID
                z.mitigatedPct := 1.0
            else if src <= z.bottom
                z.state := ZS_MITIGATED
                z.mitigatedPct := 1.0
            else if src < z.top
                if z.state < ZS_MITIGATED
                    z.state := ZS_PARTIAL
                z.mitigatedPct := math.max(z.mitigatedPct, height > 0 ? (z.top - src) / height : 0.0)
        else
            float src = useClose ? close : high
            if close > z.top
                z.state := ZS_INVALID
                z.mitigatedPct := 1.0
            else if src >= z.top
                z.state := ZS_MITIGATED
                z.mitigatedPct := 1.0
            else if src > z.bottom
                if z.state < ZS_MITIGATED
                    z.state := ZS_PARTIAL
                z.mitigatedPct := math.max(z.mitigatedPct, height > 0 ? (src - z.bottom) / height : 0.0)
    z

// --- Fair Value Gaps (FVG) + CE [reglas-smc-ict §2.2] · T06 ---
// f_detectFVG: ineficiencia de 3 velas (hueco sin negociar). Evaluada al CIERRE de la
// 3.a vela (la actual al confirmar) sobre offsets FIJOS [0] y [2] -> referencia
// historica ESTATICA (no dinamica): RE10045-safe y trivial en MQL5 (rates[i-2]).
// Funcion pura: recibe los 4 precios (h0/l0 vela actual, h2/l2 vela -2), no lee series
// -> golden tests MQL5 directos (ADR-002). FVG alcista: low[0] > high[2] -> gap
// [high[2], low[0]] (dir BULL); bajista: high[0] < low[2] -> gap [high[0], low[2]]
// (dir BEAR). Mutuamente excluyentes (un mismo trio no es alcista y bajista a la vez).
// Filtro de tamaño: altura >= threshold (modo fixed: 0.25*ATR14, el default validado y
// congelado ADR-002; el modo auto de LuxAlgo es %-based y choca con la doctrina ATR
// (regla dura #3) -> NO se porta, revisitar en Fase 3 solo si estorba). El CE (50% =
// (top+bottom)/2) NO se almacena: se deriva de top/bottom en dibujo y scoring (#26
// FVG-CE tocado). Mitigacion via la MISMA maquina f_updateZoneMitigation (§2.2 "igual
// maquina de estados que el OB"). barIdx/barTime = 3.a vela (oraculo ver05 bars[i]['t']).
// Anti-repaint: llamar en barstate.isconfirmed [§2.2, D-PINE-03]. NB: LuxAlgo usa
// request.security(...lookahead_on) (:634, repinta) + filtro extra close>high[2]; aqui
// NO (TF propio, sin lookahead; el oraculo solo exige gap + umbral). Devuelve SMC_Zone
// ZS_ACTIVE o na.
f_detectFVG(float h0, float l0, float h2, float l2, int barIdx, int barTime, float threshold, int kind) =>
    SMC_Zone z = na
    if l0 > h2 and (l0 - h2) >= threshold
        z := SMC_Zone.new(l0, h2, DIR_BULL, barIdx, barTime, ZS_ACTIVE, 0.0, "", kind)
    else if h0 < l2 and (l2 - h0) >= threshold
        z := SMC_Zone.new(l2, h0, DIR_BEAR, barIdx, barTime, ZS_ACTIVE, 0.0, "", kind)
    z

// --- Premium / Discount / Equilibrium [reglas-smc-ict §2.3] · T07 ---
// Porta el "dealing range" de LuxAlgo basado en trailing extremes (type
// trailingExtremes :181, updateTrailingExtremes :709-713, drawPremiumDiscountZones
// :755-761; v5->v6). El rango operativo vigente [bottom, top] se ANCLA al ultimo swing
// high/low confirmado (f_resetTrailing*, cf. LuxAlgo getCurrentStructure :430-454, solo
// escala SWING — no interno) y luego SE EXPANDE vela a vela con el precio
// (f_updateTrailing, max(high)/min(low)) -> el rango captura extension mas alla del
// ultimo swing sin esperar otra confirmacion. eq = punto medio (50%).
// DECISION DISENO T07 (opcion A, ver docs/decisiones-pd-rango.md): el rango = trailing
// extremes de LuxAlgo, NO "ultimo strong high/low por BOS/CHoCH" (opcion B). Motivo:
// paridad directa con la unica referencia externa permitida + portabilidad limpia a
// MQL5 (estado plano, sin depender del historial de eventos estructurales).
// Premium/Discount es una ZONA (localizacion), no un evento -> su expansion EN VIVO es
// aceptable y replica a LuxAlgo (PINE-PLAN §4.4: las zonas se extienden en vivo, los
// eventos solo se confirman al cierre). Para el scoring, el snapshot
// (chartState.pdHigh/pdLow) se actualiza en barstate.isconfirmed -> determinista.
// NB paridad: f_updateTrailing inicializa explicitamente desde na (rango = min/max de
// la historia hasta el 1.er swing, luego se ancla); LuxAlgo deja na por la propagacion
// math.max(x,na)=na. Desviacion intencional, determinista y mas facil de portar a MQL5
// (golden tests, ADR-002); irrelevante en la historia validada (no en la barra 1).
type SMC_Trailing
    float top        = na
    float bottom     = na
    int   topTime    = na
    int   bottomTime = na
    int   barIdx     = na
    int   barTime    = na

// f_resetTrailingHigh/Low: ancla un extremo del rango al swing recien confirmado
// (nivel + barra). barIdx/barTime = ancla izquierda para el dibujo de las zonas.
f_resetTrailingHigh(SMC_Trailing tr, float price, int barIdx, int barTime) =>
    tr.top     := price
    tr.topTime := barTime
    tr.barIdx  := barIdx
    tr.barTime := barTime

f_resetTrailingLow(SMC_Trailing tr, float price, int barIdx, int barTime) =>
    tr.bottom     := price
    tr.bottomTime := barTime
    tr.barIdx     := barIdx
    tr.barTime    := barTime

// f_updateTrailing: expande el rango con el precio de la barra (cf. LuxAlgo
// updateTrailingExtremes). top = max(high desde el ultimo reset); bottom = min(low).
// Llamar en barstate.isconfirmed para un snapshot determinista. Devuelve el tr mutado.
f_updateTrailing(SMC_Trailing tr, float h, float l, int t) =>
    if na(tr.top) or h > tr.top
        tr.top     := h
        tr.topTime := t
    if na(tr.bottom) or l < tr.bottom
        tr.bottom     := l
        tr.bottomTime := t
    tr

// f_premiumDiscount: clasifica la posicion de 'price' en el rango [bottom, top].
// Devuelve [zona, pct]: pct = (price-bottom)/(top-bottom) en 0..1 (0=bottom/discount
// extremo, 1=top/premium extremo); zona ∈ {PD_PREMIUM, PD_DISCOUNT, PD_EQUILIBRIUM}.
// La banda equilibrium [eqLo, eqHi] (default 0.45-0.55, §2.3) tiene PRIORIDAD: dentro
// de ella -> EQUILIBRIUM (confluencia #31, resta peso por falta de ventaja). Fuera:
// pct>0.5 premium (favorece short), pct<0.5 discount (favorece long); el corte real
// premium/discount es el 50% (§2.3), la banda solo neutraliza el centro. Rango invalido
// (na o top<=bottom) -> [na, na]. Pura -> golden tests MQL5 directos (ADR-002).
f_premiumDiscount(float price, float top, float bottom, float eqLo, float eqHi) =>
    int   zone = na
    float pct  = na
    if not na(top) and not na(bottom) and top > bottom
        pct  := (price - bottom) / (top - bottom)
        zone := pct >= eqLo and pct <= eqHi ? PD_EQUILIBRIUM : pct > 0.5 ? PD_PREMIUM : PD_DISCOUNT
    [zone, pct]

// === DETECCIÓN TF PROPIO ===
// Estado global del chart actual. Arrays con prefijo SMC_ [PINE-PLAN §2].
// Las detecciones que los pueblan llegan en T02+ (swings, BOS/CHoCH, ...).
var array<SMC_Swing> SMC_swings = array.new<SMC_Swing>()
var array<SMC_Event> SMC_events = array.new<SMC_Event>()
var array<SMC_Zone>  SMC_zones  = array.new<SMC_Zone>()
var array<SMC_Pool>  SMC_pools  = array.new<SMC_Pool>()

// --- Swings [T02] ---
// pivothigh/low(len,len) recien confirma len velas tras el pivote -> el guard
// barstate.isconfirmed evita actuar sobre la vela en formacion (anti-repaint
// [§1.1]). El swing pertenece a la vela t = bar_index - len; clasificar ANTES de
// hacer push (f_classifySwing lee el swing previo del mismo tipo ya almacenado).
[swingHigh, swingLow] = f_detectSwings(i_swingLen)
newSwingHigh = barstate.isconfirmed and not na(swingHigh)
newSwingLow  = barstate.isconfirmed and not na(swingLow)
int swingHighKind = na
int swingLowKind  = na
if newSwingHigh
    swingHighKind := f_classifySwing(true, swingHigh, SMC_swings)
    f_pushSwing(SMC_swings, SMC_Swing.new(swingHigh, bar_index - i_swingLen, time[i_swingLen], swingHighKind, false), MAX_SWINGS)
if newSwingLow
    swingLowKind := f_classifySwing(false, swingLow, SMC_swings)
    f_pushSwing(SMC_swings, SMC_Swing.new(swingLow, bar_index - i_swingLen, time[i_swingLen], swingLowKind, false), MAX_SWINGS)

// --- Estructura BOS/CHoCH [T03] ---
// Estado estructural persistente por escala. structSwing = bias mayor (headline);
// structInternal = estructura fina (internalLen), no voltea el bias swing [§1.4].
var SMC_Structure structSwing    = SMC_Structure.new()
var SMC_Structure structInternal = SMC_Structure.new()

// Snapshot consolidado del bias del TF propio [T04]. Se alimenta SOLO del evento de
// escala swing (structSwing) -> el bias mayor; lo que el MTF exporta [Sprint 1.4] y
// el scoring lee [Sprint 2.1]. structInternal queda fuera (no voltea el bias, §1.4).
var SMC_TFState chartState = SMC_TFState.new()

// Dealing range Premium/Discount [T07]: trailing extremes anclados al ultimo swing de
// ESCALA P/D (opcion A, ver docs/decisiones-pd-rango.md). Estado del consumidor (el TYPE
// vive en CORE). Swing P/D dedicado (i_pdSwingLen, default 50 = swing de LuxAlgo), NO el
// swingLen=5 estructural: el dealing range de LuxAlgo se basa en
// getCurrentStructure(swingsLengthInput=50) (ref :782) -> rango DOMINANTE, no local.
var SMC_Trailing trailing = SMC_Trailing.new()
[pdSwingHigh, pdSwingLow] = f_detectSwings(i_pdSwingLen)

// Pivotes internos (los swing ya se calcularon arriba). Mismo guard anti-repaint.
[internalHigh, internalLow] = f_detectSwings(i_internalLen)
newInternalHigh = barstate.isconfirmed and not na(internalHigh)
newInternalLow  = barstate.isconfirmed and not na(internalLow)

// Fijar el swing recien confirmado como nivel estructural vigente (anclado a t).
if newSwingHigh
    f_setStructureHigh(structSwing, swingHigh, bar_index - i_swingLen, time[i_swingLen])
if newSwingLow
    f_setStructureLow(structSwing, swingLow, bar_index - i_swingLen, time[i_swingLen])
if newInternalHigh
    f_setStructureHigh(structInternal, internalHigh, bar_index - i_internalLen, time[i_internalLen])
if newInternalLow
    f_setStructureLow(structInternal, internalLow, bar_index - i_internalLen, time[i_internalLen])

// --- Premium/Discount: dealing range [T07] ---
// Reanclaje a los swings de ESCALA P/D (i_pdSwingLen, default 50 = swing de LuxAlgo; ref
// :782 getCurrentStructure(swingsLengthInput,false)). Solo en swings confirmados (anti-
// repaint); el swing P/D pertenece a la vela t = bar_index - i_pdSwingLen. Luego
// f_updateTrailing expande el rango CADA barra (incl. la viva) como LuxAlgo
// (updateTrailingExtremes :770-771, no gated) -> el precio vivo nunca excede el rango y el
// pct queda en 0..1. Orden reset->expand. El snapshot para el scoring se congela SOLO en
// barstate.isconfirmed (determinista, no repinta historia).
if barstate.isconfirmed and not na(pdSwingHigh)
    f_resetTrailingHigh(trailing, pdSwingHigh, bar_index - i_pdSwingLen, time[i_pdSwingLen])
if barstate.isconfirmed and not na(pdSwingLow)
    f_resetTrailingLow(trailing, pdSwingLow, bar_index - i_pdSwingLen, time[i_pdSwingLen])
f_updateTrailing(trailing, high, low, time)
if barstate.isconfirmed
    chartState.pdHigh := trailing.top
    chartState.pdLow  := trailing.bottom

// Ruptura estructural solo al cierre confirmado (anti-repaint [D-PINE-03]). El
// interno usa guard de nivel-distinto: no duplica la senal cuando su pivote coincide
// con el del swing (cf. LuxAlgo extraCondition).
SMC_Event evStructSwing = na
SMC_Event evStructInt   = na
if barstate.isconfirmed
    evStructSwing := f_detectStructure(structSwing, bar_index, time, true, true)
    bool okIntHigh = structInternal.highLevel != structSwing.highLevel
    bool okIntLow  = structInternal.lowLevel  != structSwing.lowLevel
    evStructInt   := f_detectStructure(structInternal, bar_index, time, okIntHigh, okIntLow)
    if not na(evStructSwing)
        f_pushEvent(SMC_events, evStructSwing, MAX_EVENTS)
    if not na(evStructInt)
        f_pushEvent(SMC_events, evStructInt, MAX_EVENTS)
    // Consolidar el bias del TF tras la posible ruptura swing de esta barra [T04].
    f_updateTFState(chartState, evStructSwing)

// --- Order Blocks [T05] ---
// Buffers ROLLING de barras (high/low/barIdx/time/ATR200) poblados cada barra
// confirmada y acotados a MAX_BARBUF: f_detectOB recorre estos arrays (acceso
// estatico, sin referencia historica dinamica de series) -> runtime-safe (evita
// RE10045) y portable a golden tests MQL5 (ADR-002). En barra confirmada: empuja la
// barra al buffer, actualiza la mitigacion de las zonas vivas y, si hubo ruptura
// SWING, detecta el OB de la pierna (origen = pivote roto, misma ancla que el dibujo
// de estructura). Escala SWING (confluencia #19 OB chart); el OB interno reusa
// f_detectOB con structInternal y queda para su tarea.
var array<float> obBufHigh = array.new<float>()
var array<float> obBufLow  = array.new<float>()
var array<int>   obBufIdx  = array.new<int>()
var array<int>   obBufTime = array.new<int>()
var array<float> obBufVol  = array.new<float>()
float volMeasure = ta.atr(200)
float atr14      = ta.atr(14)
if barstate.isconfirmed
    array.push(obBufHigh, high)
    array.push(obBufLow,  low)
    array.push(obBufIdx,  bar_index)
    array.push(obBufTime, time)
    array.push(obBufVol,  volMeasure)
    if array.size(obBufIdx) > MAX_BARBUF
        array.shift(obBufHigh)
        array.shift(obBufLow)
        array.shift(obBufIdx)
        array.shift(obBufTime)
        array.shift(obBufVol)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            f_updateZoneMitigation(array.get(SMC_zones, i), i_obMitClose)
    if not na(evStructSwing)
        int obOrigin = evStructSwing.dir == DIR_BULL ? structSwing.highBarIdx : structSwing.lowBarIdx
        SMC_Zone obZone = f_detectOB(evStructSwing, obOrigin, obBufHigh, obBufLow, obBufIdx, obBufTime, obBufVol, i_obHighVolFactor, KIND_OB)
        if not na(obZone)
            f_pushZone(SMC_zones, obZone, MAX_ZONES)
    // --- Fair Value Gaps [T06] ---
    // FVG de 3 velas sobre el TF propio (sin request.security: el MTF es T13). Se
    // confirma al cierre de la 3.a vela (este barstate.isconfirmed); offsets fijos
    // [0]/[2] = referencia estatica RE10045-safe. Umbral fixed 0.25*ATR14 (default
    // validado). Se empuja a SMC_zones DESPUES de la mitigacion comun (loop arriba)
    // -> no se mitiga en su barra de creacion; en barras siguientes el loop la gestiona
    // como al OB (misma maquina f_updateZoneMitigation, §2.2).
    SMC_Zone fvgZone = f_detectFVG(high, low, high[2], low[2], bar_index, time, i_fvgThreshold * atr14, KIND_FVG)
    if not na(fvgZone)
        f_pushZone(SMC_zones, fvgZone, MAX_ZONES)

// === MTF ===
// request.security D1/H1 (max 4 en Visual). Pendiente Sprint 1.4 (T13).

// === DIBUJO ===
// f_draw<Concepto>() por concepto, cada uno con su cuota de objetos [PINE-PLAN §5].
// f_drawSwing: etiqueta flotante HH/HL/LH/LL en la vela del pivote. Estructura
// alcista (HH/HL) en verde-azulado, bajista (LH/LL) en rojo. style_label_down
// sobre swing highs (texto colgando bajo el techo), style_label_up bajo lows.
f_drawSwing(int barIdx, float price, int kind) =>
    bool isHigh = kind == KIND_HH or kind == KIND_LH
    [txt, col] = switch kind
        KIND_HH => ["HH", color.teal]
        KIND_HL => ["HL", color.teal]
        KIND_LH => ["LH", color.red]
        KIND_LL => ["LL", color.red]
        => ["?", color.gray]
    label.new(barIdx, price, txt, style = isHigh ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 100), textcolor = col, size = size.small)

// f_drawStructure: linea del nivel roto (origen pivote -> barra de ruptura) +
// etiqueta BOS/CHoCH centrada sobre la linea (punto medio). Direccional: ruptura
// alcista por ENCIMA del nivel (style_label_down), bajista por DEBAJO
// (style_label_up). Alcista teal / bajista rojo; swing solido / interno punteado.
f_drawStructure(int pivotBarIdx, float level, int breakBarIdx, int kind, int dir, bool internal) =>
    col = dir == DIR_BULL ? color.teal : color.red
    txt = kind == KIND_CHOCH ? "CHoCH" : "BOS"
    line.new(pivotBarIdx, level, breakBarIdx, level, color = col, style = internal ? line.style_dashed : line.style_solid, width = internal ? 1 : 2)
    int midIdx = math.round((pivotBarIdx + breakBarIdx) / 2.0)
    label.new(midIdx, level, txt, style = dir == DIR_BULL ? label.style_label_down : label.style_label_up, color = color.new(col, 85), textcolor = col, size = internal ? size.tiny : size.small)

if i_showSwings and newSwingHigh
    f_drawSwing(bar_index - i_swingLen, swingHigh, swingHighKind)
if i_showSwings and newSwingLow
    f_drawSwing(bar_index - i_swingLen, swingLow, swingLowKind)

if i_showStruct and not na(evStructSwing)
    int originIdx = evStructSwing.dir == DIR_BULL ? structSwing.highBarIdx : structSwing.lowBarIdx
    f_drawStructure(originIdx, evStructSwing.price, evStructSwing.barIdx, evStructSwing.kind, evStructSwing.dir, false)
if i_showInternal and not na(evStructInt)
    int originIdx = evStructInt.dir == DIR_BULL ? structInternal.highBarIdx : structInternal.lowBarIdx
    f_drawStructure(originIdx, evStructInt.price, evStructInt.barIdx, evStructInt.kind, evStructInt.dir, true)

// f_drawOB: caja del Order Block coloreada por estado [T05] (solo Visual). Origen =
// vela del OB; se extiende a la derecha hasta la barra actual (la zona vive; el
// origen no repinta). Alcista teal / bajista rojo. Transparencia por estado: activa
// solida, parcial mas tenue, mitigada gris. La invalida no se dibuja (pasa a breaker
// en su tarea). Devuelve el box para gestionarlo (clear/redibujo).
f_drawOB(SMC_Zone z) =>
    col = z.dir == DIR_BULL ? color.teal : color.red
    int transp = z.state == ZS_ACTIVE ? 75 : z.state == ZS_PARTIAL ? 83 : 90
    color bg = z.state == ZS_MITIGATED ? color.new(color.gray, 90) : color.new(col, transp)
    box.new(left = z.barIdx, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = bg, border_color = color.new(col, 50), border_width = 1, xloc = xloc.bar_index)

// En la ultima barra limpia y repinta las cajas vivas (evita acumulacion por tick).
// Cajas <= MAX_ZONES. Las zonas mitigadas se muestran tenues; las invalidadas se
// omiten (su rol pasa a breaker en §Tier2).
var array<box> SMC_obBoxes = array.new<box>()
if i_showOB and barstate.islast
    for b in SMC_obBoxes
        box.delete(b)
    array.clear(SMC_obBoxes)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            if z.kind == KIND_OB and z.state != ZS_INVALID
                array.push(SMC_obBoxes, f_drawOB(z))

// f_drawFVG: caja del Fair Value Gap coloreada por estado [T06] (solo Visual). left =
// vela media (z.barIdx-1, cf. LuxAlgo lastTime=time[1]) para cubrir el desplazamiento
// que crea el gap; se extiende a la derecha hasta la barra actual (la zona vive). FVG
// alcista lima / bajista naranja -> distinto del teal/rojo del OB. Transparencia por
// estado (activa solida, parcial mas tenue, mitigada gris). La invalida no se dibuja.
// La linea CE (50%) se dibuja aparte en el loop (nivel de entrada de referencia #26).
f_drawFVG(SMC_Zone z) =>
    col = z.dir == DIR_BULL ? color.lime : color.orange
    int transp = z.state == ZS_ACTIVE ? 80 : z.state == ZS_PARTIAL ? 86 : 92
    color bg = z.state == ZS_MITIGATED ? color.new(color.gray, 92) : color.new(col, transp)
    box.new(left = z.barIdx - 1, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = bg, border_color = color.new(col, 60), border_width = 1, xloc = xloc.bar_index)

// En la ultima barra limpia y repinta las cajas FVG + lineas CE vivas. Las mitigadas se
// muestran tenues sin CE; las invalidadas se omiten (el gap quedo rellenado por completo).
var array<box>  SMC_fvgBoxes   = array.new<box>()
var array<line> SMC_fvgCELines = array.new<line>()
if i_showFVG and barstate.islast
    for b in SMC_fvgBoxes
        box.delete(b)
    for l in SMC_fvgCELines
        line.delete(l)
    array.clear(SMC_fvgBoxes)
    array.clear(SMC_fvgCELines)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            if z.kind == KIND_FVG and z.state != ZS_INVALID
                array.push(SMC_fvgBoxes, f_drawFVG(z))
                if i_showCE and z.state != ZS_MITIGATED
                    float ce = (z.top + z.bottom) / 2.0
                    color ceCol = z.dir == DIR_BULL ? color.lime : color.orange
                    array.push(SMC_fvgCELines, line.new(z.barIdx - 1, ce, bar_index, ce, color = color.new(ceCol, 20), style = line.style_dotted, width = 1, xloc = xloc.bar_index))

// f_drawPDLine: una linea de nivel del dealing range [T07] (solo Visual). Como LuxAlgo
// (drawTrailingExtremes :715-732): cada linea se ancla en SU PROPIO extremo via tiempo —
// premium en trailing.topTime (la barra del strong high), discount en trailing.bottomTime
// (la del strong low), no en un ancla compartida (eso hacia "volar" la linea). Dibuja con
// xloc.bar_time hasta la barra actual. Menos ruido que cajas (pref. usuario, Sesion-021).
f_drawPDLine(int leftTime, float level, color col, string lineStyle) =>
    line.new(leftTime, level, time, level, xloc = xloc.bar_time, color = col, style = lineStyle, width = 1)

// En la ultima barra limpia y repinta las 3 lineas P/D + las etiquetas. Premium = linea
// solida roja en trailing.top desde la barra del high (trailing.topTime, cf. LuxAlgo
// lastTopTime :725); Discount = linea solida verde en trailing.bottom desde la barra del
// low (trailing.bottomTime, cf. :730); Equilibrium = punteada gris en el 50% desde el
// extremo mas antiguo. La banda [45%,55%] (i_pdEqBand) ya no se dibuja: solo alimenta la
// clasificacion del panel (#31). Sin cajas -> sin ruido.
var array<line>  SMC_pdLines  = array.new<line>()
var array<label> SMC_pdLabels = array.new<label>()
if i_showPD and barstate.islast and not na(trailing.top) and not na(trailing.bottom) and trailing.top > trailing.bottom
    for l in SMC_pdLines
        line.delete(l)
    for lb in SMC_pdLabels
        label.delete(lb)
    array.clear(SMC_pdLines)
    array.clear(SMC_pdLabels)
    float eqLvl    = (trailing.top + trailing.bottom) / 2.0
    int   topLeft  = nz(trailing.topTime, time)
    int   botLeft  = nz(trailing.bottomTime, time)
    int   eqLeft   = topLeft < botLeft ? topLeft : botLeft
    array.push(SMC_pdLines, f_drawPDLine(topLeft, trailing.top,    color.new(color.red, 0),   line.style_solid))
    array.push(SMC_pdLines, f_drawPDLine(eqLeft,  eqLvl,           color.new(color.gray, 20), line.style_dotted))
    array.push(SMC_pdLines, f_drawPDLine(botLeft, trailing.bottom, color.new(color.green, 0), line.style_solid))
    array.push(SMC_pdLabels, label.new(bar_index, trailing.top,    "Premium "  + str.tostring(trailing.top, format.mintick),    style = label.style_label_down, color = color.new(color.red, 80),   textcolor = color.red,   size = size.small))
    array.push(SMC_pdLabels, label.new(bar_index, eqLvl,           "EQ "       + str.tostring(eqLvl, format.mintick),           style = label.style_label_left, color = color.new(color.gray, 80),  textcolor = color.gray,  size = size.small))
    array.push(SMC_pdLabels, label.new(bar_index, trailing.bottom, "Discount " + str.tostring(trailing.bottom, format.mintick), style = label.style_label_up,   color = color.new(color.green, 80), textcolor = color.green, size = size.small))

// === PANEL ===
// Esqueleto: confirma que el core carga y reporta el tamaño de los arrays
// globales. El panel completo (PINE-PLAN §5) llega en T14.
if i_showPanel and barstate.islast
    var table panel = table.new(position.top_right, 2, 7, border_width = 1)
    string biasTxt = chartState.bias == DIR_BULL ? "Alcista" : chartState.bias == DIR_BEAR ? "Bajista" : "—"
    color  biasCol = chartState.bias == DIR_BULL ? color.teal : chartState.bias == DIR_BEAR ? color.red : color.gray
    [pdZone, pdPct] = f_premiumDiscount(close, trailing.top, trailing.bottom, 0.5 - i_pdEqBand / 100.0, 0.5 + i_pdEqBand / 100.0)
    string pdTxt = na(pdZone) ? "—" : pdZone == PD_PREMIUM ? "Premium" : pdZone == PD_DISCOUNT ? "Discount" : "Equilibrium"
    color  pdCol = pdZone == PD_PREMIUM ? color.red : pdZone == PD_DISCOUNT ? color.green : color.gray
    string pdCell = pdTxt + (na(pdPct) ? "" : " " + str.tostring(math.round(pdPct * 100)) + "%")
    table.cell(panel, 0, 0, "SMC Engine — Visual", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(panel, 1, 0, "P/D T07",             text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(panel, 0, 1, "Bias",    text_color = color.gray)
    table.cell(panel, 1, 1, biasTxt, text_color = biasCol)
    table.cell(panel, 0, 2, "Premium/Discount", text_color = color.gray)
    table.cell(panel, 1, 2, pdCell, text_color = pdCol)
    table.cell(panel, 0, 3, "Swings",  text_color = color.gray)
    table.cell(panel, 1, 3, str.tostring(array.size(SMC_swings)), text_color = color.gray)
    table.cell(panel, 0, 4, "Eventos", text_color = color.gray)
    table.cell(panel, 1, 4, str.tostring(array.size(SMC_events)), text_color = color.gray)
    table.cell(panel, 0, 5, "Zonas",   text_color = color.gray)
    table.cell(panel, 1, 5, str.tostring(array.size(SMC_zones)),  text_color = color.gray)
    table.cell(panel, 0, 6, "Pools",   text_color = color.gray)
    table.cell(panel, 1, 6, str.tostring(array.size(SMC_pools)),  text_color = color.gray)

// === ALERTAS ===
// alertcondition(): 16 base LuxAlgo + nuevas. Pendiente Sprint 1.4 (T15).
