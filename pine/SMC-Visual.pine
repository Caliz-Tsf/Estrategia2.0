// Mapa MTF [T13a]: hereda los escalares de HTF hacia TF menores (cascada D1->{H1,M5}, H1->{M5}).
i_showD1         = input.bool(true, "Heredar D1 (bias + P/D)", group = GRP_MTF)
i_showH1         = input.bool(true, "Heredar H1 (bias + P/D)", group = GRP_MTF)
i_mtfCapOB       = input.int(2, "Traspaso OB por HTF (0-10, 0=off)",    minval = 0, maxval = 10, group = GRP_MTF)
