indicator("SMC Engine — Visual", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// === INPUTS ===
// Grupos canonicos (reglas-dev §1.3). Esqueleto: solo toggles base; cada
// concepto añade su grupo en su tarea (T02+).
GRP_STRUCT = "Estructura"
GRP_OB     = "Order Blocks"
GRP_FVG    = "Fair Value Gaps"
GRP_PD     = "Premium/Discount"
GRP_GRAD   = "Gradient Levels (§5B)"
GRP_EQHL   = "Equal Highs/Lows"
GRP_LIQ    = "Liquidez"
GRP_KZ     = "Kill Zones / Sesiones"
GRP_MTF    = "Mapa MTF"
GRP_CTX    = "Contexto / ICT"
GRP_OTE    = "OTE / Golden Pocket"
GRP_PANEL  = "Panel"
i_showPanel   = input.bool(true, "Mostrar panel de estado", group = GRP_PANEL)
i_panelCompact = input.bool(false, "Panel minimizado (solo Bias por TF)", group = GRP_PANEL)
// Estructura DOMINANTE (swing grande = LuxAlgo getCurrentStructure(50), ref :782).
// NUESTRO swingLen=5 ~= interno de LuxAlgo; esta capa es la que faltaba [T07B].
i_majorLen    = input.int(50, "Swing dominante (estructura grande)", minval = 10, group = GRP_STRUCT)
i_swingLen    = input.int(5, "Swing length",    minval = 2, group = GRP_STRUCT)
i_internalLen = input.int(3, "Internal length", minval = 1, group = GRP_STRUCT)
i_showMajor   = input.bool(true,  "Mostrar estructura dominante (50)", group = GRP_STRUCT)
i_showSwings  = input.bool(true, "Mostrar swings (HH/HL/LH/LL)", group = GRP_STRUCT)
i_swingStructLen = input.int(20, "Swings: sensibilidad estructura (leg)", minval = 10, group = GRP_STRUCT)
i_swingMaxKeep   = input.int(350, "Swings: máx. retenidos (historial hacia atrás)", minval = 50, maxval = 600, group = GRP_STRUCT)
i_swingDomAtr    = input.float(8.0, "Swings: amplitud dominante (×ATR) — pivotes >= este umbral se pintan fuertes", minval = 0.0, step = 0.1, group = GRP_STRUCT)
i_showStruct  = input.bool(true,  "Mostrar BOS/CHoCH (swing)",   group = GRP_STRUCT)
i_showInternal = input.bool(false, "Mostrar BOS/CHoCH interno",  group = GRP_STRUCT)
i_showMSS      = input.bool(true,  "Mostrar MSS (CHoCH + displacement)", group = GRP_STRUCT)
i_showFlip     = input.bool(true,  "Mostrar Flips (cambio de rol, §2.8)", group = GRP_STRUCT)
i_maxShowFlip  = input.int(20,     "Max marcadores de flip (recientes)", minval = 1, group = GRP_STRUCT)
i_showCISD     = input.bool(true,  "Mostrar CISD (cambio estado entrega, §5.6)", group = GRP_STRUCT)
i_cisdMinRun   = input.int(2,      "CISD: velas mínimas del run de delivery", minval = 1, group = GRP_STRUCT)
i_maxShowCISD  = input.int(20,     "Max marcadores de CISD (recientes)", minval = 1, group = GRP_STRUCT)
i_mssDispFactor= input.float(1.5,  "MSS: rango vela ruptura (x ATR14)", minval = 0.5, step = 0.1, group = GRP_STRUCT)
i_mssBodyPct   = input.float(0.70, "MSS: cuerpo minimo (frac. rango)", minval = 0.1, maxval = 1.0, step = 0.05, group = GRP_STRUCT)
// Displacement [§4.1 · T16]: vela impulsiva (calificador de fuerza). Knobs propios
// (independientes del MSS) para calibracion Fase 3; defaults canonicos 1.5 / 0.70.
i_showDisp        = input.bool(true,  "Mostrar Displacement",                          group = GRP_CTX)
i_dispFactor      = input.float(1.5,  "Displacement: rango (x ATR14)", minval = 0.5, step = 0.1, group = GRP_CTX)
i_dispBodyPct     = input.float(0.70, "Displacement: cuerpo minimo (frac. rango)", minval = 0.1, maxval = 1.0, step = 0.05, group = GRP_CTX)
i_dispContraction = input.bool(true,  "Displacement: exigir contraccion previa (>=3 velas)", group = GRP_CTX)
i_maxShowDisp     = input.int(20,     "Max marcadores de displacement (recientes)", minval = 1, group = GRP_CTX)
i_showRej         = input.bool(true,  "Mostrar Rejections (rechazo en nivel)", group = GRP_CTX)
i_rejWickFactor   = input.float(2.0,  "Rejection: mecha minima (x cuerpo) §2.7", minval = 0.5, step = 0.1, group = GRP_CTX)
i_rejTouchTol     = input.float(0.1,  "Rejection: tolerancia toque nivel (x ATR14)", minval = 0.0, maxval = 0.5, step = 0.05, group = GRP_CTX)
i_maxShowRej      = input.int(20,     "Max marcadores de rejection (recientes)", minval = 1, group = GRP_CTX)
i_showEMA         = input.bool(true,  "Mostrar EMAs (20/50/200)", group = GRP_CTX)
i_emaFast         = input.int(20,     "EMA rapida", minval = 1, group = GRP_CTX)
i_emaMid          = input.int(50,     "EMA media",  minval = 1, group = GRP_CTX)
i_emaSlow         = input.int(200,    "EMA lenta",  minval = 1, group = GRP_CTX)
i_emaCrossBars    = input.int(20,     "EMA: antiguedad max cruce (velas) §4.3 #40", minval = 1, group = GRP_CTX)
i_showEmaBounce   = input.bool(true,  "Marcar rebotes en EMA (#41)", group = GRP_CTX)
i_showEmaCross    = input.bool(true,  "Marcar cruces de EMA (par, §4.3)", group = GRP_CTX)
i_showEmaStack    = input.bool(true,  "Marcar Stack Flip 20&50 vs 200 (§4.3)", group = GRP_CTX)
i_maxShowEmaX     = input.int(20,     "Max marcadores de cruce EMA (recientes)", minval = 1, group = GRP_CTX)
i_showLegs        = input.bool(true,  "Marcar tramos Impulsivo/Correctivo (§4.4)", group = GRP_CTX)
i_maxShowLegs     = input.int(20,     "Max marcadores de tramo (recientes)", minval = 1, group = GRP_CTX)
i_showInsideDay   = input.bool(true,  "Marcar Inside Day (compresión D1, §5.12)", group = GRP_CTX)
i_maxShowID       = input.int(10,     "Max marcadores de Inside Day (recientes)", minval = 1, group = GRP_CTX)
i_showOB         = input.bool(true,  "Mostrar Order Blocks",              group = GRP_OB)
i_obHighVolFactor = input.float(2.0, "Filtro volatilidad (x ATR200)", minval = 0.5, step = 0.1, group = GRP_OB)
i_obMitClose     = input.bool(false, "Mitigacion por cierre (vs mecha)",  group = GRP_OB)
i_obAgeBars      = input.int(2000, "Atenuado por antigüedad: barras hasta el máximo [S139]", minval = 20, group = GRP_OB)
i_obAgeDim       = input.int(40,  "Atenuado por antigüedad: transparencia extra máx (0=off)", minval = 0, maxval = 60, group = GRP_OB)
i_showBreaker    = input.bool(true,  "Mostrar Breakers (OB invalidado, §2.6)", group = GRP_OB)
i_showMB         = input.bool(true,  "Mostrar Mitigation Blocks (§2.8 #24)", group = GRP_OB)
i_propOverlap    = input.float(0.5,  "Propulsion: solape mínimo en OB previo (§5.8)", minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_OB)
i_showVacuum     = input.bool(true,  "Mostrar Vacuum Blocks (§5.7)", group = GRP_OB)
i_vacuumFactor   = input.float(0.5,  "Vacuum: gap mínimo de apertura (x ATR14)", minval = 0.1, step = 0.1, group = GRP_OB)
i_showOTE      = input.bool(true,  "Mostrar OTE / Golden Pocket",       group = GRP_OTE)
i_oteR1        = input.float(0.50,  "Fib inicio GP (50%)",   minval = 0.0, maxval = 1.0, step = 0.001, group = GRP_OTE)
i_oteR2        = input.float(0.618, "Fib GP/OTE (61.8%)",    minval = 0.0, maxval = 1.0, step = 0.001, group = GRP_OTE)
i_oteR3        = input.float(0.79,  "Fib fin OTE (79%)",     minval = 0.0, maxval = 1.0, step = 0.001, group = GRP_OTE)
i_showFVG      = input.bool(true,  "Mostrar Fair Value Gaps",          group = GRP_FVG)
i_fvgThreshold = input.float(0.25, "Umbral tamaño (x ATR14)", minval = 0.0, step = 0.05, group = GRP_FVG)
i_showCE       = input.bool(true,  "Mostrar nivel CE (50%)",           group = GRP_FVG)
i_showIFVG     = input.bool(true,  "Mostrar IFVG (FVG invertido, §5.2)", group = GRP_FVG)
i_showBPR      = input.bool(true,  "Mostrar BPR (solape FVG opuestos, §5.3)", group = GRP_FVG)
i_bprWindow    = input.int(20,     "BPR: ventana máx entre FVG opuestos (velas)", minval = 1, group = GRP_FVG)
i_bprMinOverlap= input.float(0.05, "BPR: solape mínimo (x ATR14)", minval = 0.0, maxval = 0.5, step = 0.01, group = GRP_FVG)
i_showIR       = input.bool(true,  "Mostrar Immediate Rebalance (§5.4)", group = GRP_FVG)
i_irFactor     = input.float(1.0,  "IR: rango vela impulso (x ATR14)", minval = 0.3, step = 0.1, group = GRP_FVG)
i_irBodyPct    = input.float(0.60, "IR: cuerpo mínimo (frac. rango)", minval = 0.1, maxval = 1.0, step = 0.05, group = GRP_FVG)
i_maxShowIR    = input.int(20,     "Max marcadores de IR (recientes)", minval = 1, group = GRP_FVG)
i_showIPR      = input.bool(true,  "Mostrar IPR (rango desbalanceado, §5.9)", group = GRP_FVG)
i_iprWindow    = input.int(10,     "IPR: ventana (velas)", minval = 2, group = GRP_FVG)
i_iprMinGaps   = input.int(3,      "IPR: FVG mín. mismo lado", minval = 2, group = GRP_FVG)
i_showPD       = input.bool(true,  "Mostrar Premium/Discount",         group = GRP_PD)
// [ADR-021] `i_pdSwingLen` ELIMINADO. Era la escala del pivote de reanclaje de la Opcion A; con el 2.º
// extremo estructural (§2.3.2) el rango se reancla por RUPTURA DE ESTRUCTURA, no por pivote, y la escala
// de esa estructura es la DOMINANTE -> la aporta `i_majorLen` (=50, el swing de LuxAlgo, ref :782).
// Un solo input para un solo concepto; se acabo el par redundante (y el riesgo de ponerlos distintos:
// el chart-TF usaba i_majorLen y las MTF i_pdSwingLen). El 1000 de S130 acertaba actuando como VENTANA
// de facto, sin saberlo (ver decisiones-pd-rango.md nota S133(b)); ya no hace falta.
i_pdEqBand     = input.float(5.0,  "Banda equilibrium (± %)", minval = 0.0, maxval = 25.0, step = 0.5, group = GRP_PD)
i_showGradient = input.bool(true,  "Mostrar Gradient Levels (grid del rango §5.16)", group = GRP_GRAD)
i_gradEighths  = input.bool(true,  "Incluir eighths (0.125/0.375/0.625/0.875)", group = GRP_GRAD)
i_gradTol      = input.float(0.12, "Tolerancia toca-nivel (x ATR14) §5.18 (T42/T43)", minval = 0.0, step = 0.01, group = GRP_GRAD)
i_gradStaleBars    = input.int(150, "P2 suspension: dealing range 'stale' (velas) §5.16", minval = 10, group = GRP_GRAD)
i_gradBodyLookback = input.int(5,   "Desempate cuerpos-vs-nivel (velas) §5.16", minval = 1, maxval = 50, group = GRP_GRAD)
i_gradPersistDays  = input.int(5,   "Ghost/persistencia grids (cuota) §5.16", minval = 0, maxval = 20, group = GRP_GRAD)
i_showEQHL     = input.bool(true,  "Mostrar Equal Highs/Lows",         group = GRP_EQHL)
i_eqThreshold  = input.float(0.1,  "Umbral igualdad (x ATR14)", minval = 0.0, maxval = 0.5, step = 0.05, group = GRP_EQHL)
i_eqlLength    = input.int(3,      "Barras confirmacion EQH/EQL", minval = 1, group = GRP_EQHL)
i_showPools    = input.bool(true,  "Mostrar pools de liquidez (BSL/SSL)", group = GRP_LIQ)
i_poolTol      = input.float(0.1,  "Tolerancia cluster (x ATR14)", minval = 0.0, maxval = 0.5, step = 0.05, group = GRP_LIQ)
i_minTouches   = input.int(2,      "Toques minimos para pool", minval = 2, group = GRP_LIQ)
i_showSwept    = input.bool(true,  "Mostrar pools barridos (historial)", group = GRP_LIQ)
i_showSweeps   = input.bool(true,  "Mostrar marcadores de sweep (trampa/Spring/Raid)", group = GRP_LIQ)
i_maxShowSweeps= input.int(20,     "Max marcadores de sweep (recientes)", minval = 1, group = GRP_LIQ)
i_raidTouches  = input.int(3,      "Raid: toques minimos del pool (§3.7 #16)", minval = 2, group = GRP_LIQ)
i_showFalseBreak = input.bool(true, "Mostrar False Breakouts (§3.7 #14)", group = GRP_LIQ)
i_fbBars       = input.int(2,      "False Breakout: max velas para revertir", minval = 1, group = GRP_LIQ)
i_maxShowFB    = input.int(20,     "Max marcadores de false breakout (recientes)", minval = 1, group = GRP_LIQ)
i_showIDM      = input.bool(true,  "Mostrar IDM (inducement interno)", group = GRP_LIQ)
i_maxShowIDM   = input.int(20,     "Max marcadores de IDM (recientes)", minval = 1, group = GRP_LIQ)
i_showJudas    = input.bool(true,  "Mostrar Judas (trampa de sesion)", group = GRP_LIQ)
i_judasBars    = input.int(6,      "Judas: max velas sweep->displacement (§3.5)", minval = 1, group = GRP_LIQ)
i_maxShowJudas = input.int(20,     "Max marcadores de Judas (recientes)", minval = 1, group = GRP_LIQ)
i_sessionProfile = input.string("FX-London-NY", "Perfil de sesión", options = ["FX-London-NY", "FX-Asia", "None"], group = GRP_KZ)
i_showKZ         = input.bool(true, "Sombrear Kill Zone activa", group = GRP_KZ)
i_showOpenGaps   = input.bool(true, "Mostrar gaps de apertura NWOG/NDOG/NYMO (§5.10)", group = GRP_KZ)
i_gapMin         = input.float(0.5, "Gap apertura medible / Breakaway (x ATR14)", minval = 0.0, step = 0.1, group = GRP_KZ)
i_maxShowBag     = input.int(10,    "Max marcadores de Breakaway Gap (recientes)", minval = 1, group = GRP_KZ)
i_showMacros     = input.bool(false, "Sombrear macros intradía ICT (§5.14)", group = GRP_KZ)
