type SMC_Zone
    float  top
    float  bottom
    int    dir
    int    barIdx
    int    barTime
    int    state        = 0
    float  mitigatedPct = 0.0
    string tf           = ""
    int    kind         = 0
    bool   trueFvg      = false   // [T26 §5.1] FVG de alta calidad: su vela media es displacement
    bool   propulsion   = false   // [T34 §5.8] OB de continuacion: anidado en un OB vivo mismo-sentido
    bool   gradedFvg    = false   // [T43 §5.18] FVG que toca un gradient level del grid (§5.16)
    float  strength     = 0.0     // [Eje2 ADR-014] calidad 0-1 (f_zoneStrength) -> jerarquia visual + scoring F3
type SMC_Event
    float  price
    int    dir
    int    barIdx
    int    barTime
    string tf   = ""
    int    kind = 0
    float  strength = 0.0   // [Eje2 ADR-014] calidad 0-1 (f_eventStrength) -> jerarquia visual + scoring F3
type SMC_Swing
    float  price
    int    barIdx
    int    barTime
    int    kind  = 0
    bool   swept = false
    float  strength = 0.0   // [Eje2 ADR-014] calidad 0-1 (escala+frescura+rol) -> jerarquia visual
type SMC_Pool
    float  level
    int    dir
    int    touches      = 1
    int    barTime
    bool   swept        = false
    string tf           = ""
    int    barIdx       = na
    int    sweptBarTime = na
    int    sweptBarIdx  = na
    float  strength     = 0.0     // [Eje2 ADR-014] calidad 0-1 (touches+frescura+cercania) -> jerarquia visual
type SMC_GradientGrid
    float  top
    float  bottom
    int    srcKind       = 0
    int    barTimeAnchor = na
    int    barIdxAnchor  = na
    array<float> levels
    array<bool>  isQuadrant
    int    ageDays       = 0
type SMC_TFState
    int    bias           = 0
    float  lastBOSPrice   = na
    int    lastBOSDir     = 0
    int    lastBOSTime    = 0
    float  lastCHoCHPrice = na
    int    lastCHoCHDir   = 0
    int    lastCHoCHTime  = 0
    float  lastMSSPrice   = na
    int    lastMSSDir     = 0
    int    lastMSSTime    = 0
    float  pdHigh         = na
    float  pdLow          = na
    float  pdMid          = na
    float  ema20          = na
    float  ema50          = na
    float  ema200         = na
    float  atr14          = na
type SMC_Flip
    float  level
    int    breakDir       // +1 roto al alza (pendiente soporte) / -1 roto a la baja (pendiente resistencia)
    int    state    = 0    // LF_PENDING / LF_FLIPPED / LF_INVALID
    int    barIdx
    int    barTime
type SMC_FBreak
    float  level
    int    breakDir       // +1 close rompio ARRIBA del nivel / -1 close rompio ABAJO
    int    barIdx
// --- Motor de fuerza (strength 0-1) [Eje2 · ADR-014 · HANDOFF §5.2/5.3] ---
// Calidad intrinseca 0-1 por marca (propiedad de DETECCION: la leen los DOS consumidores
// -> jerarquia visual F1 + scoring F3). PURAS, al cierre, reusan atr14 (nunca recalcular
// intra-vela, §5.5). Pesos por primitivo = candidatos CONGELADOS hasta Fase 3 (ADR-002);
// la FORMA (suma ponderada + quantizacion 0/1/2) se fija aqui, los NUMEROS entran por
// IS/OOS. Cada tipo aporta solo los primitivos que su UDT porta (zona: rango/state/dist/
// alineacion + bonus refinamiento; evento: rango/cuerpo/sweep/alineacion; §5.2). No se
// renormaliza: strength es senal RELATIVA y los umbrales 0.33/0.66 tambien son candidatos.
f_zoneStrength(SMC_Zone z, float curPrice, float atr14, int biasDir) =>
    float s = 0.0
    if atr14 > 0
        s += 0.30 * math.min((z.top - z.bottom) / atr14 / 3.0, 1.0)                                       // rango x ATR
        float fresh = z.state == ZS_ACTIVE ? 1.0 : z.state == ZS_PARTIAL ? 0.5 : 0.0
        s += 0.20 * fresh                                                                                 // frescura / state
        float distAtr = (curPrice > z.top ? curPrice - z.top : curPrice < z.bottom ? z.bottom - curPrice : 0.0) / atr14
        s += 0.10 * (1.0 - math.min(distAtr / 2.0, 1.0))                                                  // cercania al nivel
        s += 0.10 * (biasDir == 0 ? 0.5 : z.dir == biasDir ? 1.0 : 0.0)                                   // alineacion con bias
        if z.trueFvg or z.propulsion or z.gradedFvg
            s += 0.10                                                                                     // refinamiento [FIX P-05]
    math.min(s, 1.0)

f_eventStrength(SMC_Event e, float rangeAtr, float bodyPct, bool hadSweep, int biasDir) =>
    float s = 0.0
    s += 0.40 * math.min(rangeAtr / 3.0, 1.0)                                                            // rango x ATR / displacement
    s += 0.20 * math.max(math.min((bodyPct - 0.5) / 0.5, 1.0), 0.0)                                      // cuerpo %
    s += 0.20 * (hadSweep ? 1.0 : 0.0)                                                                   // sweep previo
    s += 0.20 * (biasDir == 0 or e.dir == 0 ? 0.5 : e.dir == biasDir ? 1.0 : 0.0)                        // alineacion
    math.min(s, 1.0)

f_swingStrength(SMC_Swing sw, int biasDir) =>
    float role  = (sw.kind == KIND_HH or sw.kind == KIND_LL) ? 1.0 : 0.6                                 // extremo estructural vs pullback
    float fresh = sw.swept ? 0.0 : 1.0                                                                   // no-roto
    int   swDir = (sw.kind == KIND_HH or sw.kind == KIND_HL) ? DIR_BULL : DIR_BEAR
    float align = biasDir == 0 ? 0.5 : swDir == biasDir ? 1.0 : 0.0
    math.min(0.5 * role + 0.3 * fresh + 0.2 * align, 1.0)

f_poolStrength(SMC_Pool p, float curPrice, float atr14) =>
    float s = 0.5 * math.min(p.touches / 3.0, 1.0) + 0.3 * (p.swept ? 0.0 : 1.0)                         // toques + no-barrido
    if atr14 > 0
        s += 0.2 * (1.0 - math.min(math.abs(curPrice - p.level) / atr14 / 2.0, 1.0))                     // cercania
    math.min(s, 1.0)

f_strengthLevel(float s) =>
    s >= 0.66 ? 2 : s >= 0.33 ? 1 : 0                                                                    // 2=alta / 1=media / 0=baja (§5.3)

f_pushZone(array<SMC_Zone> a, SMC_Zone z, int maxN, float curPrice, float atr14, int biasDir) =>
    z.strength := f_zoneStrength(z, curPrice, atr14, biasDir)
    array.push(a, z)
    if array.size(a) > maxN
        array.shift(a)
    array.size(a)
f_pushEvent(array<SMC_Event> a, SMC_Event e, int maxN, float rangeAtr, float bodyPct, bool hadSweep, int biasDir) =>
    e.strength := f_eventStrength(e, rangeAtr, bodyPct, hadSweep, biasDir)
    array.push(a, e)
    if array.size(a) > maxN
        array.shift(a)
    array.size(a)
f_pushSwing(array<SMC_Swing> a, SMC_Swing s, int maxN, int biasDir) =>
    s.strength := f_swingStrength(s, biasDir)
    array.push(a, s)
    if array.size(a) > maxN
        array.shift(a)
    array.size(a)
f_pushPool(array<SMC_Pool> a, SMC_Pool p, int maxN, float curPrice, float atr14) =>
    p.strength := f_poolStrength(p, curPrice, atr14)
    array.push(a, p)
    if array.size(a) > maxN
        array.shift(a)
    array.size(a)

// --- Swings + clasificacion HH/HL/LH/LL [reglas-smc-ict §1.1/§1.2] · T02 ---
// f_detectSwings: pivote simetrico estricto. high[len] > high de las len velas a
// cada lado (low simetrico). Equivale a ta.pivothigh/low(len, len). Confirmado al
// cierre de la vela t+len -> latencia len velas, cero repaint [§1.1]. Devuelve
// [precioHigh, precioLow] del pivote centrado len velas atras; na si no hay.
f_detectSwings(int len) =>
    [ta.pivothigh(len, len), ta.pivotlow(len, len)]

// f_classifySwing: etiqueta el swing recien confirmado contra el swing previo del
// MISMO tipo (high vs high, low vs low) [§1.2]. isHigh = true si es swing high.
// Recorre los swings almacenados de atras hacia adelante hasta el ultimo del mismo
// tipo. Igualdad exacta de precio: no reclasifica -> hereda el kind previo
// (candidato EQH/EQL). Primer swing del tipo (sin referencia): seed HH/LL.
// INVARIANTE [T02 · obs. validador 97/100]: la clasificacion filtra por tipo
// (sHigh == isHigh), asi que un swing high y un swing low confirmados en la MISMA
// vela t (caso spike, casi imposible con swingLen=5 en H1) se etiquetan de forma
// independiente y NO interfieren. No se asume alternancia high/low aguas abajo:
// BOS/CHoCH/MSS/EQH/EQL leen por tipo. Anotado para revision Fable pre-Fase 4
// (docs/notas-revision-fable.md) por paridad MQL5 (golden tests, ADR-002).
f_classifySwing(bool isHigh, float price, array<SMC_Swing> swings) =>
    int   prevKind  = na
    float prevPrice = na
    if array.size(swings) > 0
        for i = array.size(swings) - 1 to 0
            SMC_Swing s = array.get(swings, i)
            bool sHigh = s.kind == KIND_HH or s.kind == KIND_LH
            if sHigh == isHigh
                prevKind  := s.kind
                prevPrice := s.price
                break
    int kind = na
    if isHigh
        kind := na(prevPrice) ? KIND_HH : price > prevPrice ? KIND_HH : price < prevPrice ? KIND_LH : prevKind
    else
        kind := na(prevPrice) ? KIND_LL : price > prevPrice ? KIND_HL : price < prevPrice ? KIND_LL : prevKind
    kind

// --- Estructura de mercado: BOS / CHoCH [reglas-smc-ict §1.3/§1.4] · T03 ---
// Modelo de bias estructural (reglas, seccion "Modelo de bias estructural"): por
// escala se mantiene el ultimo swing high y el ultimo swing low confirmados
// (highLevel/lowLevel) con un flag 'crossed' que evita re-disparar sobre el mismo
// nivel, y un 'bias' (+1/-1) fijado por la ultima ruptura. La distincion BOS vs
// CHoCH la da el bias vigente al romper [reglas §1.3/§1.4]:
//   - close rompe el nivel que EXTIENDE la tendencia -> BOS  (continuacion).
//   - close rompe el nivel que PROTEGE  la tendencia -> CHoCH (cambio de caracter).
// Ruptura por CIERRE estricto (close > highLevel / close < lowLevel), NO por mecha
// [§1.3]; el flag 'crossed' replica el 'topBroken/btmBroken' del oraculo de paridad
// scripts/ver05/detect.py (ADR-002) y el 'pivot.crossed' de LuxAlgo displayStructure
// (ref :551-612, v5->v6). El guard barstate.isconfirmed (en DETECCION) hace que el
// cierre que rompe sea definitivo -> anti-repaint [D-PINE-03]. Escala swing
// (swingLen) y escala interna (internalLen) se trackean en SMC_Structure separados;
// el bias mayor es el de la escala swing: una ruptura INTERNA no voltea el bias swing
// [§1.4]. okHigh/okLow permiten el guard de nivel-distinto del interno (no duplicar
// la senal swing cuando el pivote interno coincide, cf. LuxAlgo extraCondition
// internalHigh.currentLevel != swingHigh.currentLevel).
type SMC_Structure
    float highLevel   = na
    int   highBarIdx  = na
    int   highTime    = na
    bool  highCrossed = false
    float lowLevel    = na
    int   lowBarIdx   = na
    int   lowTime     = na
    bool  lowCrossed  = false
    int   bias        = 0

// f_setStructureHigh/Low: fija un swing recien confirmado como nivel estructural
// vigente y resetea 'crossed' (nivel fresco, aun no roto). Por construccion del
// pivote, el close de la barra de confirmacion nunca rompe el nivel recien fijado.
f_setStructureHigh(SMC_Structure st, float price, int barIdx, int barTime) =>
    st.highLevel   := price
    st.highBarIdx  := barIdx
    st.highTime    := barTime
    st.highCrossed := false

f_setStructureLow(SMC_Structure st, float price, int barIdx, int barTime) =>
    st.lowLevel   := price
    st.lowBarIdx  := barIdx
    st.lowTime    := barTime
    st.lowCrossed := false

// f_detectStructure: evalua ruptura por cierre del nivel estructural vigente y, si
// hay, muta el estado (crossed + bias) y devuelve el SMC_Event (na si no hay).
// Prioriza el lado alcista (else-if): un mismo close no puede superar el highLevel y
// perforar el lowLevel salvo niveles invertidos, caso que no ocurre con estructura
// sana; el oraculo ver05 usa dos if separados y produce la misma lista en la ventana
// validada. price = nivel roto; barIdx/barTime = barra de ruptura; kind = BOS|CHoCH.
f_detectStructure(SMC_Structure st, int breakBarIdx, int breakTime, bool okHigh, bool okLow) =>
    SMC_Event ev = na
    if okHigh and not na(st.highLevel) and not st.highCrossed and close > st.highLevel
        int tag = st.bias == DIR_BEAR ? KIND_CHOCH : KIND_BOS
        st.highCrossed := true
        st.bias        := DIR_BULL
        ev := SMC_Event.new(st.highLevel, DIR_BULL, breakBarIdx, breakTime, "", tag)
    else if okLow and not na(st.lowLevel) and not st.lowCrossed and close < st.lowLevel
        int tag = st.bias == DIR_BULL ? KIND_CHOCH : KIND_BOS
        st.lowCrossed := true
        st.bias        := DIR_BEAR
        ev := SMC_Event.new(st.lowLevel, DIR_BEAR, breakBarIdx, breakTime, "", tag)
    ev

// f_updateTFState: consolida la ultima ruptura estructural de escala SWING en el
// snapshot SMC_TFState (bias headline + ultimo BOS y ultimo CHoCH). Es el formato
// PLANO que cruzara request.security al MTF [Sprint 1.4] y alimentara el scoring
// [Sprint 2.1] (los UDT no viajan por security; ver PINE-PLAN §4). Solo entra el
// evento de escala SWING -> una ruptura INTERNA no toca el bias mayor [§1.4]. El
// bias = ev.dir (ya sincronizado con structSwing.bias tras f_detectStructure). ev =
// evento swing (na si no hubo ruptura en la barra). Devuelve el state mutado.
f_updateTFState(SMC_TFState state, SMC_Event ev) =>
    if not na(ev)
        state.bias := ev.dir
        if ev.kind == KIND_BOS
            state.lastBOSPrice := ev.price
            state.lastBOSDir   := ev.dir
            state.lastBOSTime  := ev.barTime
        else if ev.kind == KIND_CHOCH
            state.lastCHoCHPrice := ev.price
            state.lastCHoCHDir   := ev.dir
            state.lastCHoCHTime  := ev.barTime
    state

// --- Displacement [reglas-smc-ict §4.1] · T16 ---
// f_detectDisplacement: la vela impulsiva institucional (expansion brusca tras calma). Es el
// calificador de FUERZA que crea FVGs/OBs y valida MSS (§1.5) y Judas (§3.5). Una vela es
// displacement si: rango >= factor*ATR14 (default 1.5) Y cuerpo >= bodyPct*rango (default
// 0.70). Opcional (requireContraction): exige que las >=3 velas previas tuvieran rango <
// ATR14 (expansion-tras-compresion); como el core es PURO, esa condicion la precomputa el
// consumidor y la pasa en priorContraction. dir = signo del cuerpo (cierre vs apertura).
// OHLC por parametro -> funcion PURA, portable a golden tests MQL5 (ADR-002). Devuelve un
// SMC_Event KIND_DISPLACEMENT anclado en la barra de la vela (price = cierre), o na. Con
// atr14 na -> na. DRY: f_detectMSS comparte esta misma logica de tamaño (la llama con
// requireContraction = false, pues §1.5 no exige contraccion) -> MSS queda byte-identico.
f_detectDisplacement(float o, float h, float l, float c, float atr14, float factor, float bodyPct, bool requireContraction, bool priorContraction, int barIdx, int barTime) =>
    SMC_Event ev = na
    if not na(atr14)
        float rng  = h - l
        float body = math.abs(c - o)
        bool  sizeOk = rng > 0 and rng >= (factor * atr14) and body >= (bodyPct * rng)
        bool  contractionOk = not requireContraction or priorContraction
        if sizeOk and contractionOk
            int dir = c >= o ? DIR_BULL : DIR_BEAR
            ev := SMC_Event.new(c, dir, barIdx, barTime, "", KIND_DISPLACEMENT)
    ev

// --- MSS — Market Structure Shift [reglas-smc-ict §1.5] · T12 ---
// f_detectMSS: un MSS es un CHoCH de escala SWING (§1.4) cuya vela de ruptura es un
// displacement institucional (giro CON conviccion). NO recalcula la ruptura: recibe el
// evento swing ya producido por f_detectStructure y lo CALIFICA. Solo si chochEv es un
// CHoCH (no BOS, no na) y la vela que cerro la ruptura es displacement (§4.1, via
// f_detectDisplacement con requireContraction = false). Devuelve un SMC_Event KIND_MSS (capa
// ADITIVA: el CHoCH se conserva en su array; el MSS es la confluencia #5 de mayor peso
// esperado, §1.5) o na. Solo escala swing -> el consumidor no lo invoca con el evento
// interno (un MSS nunca es interno, §1.5). La vela de ruptura es la barra confirmada que
// produjo el cierre; su OHLC entra por parametro -> funcion PURA (ADR-002). atr14 na -> na.
f_detectMSS(SMC_Event chochEv, float oBreak, float hBreak, float lBreak, float cBreak, float atr14, float dispFactor, float bodyPct) =>
    SMC_Event ev = na
    if not na(chochEv) and chochEv.kind == KIND_CHOCH and not na(atr14)
        SMC_Event disp = f_detectDisplacement(oBreak, hBreak, lBreak, cBreak, atr14, dispFactor, bodyPct, false, false, chochEv.barIdx, chochEv.barTime)
        if not na(disp)
            ev := SMC_Event.new(chochEv.price, chochEv.dir, chochEv.barIdx, chochEv.barTime, "", KIND_MSS)
    ev

// --- IDM — Inducement [reglas-smc-ict §3.6] · T17 ---
// f_detectIDM: la liquidez SENUELO interna. Un swing interno (internalLen) cuya liquidez se
// barre (GRAB: la mecha perfora el nivel y el cierre vuelve del lado original) ANTES de que el
// precio alcance el OB/FVG objetivo -> "induce" entradas tempranas que el smart money toma
// antes del movimiento real (confluencia #33). IDM alcista = grab del internal LOW (sell-side
// senuelo) con cierre de vuelta arriba -> camino limpio al alza; bajista = grab del internal
// HIGH con cierre de vuelta abajo. Recibe los niveles internos vigentes (structInternal) + el
// OHLC de la barra confirmada -> funcion PURA (ADR-002). El gate "antes de tocar el objetivo
// OB/FVG" refina el PESO en el scoring (Fase 3), NO la deteccion del primitivo: aqui se emite
// el grab interno. Distinto del sweep de pools (escala swing/EQHL, §3.2). Devuelve un
// SMC_Event KIND_IDM en el nivel barrido, o na. Nivel na -> ese lado no dispara. Mutuamente
// excluyente por barra (un grab por lado; alcista tiene precedencia en el raro doble grab).
f_detectIDM(float intLow, float intHigh, float curLow, float curHigh, float curClose, int barIdx, int barTime) =>
    SMC_Event ev = na
    if not na(intLow) and curLow < intLow and curClose > intLow
        ev := SMC_Event.new(intLow, DIR_BULL, barIdx, barTime, "", KIND_IDM)
    else if not na(intHigh) and curHigh > intHigh and curClose < intHigh
        ev := SMC_Event.new(intHigh, DIR_BEAR, barIdx, barTime, "", KIND_IDM)
    ev

// --- Judas Swing [reglas-smc-ict §3.5] · T18 ---
// f_detectJudas: la TRAMPA de apertura de sesion (el "beso de Judas"). Un sweep/grab (§3.2) en la
// PRIMERA MITAD de una Kill Zone (movimiento FALSO) seguido de un DISPLACEMENT (§4.1) en la direccion
// REAL dentro de <= judasBars velas -> confluencia #13. f_detectSweep ya entrega el sesgo CONTRARIO al
// lado barrido (SSL barrido -> DIR_BULL, BSL barrido -> DIR_BEAR), que es justo la direccion del
// movimiento real; por eso el Judas exige displacement.dir == sweep.dir (la reversion con FUERZA que
// confirma la trampa; un sweep que continua sin displacement contrario NO es Judas, solo sweep). dir
// del Judas = dir del displacement. PURA y SIN estado propio (el core no guarda var, ADR-002): el
// consumidor mantiene el sweep PENDIENTE (pendDir/pendBarIdx/pendLevel) entre barras y lo pasa por
// parametro; la funcion lo COMPLETA, lo EXPIRA fuera de ventana, o REGISTRA uno nuevo, y devuelve el
// estado mutado + el evento. Orden por barra: completar -> expirar -> registrar (el sweep nuevo nunca
// se autocompleta en su propia barra; el displacement debe SEGUIRLO, age >= 1). pendDir 0 = sin
// pendiente. El Judas se ancla en la barra del displacement (confirmacion, anti-repaint) al nivel
// barrido (origen de la trampa). Devuelve [SMC_Event judas, int pendDir, int pendBarIdx, float pendLevel].
f_detectJudas(SMC_Event sweepEv, SMC_Event dispEv, bool kzFirstHalf, int pendDir, int pendBarIdx, float pendLevel, int curBarIdx, int curBarTime, int judasBars) =>
    SMC_Event ev   = na
    int   outDir   = pendDir
    int   outIdx   = pendBarIdx
    float outLevel = pendLevel
    // 1) COMPLETAR: displacement de esta barra en la direccion del sweep pendiente, dentro de ventana
    if outDir != 0 and not na(dispEv) and dispEv.dir == outDir
        int age = curBarIdx - outIdx
        if age >= 1 and age <= judasBars
            ev       := SMC_Event.new(outLevel, outDir, curBarIdx, curBarTime, "", KIND_JUDAS)
            outDir   := 0
            outIdx   := na
            outLevel := na
    // 2) EXPIRAR: pendiente que supero la ventana sin displacement contrario
    if outDir != 0 and (curBarIdx - outIdx) > judasBars
        outDir   := 0
        outIdx   := na
        outLevel := na
    // 3) REGISTRAR: sweep en 1a mitad de KZ queda PENDIENTE (el mas reciente reemplaza al anterior)
    if not na(sweepEv) and kzFirstHalf
        outDir   := sweepEv.dir
        outIdx   := curBarIdx
        outLevel := sweepEv.price
    [ev, outDir, outIdx, outLevel]

// --- Order Blocks + mitigacion [reglas-smc-ict §2.1] · T05 ---
// Porta el algoritmo de Order Blocks de LuxAlgo (storeOrdeBlock :502-525,
// deleteOrderBlocks :478-500; v5->v6). El OB es la vela origen del impulso que rompe
// estructura: en ruptura ALCISTA, la vela de MINIMO de la pierna [pivote roto ->
// ruptura]; en BAJISTA, la de MAXIMO. El SWAP high<->low en barras de alta
// volatilidad ((hi-lo) >= highVolFactor*vol) excluye la vela de impulso -> el OB es la
// ultima consolidacion ANTES del impulso. Zona = [low, high] de esa vela (obBounds
// high/low, §2.1). En vez de referencia historica dinamica de series (fragil: RE10045
// fuera de la historia cargada + sin equivalente MQL5), recorre buffers ROLLING de
// barras (bHighs/bLows/bIdxs/bTimes/bVols, que el consumidor puebla cada barra
// confirmada) -> runtime-safe y portable a golden tests MQL5 (ADR-002). Recorre el
// buffer de atras hacia adelante incluyendo barras con originBarIdx <= barIdx <
// ev.barIdx (excluye la barra de ruptura, igual que el slice de LuxAlgo). Solo con
// ruptura CONFIRMADA -> no repinta [§2.1, D-PINE-03]. Devuelve SMC_Zone ZS_ACTIVE o na.
// LIMITE: si originBarIdx (pivote roto) quedo a mas de MAX_BARBUF barras atras, sale del
// buffer rolling y se devuelve na SIN aviso (~21 dias en H1). Replicar el limite en MQL5
// (golden tests, ADR-002); si en Fase 3 estorba, subir MAX_BARBUF o loggear el miss.
f_detectOB(SMC_Event ev, int originBarIdx, array<float> bHighs, array<float> bLows, array<int> bIdxs, array<int> bTimes, array<float> bVols, float highVolFactor, int kind) =>
    SMC_Zone z = na
    if not na(ev) and not na(originBarIdx)
        int n = array.size(bIdxs)
        int   bestPos = na
        float bestVal = na
        if n > 0
            for p = n - 1 to 0
                int bi = array.get(bIdxs, p)
                if bi < originBarIdx
                    break
                if bi < ev.barIdx
                    float hi = array.get(bHighs, p)
                    float lo = array.get(bLows, p)
                    bool hv = (hi - lo) >= (highVolFactor * array.get(bVols, p))
                    if ev.dir == DIR_BULL
                        float pv = hv ? hi : lo
                        if na(bestVal) or pv < bestVal
                            bestVal := pv
                            bestPos := p
                    else
                        float pv = hv ? lo : hi
                        if na(bestVal) or pv > bestVal
                            bestVal := pv
                            bestPos := p
        if not na(bestPos)
            z := SMC_Zone.new(array.get(bHighs, bestPos), array.get(bLows, bestPos), ev.dir, array.get(bIdxs, bestPos), array.get(bTimes, bestPos), ZS_ACTIVE, 0.0, "", kind)
    z

// f_updateZoneMitigation: maquina de estados de mitigacion/invalidacion del UDT
// SMC_Zone [§2.1]. Mas rica que el borrado binario de LuxAlgo (deleteOrderBlocks
// ref :481-500): cuatro estados + mitigatedPct. useClose = fuente (§2.1
// obMitigation): true exige CIERRE dentro; false (HIGHLOW, default) basta la mecha.
// OB ALCISTA (soporte, el precio entra desde arriba): borde cercano = top, borde
// lejano/protector = bottom. PARCIAL si la fuente perfora el top sin llegar al
// bottom (mitigatedPct = (top-src)/altura); MITIGADA si la fuente alcanza el bottom
// (borde lejano, "hizo su trabajo"); INVALIDA si una vela CIERRA bajo el bottom
// (borde protector roto -> candidato a Breaker §Tier2). Bajista simetrico (entra
// desde abajo; protector = top; invalida si close > top). La invalidacion (close)
// tiene prioridad sobre la mitigacion (mecha). ZS_INVALID es terminal; ZS_MITIGATED
// no regresa a PARCIAL (guard state < ZS_MITIGATED) pero puede escalar a INVALID.
// Anti-repaint: llamar dentro de barstate.isconfirmed.
f_updateZoneMitigation(SMC_Zone z, bool useClose) =>
    if z.state != ZS_INVALID
        float height = z.top - z.bottom
        if z.dir == DIR_BULL
            float src = useClose ? close : low
            if close < z.bottom
                z.state := ZS_INVALID
                z.mitigatedPct := 1.0
            else if src <= z.bottom
                z.state := ZS_MITIGATED
                z.mitigatedPct := 1.0
            else if src < z.top
                if z.state < ZS_MITIGATED
                    z.state := ZS_PARTIAL
                z.mitigatedPct := math.max(z.mitigatedPct, height > 0 ? (z.top - src) / height : 0.0)
        else
            float src = useClose ? close : high
            if close > z.top
                z.state := ZS_INVALID
                z.mitigatedPct := 1.0
            else if src >= z.top
                z.state := ZS_MITIGATED
                z.mitigatedPct := 1.0
            else if src > z.bottom
                if z.state < ZS_MITIGATED
                    z.state := ZS_PARTIAL
                z.mitigatedPct := math.max(z.mitigatedPct, height > 0 ? (src - z.bottom) / height : 0.0)
    z

// --- Breaker [reglas-smc-ict §2.6] · T19 ---
// f_detectBreaker: un OB que FALLO (paso a ZS_INVALID: una vela cerro atravesando su borde protector,
// §2.1) cambia de POLARIDAD y opera en sentido contrario (un OB alcista roto a la baja -> resistencia
// breaker bajista en el retest). Confluencia #22. Se llama JUSTO tras f_updateZoneMitigation con el
// estado PREVIO de la zona: si la zona ES un OB y ACABA de transicionar a ZS_INVALID (prevState !=
// ZS_INVALID), crea una SMC_Zone KIND_BREAKER en las MISMAS coordenadas [top,bottom] con dir INVERTIDO
// y ZS_ACTIVE -> el retest lo gestiona la MISMA maquina f_updateZoneMitigation (hereda §2.1). Un OB
// solo MITIGADO (ZS_MITIGATED, precio toco y respeto) NO es breaker -> el guard exige INVALID (cierre a
// traves), no un mero toque. Guard kind == KIND_OB: un breaker invalidado NO engendra otro breaker.
// PURA (no lee series; recibe la zona ya mutada + su estado previo). Devuelve SMC_Zone KIND_BREAKER o na.
f_detectBreaker(SMC_Zone z, int prevState) =>
    SMC_Zone bz = na
    if z.kind == KIND_OB and z.state == ZS_INVALID and prevState != ZS_INVALID
        int invDir = z.dir == DIR_BULL ? DIR_BEAR : DIR_BULL
        bz := SMC_Zone.new(z.top, z.bottom, invDir, z.barIdx, z.barTime, ZS_ACTIVE, 0.0, z.tf, KIND_BREAKER)
    bz

// --- Propulsion Block [reglas-smc-ict §5.8] · T34 ---
// f_isPropulsion: ¿el OB recien formado (newOB) esta ANIDADO dentro de un OB vivo PREVIO del MISMO dir?
// -> OB de CONTINUACION (propulsion, §5.8). Solapa con un OB vivo (state < ZS_MITIGATED) mismo-sentido en
// >= propOverlap de la altura del newOB. Es un FLAG (refina #17/#19, eleva el peso del OB), NO zona nueva.
// PURA. Devuelve bool. El consumidor lo aplica al obZone antes de empujarlo.
f_isPropulsion(SMC_Zone newOB, array<SMC_Zone> zones, float propOverlap) =>
    bool prop = false
    if not na(newOB) and newOB.kind == KIND_OB and array.size(zones) > 0
        float h = newOB.top - newOB.bottom
        for i = array.size(zones) - 1 to 0
            SMC_Zone z = array.get(zones, i)
            if z.kind == KIND_OB and z.dir == newOB.dir and z.state < ZS_MITIGATED and z.barIdx != newOB.barIdx
                float ov = math.min(z.top, newOB.top) - math.max(z.bottom, newOB.bottom)
                if h > 0 and ov >= propOverlap * h
                    prop := true
                    break
    prop

// --- IFVG — Inversion FVG [reglas-smc-ict §5.2] · T27 ---
// f_detectIFVG: el ANALOGO del Breaker (§2.6) pero sobre FVG. Un FVG que FALLO (paso a ZS_INVALID: una
// vela cerro atravesando su borde protector, §2.2) INVIERTE su rol -> se re-crea como SMC_Zone KIND_IFVG
// en las mismas coordenadas con dir INVERTIDO y ZS_ACTIVE; el retest lo gestiona la MISMA
// f_updateZoneMitigation. Guard kind == KIND_FVG (un IFVG no engendra otro) + transicion prevState !=
// ZS_INVALID (solo en el cruce). Un FVG solo MITIGADO (rellenado y respetado) NO es IFVG (§5.2). PURA.
// Confluencia candidata #43. Devuelve SMC_Zone KIND_IFVG o na.
f_detectIFVG(SMC_Zone z, int prevState) =>
    SMC_Zone iz = na
    if z.kind == KIND_FVG and z.state == ZS_INVALID and prevState != ZS_INVALID
        int invDir = z.dir == DIR_BULL ? DIR_BEAR : DIR_BULL
        iz := SMC_Zone.new(z.top, z.bottom, invDir, z.barIdx, z.barTime, ZS_ACTIVE, 0.0, z.tf, KIND_IFVG)
    iz

// --- BPR — Balanced Price Range [reglas-smc-ict §5.3] · T28 ---
// f_detectBPR: zona de "precio balanceado" = INTERSECCION de un FVG alcista y uno bajista que se
// solapan (§5.3). Recibe el FVG recien creado (newFvg) y busca en zones un FVG vivo de dir OPUESTO,
// creado en <= bprWindow velas, cuya interseccion `[max(bottoms), min(tops)]` tenga altura >= minOverlap.
// La `dir` del BPR se fija por el LADO desde el que el precio retesteara (refClose): si el precio esta
// ARRIBA de la zona entrara desde arriba -> tratarla como SOPORTE (DIR_BULL); si esta ABAJO ->
// RESISTENCIA (DIR_BEAR); dentro -> hereda la del newFvg. Asi reutiliza limpio f_updateZoneMitigation
// (la regla la llama "neutra"; aqui el sesgo lo da el contexto de aproximacion). PURA. Devuelve KIND_BPR
// o na. Confluencia candidata #44.
f_detectBPR(SMC_Zone newFvg, array<SMC_Zone> zones, float refClose, int curBarIdx, int bprWindow, float minOverlap) =>
    SMC_Zone bpr = na
    if not na(newFvg) and newFvg.kind == KIND_FVG and array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            SMC_Zone z = array.get(zones, i)
            if z.kind == KIND_FVG and z.dir != newFvg.dir and z.state < ZS_MITIGATED and (curBarIdx - z.barIdx) <= bprWindow
                float lo = math.max(newFvg.bottom, z.bottom)
                float hi = math.min(newFvg.top, z.top)
                if hi - lo >= minOverlap
                    int bdir = refClose > hi ? DIR_BULL : refClose < lo ? DIR_BEAR : newFvg.dir
                    bpr := SMC_Zone.new(hi, lo, bdir, curBarIdx, newFvg.barTime, ZS_ACTIVE, 0.0, "", KIND_BPR)
                    break
    bpr

// --- Immediate Rebalance (IR) [reglas-smc-ict §5.4] · T29 ---
// f_detectImmediateRebalance: lo CONTRARIO al FVG. Una vela de impulso (vela `1`: rango >= irFactor*ATR
// y cuerpo >= irBodyPct*rango) cuyo desequilibrio es REBALANCEADO de inmediato por la vela siguiente
// (vela `0`: cierra de vuelta dentro del cuerpo de la `1`, pasado su 50%) -> no queda ineficiencia (§5.4).
// Evento puntual (P4), `dir` = el de la vela de impulso. PURA (OHLC de la vela impulso + close del
// rebalanceador). Devuelve SMC_Event KIND_IR (anclado en el 50% de la vela impulso) o na. atr14 na -> na.
f_detectImmediateRebalance(float o1, float h1, float l1, float c1, float c0, float atr14, float irFactor, float irBodyPct, int barIdx, int barTime) =>
    SMC_Event ev = na
    if not na(atr14)
        float rng  = h1 - l1
        float body = math.abs(c1 - o1)
        bool impulse = rng > 0 and rng >= irFactor * atr14 and body >= irBodyPct * rng
        if impulse
            float mid = (o1 + c1) / 2.0
            int dir = c1 >= o1 ? DIR_BULL : DIR_BEAR
            bool rebalanced = (dir == DIR_BULL and c0 <= mid) or (dir == DIR_BEAR and c0 >= mid)
            if rebalanced
                ev := SMC_Event.new(mid, dir, barIdx, barTime, "", KIND_IR)
    ev

// --- Volume Imbalance + SIVI/BIVI [reglas-smc-ict §5.5] · T31 ---
// f_detectVolumeImbalance: micro-desequilibrio entre CUERPOS de velas consecutivas CON solape de mechas
// (a diferencia del FVG, que es hueco entre extremos sin solape). BIVI alcista: open actual > close
// previo con gap de cuerpo >= viThreshold*ATR Y las mechas solapan (low actual <= high previo). SIVI
// bajista: simetrico (open < close previo, high actual >= low previo). Zona micro = [close_previo,
// open_actual]. Una sola familia (no cuenta 3x, [FIX P-05]). PURA. Devuelve SMC_Zone KIND_VI o na.
f_detectVolumeImbalance(float o0, float h0, float l0, float cPrev, float hPrev, float lPrev, float atr14, float viThreshold, int barIdx, int barTime) =>
    SMC_Zone z = na
    if not na(atr14)
        float thr = viThreshold * atr14
        if o0 > cPrev and (o0 - cPrev) >= thr and l0 <= hPrev
            z := SMC_Zone.new(o0, cPrev, DIR_BULL, barIdx, barTime, ZS_ACTIVE, 0.0, "", KIND_VI)
        else if o0 < cPrev and (cPrev - o0) >= thr and h0 >= lPrev
            z := SMC_Zone.new(cPrev, o0, DIR_BEAR, barIdx, barTime, ZS_ACTIVE, 0.0, "", KIND_VI)
    z

// --- Gaps de apertura — NWOG/NDOG/NYMO + Breakaway [reglas-smc-ict §5.10] · T30 ---
// f_classifyOpenGap: clasifica el salto cierre_previo -> open_nuevo en la frontera de sesion/dia/semana.
// Devuelve [measurable, dir]: measurable = |gap| >= gapMin*ATR (en FX 24h el diario suele ser ~0 -> el
// valor esta en el NIVEL ancla, no en el gap; el gap real aparece en fin de semana / instrumentos con
// cierre). dir = signo del gap. La deteccion de frontera (newDay/newWeek/NYmidnight) y los niveles
// persistentes (NWOG/NDOG/NYMO) viven en el consumidor (series de tiempo); Breakaway = gap measurable
// con continuacion (close mas alla del open en la dir del gap) -> KIND_BAG (#45). PURA.
f_classifyOpenGap(float openNew, float closePrev, float atr14, float gapMin) =>
    float g = openNew - closePrev
    int  dir = g > 0 ? DIR_BULL : g < 0 ? DIR_BEAR : 0
    bool measurable = not na(atr14) and math.abs(g) >= gapMin * atr14
    [measurable, dir]

// --- Vacuum Block [reglas-smc-ict §5.7] · T33 ---
// f_detectVacuumBlock: un VACIO de precio por apertura -> gap GRANDE (|open_nuevo - close_previo| >=
// vacuumFactor*ATR) donde no hubo negociacion -> iman de RETORNO (el precio tiende a volver a rellenarlo).
// Zona = [min, max] del par (close_previo, open_nuevo). dir por lado de relleno: gap ARRIBA (DIR_BULL ->
// el precio vuelve desde arriba y rellena hasta close_previo = mitigado); gap ABAJO simetrico. Distinto
// del Volume Imbalance (§5.5, micro, mechas solapan) y del FVG (§2.2, 3 velas): es UN gap grande de
// apertura. Ciclo de vida via f_updateZoneMitigation. PURA. Devuelve SMC_Zone KIND_VACUUM o na. #48.
f_detectVacuumBlock(float openNew, float closePrev, float atr14, float vacuumFactor, int barIdx, int barTime) =>
    SMC_Zone z = na
    if not na(atr14)
        float g = openNew - closePrev
        if math.abs(g) >= vacuumFactor * atr14
            int dir = g > 0 ? DIR_BULL : DIR_BEAR
            z := SMC_Zone.new(math.max(openNew, closePrev), math.min(openNew, closePrev), dir, barIdx, barTime, ZS_ACTIVE, 0.0, "", KIND_VACUUM)
    z

// --- IPR — Imbalanced Price Range [reglas-smc-ict §5.9] · T35 ---
// f_detectIPR: rango DESBALANCEADO = acumulacion de >= iprMinGaps FVG (§2.2) del MISMO dir en una ventana
// de iprWindow velas, SIN ningun FVG opuesto que lo neutralice. El rango [min(bottoms), max(tops)] de esos
// gaps "tira" hacia ese lado -> CONTEXTO de bias (no zona puntual de entrada). Opuesto conceptual del BPR
// (§5.3: alli los gaps son opuestos y se cruzan; aqui del mismo lado y se apilan). PURA: escanea los FVG
// vivos de zones. Devuelve SMC_Zone KIND_IPR (dir = el comun) o na. Confluencia candidata #49.
f_detectIPR(array<SMC_Zone> zones, int curBarIdx, int curBarTime, int iprWindow, int iprMinGaps) =>
    SMC_Zone z = na
    int   bullN = 0
    int   bearN = 0
    float bTop = na
    float bBot = na
    float sTop = na
    float sBot = na
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            SMC_Zone zz = array.get(zones, i)
            if zz.kind == KIND_FVG and zz.state < ZS_MITIGATED and (curBarIdx - zz.barIdx) <= iprWindow
                if zz.dir == DIR_BULL
                    bullN += 1
                    bTop := na(bTop) ? zz.top : math.max(bTop, zz.top)
                    bBot := na(bBot) ? zz.bottom : math.min(bBot, zz.bottom)
                else
                    bearN += 1
                    sTop := na(sTop) ? zz.top : math.max(sTop, zz.top)
                    sBot := na(sBot) ? zz.bottom : math.min(sBot, zz.bottom)
    if bullN >= iprMinGaps and bearN == 0
        z := SMC_Zone.new(bTop, bBot, DIR_BULL, curBarIdx, curBarTime, ZS_ACTIVE, 0.0, "", KIND_IPR)
    else if bearN >= iprMinGaps and bullN == 0
        z := SMC_Zone.new(sTop, sBot, DIR_BEAR, curBarIdx, curBarTime, ZS_ACTIVE, 0.0, "", KIND_IPR)
    z

// --- Inside Day [reglas-smc-ict §5.12] · T37 ---
// f_detectInsideDay: dia cuyo rango esta CONTENIDO en el del dia previo (high1 < high2 y low1 > low2,
// donde 1 = dia recien cerrado, 2 = el anterior) -> COMPRESION de volatilidad (suele preceder expansion).
// Geometria pura sobre el snapshot D1 (el consumidor trae los niveles via request.security, lookahead_off,
// y llama en la transicion de dia). dir = 0 (neutro: la direccion la da la ruptura posterior del rango).
// Devuelve SMC_Event KIND_INSIDEDAY anclado al medio del rango interior, o na. Confluencia candidata #50.
f_detectInsideDay(float h1, float l1, float h2, float l2, int barIdx, int barTime) =>
    SMC_Event ev = na
    if not na(h1) and not na(h2) and h1 < h2 and l1 > l2
        ev := SMC_Event.new((h1 + l1) / 2.0, 0, barIdx, barTime, "", KIND_INSIDEDAY)
    ev

// --- SMT Divergence [reglas-smc-ict §5.13 · ADR-011] · T38 ---
// f_smtPivots: devuelve los ULTIMOS DOS swing highs y lows (len-pivotes) del contexto donde se evalua.
// Se llama via request.security al par correlacionado (ADR-011) -> trae sus pivotes; var por-contexto
// (R-P3-1). Devuelve [shCur, shPrev, slCur, slPrev]. (No PURA: usa ta.pivot* + var, como f_computeTFState.)
f_smtPivots(int len) =>
    float ph = ta.pivothigh(len, len)
    float pl = ta.pivotlow(len, len)
    var float shCur  = na
    var float shPrev = na
    var float slCur  = na
    var float slPrev = na
    if not na(ph)
        shPrev := shCur
        shCur  := ph
    if not na(pl)
        slPrev := slCur
        slCur  := pl
    [shCur, shPrev, slCur, slPrev]

// f_detectSMT: divergencia entre el chart y un simbolo CORRELACIONADO (ADR-011). Al confirmar el chart un
// nuevo swing high: SMT BAJISTA si el chart hace HIGHER-HIGH pero el correlacionado NO lo confirma
// (positiva: no hace HH; inversa: no hace LL). Simetrico en swing low -> SMT ALCISTA. inverse invierte el
// extremo que debe confirmar el correlacionado (positiva GBPUSD = default ADR-011). PURA (recibe los
// pivotes ya traidos). Devuelve SMC_Event KIND_SMT o na. Confluencia candidata #51 (calidad alta).
f_detectSMT(bool chartNewSH, float chSHcur, float chSHprev, bool chartNewSL, float chSLcur, float chSLprev, float coSHcur, float coSHprev, float coSLcur, float coSLprev, bool inverse, int barIdx, int barTime) =>
    SMC_Event ev = na
    if chartNewSH and not na(chSHprev) and not na(coSHprev) and not na(coSLprev)
        bool chartHH = chSHcur > chSHprev
        bool corrConfirmsHigh = inverse ? (coSLcur < coSLprev) : (coSHcur > coSHprev)
        if chartHH and not corrConfirmsHigh
            ev := SMC_Event.new(chSHcur, DIR_BEAR, barIdx, barTime, "", KIND_SMT)
    if na(ev) and chartNewSL and not na(chSLprev) and not na(coSHprev) and not na(coSLprev)
        bool chartLL = chSLcur < chSLprev
        bool corrConfirmsLow = inverse ? (coSHcur > coSHprev) : (coSLcur < coSLprev)
        if chartLL and not corrConfirmsLow
            ev := SMC_Event.new(chSLcur, DIR_BULL, barIdx, barTime, "", KIND_SMT)
    ev

// --- Standard Deviation [reglas-smc-ict §5.11] · T36 ---
// f_projStdDev: HERRAMIENTA de proyeccion (NO confluencia, §0.9): dado un rango ancla [a=origen,
// b=extremo] de una pierna, proyecta el objetivo a n desviaciones en la DIRECCION de la pierna:
// nivel = b + n*(b - a). Continuacion mas alla de b (n=1,2,2.5,4 = los multiplos estandar ICT, rotulados
// nominalmente -1/-2/-2.5/-4). Insumo de f_computeSLTP (TP del motor EA, Fase 2/3); NO entra al scoring.
// PURA. Devuelve el nivel proyectado (float).
f_projStdDev(float a, float b, float n) =>
    b + n * (b - a)

// --- CISD — Change in State of Delivery [reglas-smc-ict §5.6] · T32 ---
// f_detectCISD: el precio venia "entregando" en una direccion (un RUN de >= cisdMinRun velas del mismo
// color = la pierna de delivery) y CIERRA de vuelta cruzando el ORIGEN de ese run (el open de su primera
// vela). Giro mas TEMPRANO y fino que el CHoCH (rompe el open de la pierna, no un pivote swing). El
// consumidor mantiene el run vigente (runDir/runLen/runOrigin) y lo pasa aqui (estado de la pierna que
// termino en la barra previa). CISD alcista: tras run BAJISTA, curClose > runOrigin con curOpen <=
// runOrigin; bajista simetrico. El gate cisdMinRun (>=2) lo hace distinguible del ruido (NO duplica
// CHoCH/MSS: puede dispararse sin romper pivote). PURA. Devuelve SMC_Event KIND_CISD o na. Confluencia #47.
f_detectCISD(float curOpen, float curClose, int runDir, float runOrigin, int runLen, int cisdMinRun, int barIdx, int barTime) =>
    SMC_Event ev = na
    if runLen >= cisdMinRun and not na(runOrigin)
        if runDir < 0 and curClose > runOrigin and curOpen <= runOrigin
            ev := SMC_Event.new(runOrigin, DIR_BULL, barIdx, barTime, "", KIND_CISD)
        else if runDir > 0 and curClose < runOrigin and curOpen >= runOrigin
            ev := SMC_Event.new(runOrigin, DIR_BEAR, barIdx, barTime, "", KIND_CISD)
    ev

// --- Fair Value Gaps (FVG) + CE [reglas-smc-ict §2.2] · T06 ---
// f_detectFVG: ineficiencia de 3 velas (hueco sin negociar). Evaluada al CIERRE de la
// 3.a vela (la actual al confirmar) sobre offsets FIJOS [0] y [2] -> referencia
// historica ESTATICA (no dinamica): RE10045-safe y trivial en MQL5 (rates[i-2]).
// Funcion pura: recibe los 4 precios (h0/l0 vela actual, h2/l2 vela -2), no lee series
// -> golden tests MQL5 directos (ADR-002). FVG alcista: low[0] > high[2] -> gap
// [high[2], low[0]] (dir BULL); bajista: high[0] < low[2] -> gap [high[0], low[2]]
// (dir BEAR). Mutuamente excluyentes (un mismo trio no es alcista y bajista a la vez).
// Filtro de tamaño: altura >= threshold (modo fixed: 0.25*ATR14, el default validado y
// congelado ADR-002; el modo auto de LuxAlgo es %-based y choca con la doctrina ATR
// (regla dura #3) -> NO se porta, revisitar en Fase 3 solo si estorba). El CE (50% =
// (top+bottom)/2) NO se almacena: se deriva de top/bottom en dibujo y scoring (#26
// FVG-CE tocado). Mitigacion via la MISMA maquina f_updateZoneMitigation (§2.2 "igual
// maquina de estados que el OB"). barIdx/barTime = 3.a vela (oraculo ver05 bars[i]['t']).
// Anti-repaint: llamar en barstate.isconfirmed [§2.2, D-PINE-03]. NB: LuxAlgo usa
// request.security(...lookahead_on) (:634, repinta) + filtro extra close>high[2]; aqui
// NO (TF propio, sin lookahead; el oraculo solo exige gap + umbral). Devuelve SMC_Zone
// ZS_ACTIVE o na.
f_detectFVG(float h0, float l0, float h2, float l2, int barIdx, int barTime, float threshold, int kind) =>
    SMC_Zone z = na
    if l0 > h2 and (l0 - h2) >= threshold
        z := SMC_Zone.new(l0, h2, DIR_BULL, barIdx, barTime, ZS_ACTIVE, 0.0, "", kind)
    else if h0 < l2 and (l2 - h0) >= threshold
        z := SMC_Zone.new(l2, h0, DIR_BEAR, barIdx, barTime, ZS_ACTIVE, 0.0, "", kind)
    z

// --- Rejection [reglas-smc-ict §2.7] · T20 ---
// f_wickNearLevel: ¿la punta de la mecha (wick = low en rejection alcista / high en bajista) TOCA un
// nivel clave dentro de tol? Niveles: zonas activas OB/FVG/Breaker (dentro de [bottom-tol, top+tol]),
// pools vivos (no barridos), EQH/EQL, bordes Premium/Discount (pdH/pdL/pdM) y EMAs (20/50/200). Es el
// ANCLA que distingue una rejection operable de una mecha "en medio de la nada" (ruido, §2.7
// contraejemplo). PURA: recibe arrays + escalares, no lee series -> portable a golden tests (ADR-002).
// Devuelve bool. Cortocircuita (break) en cuanto encuentra un nivel.
f_wickNearLevel(float wick, array<SMC_Zone> zones, array<SMC_Pool> pools, array<SMC_Event> eqhl, float pdH, float pdL, float pdM, float e20, float e50, float e200, float tol) =>
    bool near = false
    if not na(wick)
        if array.size(zones) > 0
            for i = 0 to array.size(zones) - 1
                SMC_Zone z = array.get(zones, i)
                if z.state < ZS_MITIGATED and wick >= z.bottom - tol and wick <= z.top + tol
                    near := true
                    break
        if not near and array.size(pools) > 0
            for i = 0 to array.size(pools) - 1
                SMC_Pool p = array.get(pools, i)
                if not p.swept and math.abs(wick - p.level) <= tol
                    near := true
                    break
        if not near and array.size(eqhl) > 0
            for i = 0 to array.size(eqhl) - 1
                if math.abs(wick - array.get(eqhl, i).price) <= tol
                    near := true
                    break
        if not near and ((not na(pdH) and math.abs(wick - pdH) <= tol) or (not na(pdL) and math.abs(wick - pdL) <= tol) or (not na(pdM) and math.abs(wick - pdM) <= tol))
            near := true
        if not near and ((not na(e20) and math.abs(wick - e20) <= tol) or (not na(e50) and math.abs(wick - e50) <= tol) or (not na(e200) and math.abs(wick - e200) <= tol))
            near := true
    near

// f_detectRejection: vela de RECHAZO en un nivel clave (el precio intento penetrar y fue devuelto con
// fuerza, §2.7, confluencia #23). Alcista: mecha INFERIOR >= rejWickFactor*cuerpo (default 2x), cierra
// en la mitad SUPERIOR del rango y el low TOCA un nivel clave (nearLow). Bajista: simetrico con mecha
// SUPERIOR, cierre en mitad inferior y high tocando nivel (nearHigh). cuerpo = |c-o|; mecha inferior =
// min(o,c)-l; mecha superior = h-max(o,c). El ancla al nivel la precomputa el consumidor (f_wickNearLevel)
// y la pasa como bool -> esta funcion es geometria PURA (OHLC + flags), trivial en golden tests MQL5
// (ADR-002). Precedencia alcista en el raro doble (c == mid con ambas mechas). Devuelve SMC_Event
// KIND_REJECTION en la punta de la mecha (l alcista / h bajista), o na. rng 0 -> na.
f_detectRejection(float o, float h, float l, float c, float rejWickFactor, bool nearLow, bool nearHigh, int barIdx, int barTime) =>
    SMC_Event ev = na
    float rng = h - l
    if rng > 0
        float body      = math.abs(c - o)
        float lowerWick = math.min(o, c) - l
        float upperWick = h - math.max(o, c)
        float mid       = (h + l) / 2.0
        bool bull = lowerWick >= rejWickFactor * body and c >= mid and nearLow
        bool bear = upperWick >= rejWickFactor * body and c <= mid and nearHigh
        if bull
            ev := SMC_Event.new(l, DIR_BULL, barIdx, barTime, "", KIND_REJECTION)
        else if bear
            ev := SMC_Event.new(h, DIR_BEAR, barIdx, barTime, "", KIND_REJECTION)
    ev

// --- Flip [reglas-smc-ict §2.8] · T21 ---
// f_updateFlip: ciclo de vida de un NIVEL que cambia de rol (soporte<->resistencia, confluencia #25).
// Un nivel roto por CIERRE LIMPIO (no mecha) queda LF_PENDING; ese nivel lo provee la estructura
// (BOS/CHoCH = ruptura por cierre: nivel roto = ev.price, breakDir = ev.dir). Avanza por el OHLC de la
// barra confirmada (PURA, recibe high/low/close): roto al ALZA (breakDir>0, pendiente SOPORTE) ->
// LF_FLIPPED si una vela retestea desde arriba y respeta (low <= level y close > level); LF_INVALID si
// una vela CIERRA de vuelta abajo (close < level, el soporte fallo). Roto a la BAJA simetrico (pendiente
// RESISTENCIA; flip si high >= level y close < level; invalid si close > level). El "cierre limpio" lo
// distingue del sweep (mecha), §2.8 contraejemplo. NO se evalua en su barra de ruptura (el consumidor
// registra DESPUES de actualizar). Muta y devuelve el flip.
f_updateFlip(SMC_Flip f, float barHigh, float barLow, float barClose) =>
    if f.state == LF_PENDING
        if f.breakDir > 0
            if barClose < f.level
                f.state := LF_INVALID
            else if barLow <= f.level and barClose > f.level
                f.state := LF_FLIPPED
        else
            if barClose > f.level
                f.state := LF_INVALID
            else if barHigh >= f.level and barClose < f.level
                f.state := LF_FLIPPED
    f

// --- OTE / Golden Pocket [reglas-smc-ict §2.5] · T22 ---
// f_detectOTE: tras un BOS (impulso confirmado), zonas de retroceso fib OPTIMAS para entrar A FAVOR del
// impulso. Fib con 0 en el ORIGEN y 1 en el EXTREMO de la pierna (= rango estructural vigente [swLow,
// swHigh]). GP (Golden Pocket) = retroceso [r1, r2] = [50%, 61.8%] (confluencia #28); OTE = [r2, r3] =
// [61.8%, 79%] (confluencia #27, mas profunda = mejor precio). Impulso ALCISTA (low->high): retroceso a
// la BAJA -> zonas LONG (dir BULL); bajista simetrico (dir BEAR). Solo sobre BOS (no CHoCH/correctiva,
// §2.5 contraejemplo). PURA. Devuelve [gp, ote] (SMC_Zone KIND_GP / KIND_OTE en ZS_ACTIVE) o [na, na].
// La pierna se REDIBUJA con cada nuevo impulso (consumidor: f_expireOTE las viejas antes de crear las
// nuevas). El ciclo de vida posterior (entrada/invalidacion) lo gestiona la MISMA f_updateZoneMitigation
// (patron P2, hereda §2.1). top >= bottom garantizado por la orientacion segun dir.
f_detectOTE(SMC_Event bosEv, float swHigh, float swLow, int barIdx, int barTime, float r1, float r2, float r3) =>
    SMC_Zone gp  = na
    SMC_Zone ote = na
    if not na(bosEv) and bosEv.kind == KIND_BOS and not na(swHigh) and not na(swLow) and swHigh > swLow
        float rng = swHigh - swLow
        if bosEv.dir == DIR_BULL
            float l1 = swHigh - r1 * rng
            float l2 = swHigh - r2 * rng
            float l3 = swHigh - r3 * rng
            gp  := SMC_Zone.new(l1, l2, DIR_BULL, barIdx, barTime, ZS_ACTIVE, 0.0, "", KIND_GP)
            ote := SMC_Zone.new(l2, l3, DIR_BULL, barIdx, barTime, ZS_ACTIVE, 0.0, "", KIND_OTE)
        else
            float l1 = swLow + r1 * rng
            float l2 = swLow + r2 * rng
            float l3 = swLow + r3 * rng
            gp  := SMC_Zone.new(l2, l1, DIR_BEAR, barIdx, barTime, ZS_ACTIVE, 0.0, "", KIND_GP)
            ote := SMC_Zone.new(l3, l2, DIR_BEAR, barIdx, barTime, ZS_ACTIVE, 0.0, "", KIND_OTE)
    [gp, ote]

// f_expireOTE: caduca una zona OTE/GP cuando su pierna es SUPERSEDED por un nuevo impulso (la regla
// redibuja la pierna con cada BOS, §2.5) -> ZS_INVALID (el dibujo la omite, igual que una zona
// invalidada). La invalidacion por retroceso demasiado profundo ya la cubre f_updateZoneMitigation
// (close mas alla del borde protector). PURA. Muta y devuelve la zona.
f_expireOTE(SMC_Zone z, bool superseded) =>
    if z.state != ZS_INVALID and superseded
        z.state := ZS_INVALID
    z

// --- EMAs — estado / cruces / rebotes / alineacion [reglas-smc-ict §4.3] · T23 ---
// f_emaState: confirmacion de TENDENCIA por EMAs rapida/media/lenta (confirman, no lideran -> peso base
// bajo, Fase 3). 6 confluencias DIRECCIONALES #37-#42, colapsadas de 15 por [FIX P-05] anti-doble-conteo:
// #37-#39 son direccionales UNICAS (+1/-1/0), nunca suman dos al mismo score. #37 close vs EMA lenta,
// #38 vs media, #39 vs rapida; #40 cruce reciente alineado (recentCrossDir, lo precomputa el consumidor
// con crossBars); #41 rebote en EMA (bounceDir, mecha >= rejWickFactor*cuerpo en direccion de tendencia,
// precomputado); #42 tres EMAs alineadas (rapida>media>lenta -> +1 / rapida<media<lenta -> -1). PURA
// (las instantaneas salen de close+emas; las dos con historia/geometria llegan precomputadas) ->
// portable a golden tests (ADR-002). Devuelve [s37, s38, s39, s40, s41, s42] cada uno en {-1, 0, +1}.
f_emaState(float c, float eFast, float eMid, float eSlow, int recentCrossDir, int bounceDir) =>
    int s37 = na(eSlow) ? 0 : c > eSlow ? 1 : c < eSlow ? -1 : 0
    int s38 = na(eMid)  ? 0 : c > eMid  ? 1 : c < eMid  ? -1 : 0
    int s39 = na(eFast) ? 0 : c > eFast ? 1 : c < eFast ? -1 : 0
    int s40 = recentCrossDir
    int s41 = bounceDir
    int s42 = (na(eFast) or na(eMid) or na(eSlow)) ? 0 : (eFast > eMid and eMid > eSlow ? 1 : eFast < eMid and eMid < eSlow ? -1 : 0)
    [s37, s38, s39, s40, s41, s42]

// f_emaCrossDir: cruce de la media 'a' sobre 'b' en la barra actual, comparando valores confirmados vs
// los de la barra previa (anti-repaint, no usa ta.crossover intrabar). +1 = a cruza ARRIBA de b; -1 =
// a cruza ABAJO; 0 = sin cruce. PURA (§4.3, eventos de cruce marcados/contados). Reusable por par.
f_emaCrossDir(float a, float aPrev, float b, float bPrev) =>
    (not na(aPrev) and not na(bPrev) and aPrev <= bPrev and a > b) ? 1 : (not na(aPrev) and not na(bPrev) and aPrev >= bPrev and a < b) ? -1 : 0

// --- False Breakout / Spring / Raid [reglas-smc-ict §3.7] · T24 ---
// f_detectFalseBreak: a diferencia del sweep (solo mecha), el FALSE BREAKOUT es un CIERRE mas alla de un
// nivel que REVIERTE (otra vela CIERRA de vuelta al lado original) en <= fbBars velas (confluencia #14).
// Si NO revierte en la ventana = breakout REAL (BOS), no falso (§3.7 contraejemplo). Detector por nivel
// PENDIENTE (el consumidor registra la rotura de un pool por close y mantiene el SMC_FBreak entre barras,
// como Judas/Flip). PURA: recibe el pendiente + el close de la barra confirmada. breakDir>0 = rompio
// ARRIBA (FB si cierra de vuelta abajo); <0 = rompio ABAJO (FB si cierra arriba). Devuelve: 1 = FB
// CONFIRMADO, -1 = EXPIRADO (paso la ventana sin revertir = breakout real), 0 = sigue pendiente. La
// direccion REAL del FB = opuesta a breakDir (la reversion). Ventana de retorno = edad 1..fbBars.
f_detectFalseBreak(SMC_FBreak fb, float barClose, int curBarIdx, int fbBars) =>
    int res = 0
    int age = curBarIdx - fb.barIdx
    if fb.breakDir > 0 and barClose < fb.level
        res := 1
    else if fb.breakDir < 0 and barClose > fb.level
        res := 1
    if res == 0 and age >= fbBars
        res := -1
    res

// f_classifySweep: REFINA un sweep ya detectado (§3.2, T10) en su subtipo (§3.7). RAID (confluencia #16)
// = el pool barrido tiene touches >= raidTouches (alta liquidez, stop raid -> mayor peso); precedencia
// sobre Spring. SPRING (Wyckoff, confluencia #15) = sweep ALCISTA (SSL atrapado, dir BULL) cuyo nivel
// coincide con el MINIMO del rango (rangeLow) dentro de tol -> reversion al alza desde el extremo
// inferior. Si no es ninguno, queda KIND_SWEEP. PURA: busca el pool barrido (match sweptBarIdx + nivel)
// para leer sus touches. Devuelve el KIND refinado (KIND_RAID / KIND_SPRING / KIND_SWEEP).
f_classifySweep(array<SMC_Pool> pools, float swLevel, int swDir, int swBarIdx, float rangeLow, int raidTouches, float tol) =>
    int touches = 0
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            SMC_Pool p = array.get(pools, i)
            if p.sweptBarIdx == swBarIdx and math.abs(p.level - swLevel) <= tol
                touches := math.max(touches, p.touches)
    bool isRaid   = touches >= raidTouches
    bool isSpring = swDir == DIR_BULL and not na(rangeLow) and math.abs(swLevel - rangeLow) <= tol
    isRaid ? KIND_RAID : isSpring ? KIND_SPRING : KIND_SWEEP

// --- Impulsive / Corrective [reglas-smc-ict §4.4] · T25 ---
// f_classifyLeg: CLASIFICADOR DE ESTADO (no confluencia aditiva, §4.4). El discriminador NO es tamaño ni
// eficiencia (el ER pivote-a-pivote no separa: verificado contra datos reales), sino ROMPER ESTRUCTURA
// CON FUERZA ALINEADA AL SESGO DOMINANTE. Se evalua cuando confirma una ruptura: IMPULSIVO si hay
// displacement en el tramo (legHadDisp) Y la ruptura es un BOS ALINEADO con el sesgo dominante
// (continuacion) O un MSS (§1.5, voltea con conviccion). CORRECTIVO en caso contrario (retroceso
// contra-sesgo: puede tener una vela fuerte aislada o micro-BOS interno, pero no rompe la estructura
// dominante a su favor). PURA: recibe los eventos ya detectados + el sesgo dominante + el flag de
// displacement del tramo (lo mantiene el consumidor). Devuelve KIND_IMPULSIVE / KIND_CORRECTIVE / 0
// (sin ruptura este barra). El consumidor toma dir/price del MSS (si hay) o del evento de estructura.
f_classifyLeg(SMC_Event structEv, SMC_Event mssEv, int dominantBias, bool legHadDisp) =>
    int k = 0
    if not na(mssEv)
        k := KIND_IMPULSIVE
    else if not na(structEv)
        bool aligned = structEv.kind == KIND_BOS and structEv.dir == dominantBias and legHadDisp
        k := aligned ? KIND_IMPULSIVE : KIND_CORRECTIVE
    k

// --- Premium / Discount / Equilibrium [reglas-smc-ict §2.3] · T07 ---
// Porta el "dealing range" de LuxAlgo basado en trailing extremes (type
// trailingExtremes :181, updateTrailingExtremes :709-713, drawPremiumDiscountZones
// :755-761; v5->v6). El rango operativo vigente [bottom, top] se ANCLA al ultimo swing
// high/low confirmado (f_resetTrailing*, cf. LuxAlgo getCurrentStructure :430-454, solo
// escala SWING — no interno) y luego SE EXPANDE vela a vela con el precio
// (f_updateTrailing, max(high)/min(low)) -> el rango captura extension mas alla del
// ultimo swing sin esperar otra confirmacion. eq = punto medio (50%).
// DECISION DISENO T07 (opcion A, ver docs/decisiones-pd-rango.md): el rango = trailing
// extremes de LuxAlgo, NO "ultimo strong high/low por BOS/CHoCH" (opcion B). Motivo:
// paridad directa con la unica referencia externa permitida + portabilidad limpia a
// MQL5 (estado plano, sin depender del historial de eventos estructurales).
// Premium/Discount es una ZONA (localizacion), no un evento -> su expansion EN VIVO es
// aceptable y replica a LuxAlgo (PINE-PLAN §4.4: las zonas se extienden en vivo, los
// eventos solo se confirman al cierre). Para el scoring, el snapshot
// (chartState.pdHigh/pdLow) se actualiza en barstate.isconfirmed -> determinista.
// NB paridad: f_updateTrailing inicializa explicitamente desde na (rango = min/max de
// la historia hasta el 1.er swing, luego se ancla); LuxAlgo deja na por la propagacion
// math.max(x,na)=na. Desviacion intencional, determinista y mas facil de portar a MQL5
// (golden tests, ADR-002); irrelevante en la historia validada (no en la barra 1).
type SMC_Trailing
    float top        = na
    float bottom     = na
    int   topTime    = na
    int   bottomTime = na
    int   barIdx     = na
    int   barTime    = na

// f_resetTrailingHigh/Low: ancla un extremo del rango al swing recien confirmado
// (nivel + barra). barIdx/barTime = ancla izquierda para el dibujo de las zonas.
f_resetTrailingHigh(SMC_Trailing tr, float price, int barIdx, int barTime) =>
    tr.top     := price
    tr.topTime := barTime
    tr.barIdx  := barIdx
    tr.barTime := barTime

f_resetTrailingLow(SMC_Trailing tr, float price, int barIdx, int barTime) =>
    tr.bottom     := price
    tr.bottomTime := barTime
    tr.barIdx     := barIdx
    tr.barTime    := barTime

// f_updateTrailing: expande el rango con el precio de la barra (cf. LuxAlgo
// updateTrailingExtremes). top = max(high desde el ultimo reset); bottom = min(low).
// Llamar en barstate.isconfirmed para un snapshot determinista. Devuelve el tr mutado.
f_updateTrailing(SMC_Trailing tr, float h, float l, int t) =>
    if na(tr.top) or h > tr.top
        tr.top     := h
        tr.topTime := t
    if na(tr.bottom) or l < tr.bottom
        tr.bottom     := l
        tr.bottomTime := t
    tr

// f_premiumDiscount: clasifica la posicion de 'price' en el rango [bottom, top].
// Devuelve [zona, pct]: pct = (price-bottom)/(top-bottom) en 0..1 (0=bottom/discount
// extremo, 1=top/premium extremo); zona ∈ {PD_PREMIUM, PD_DISCOUNT, PD_EQUILIBRIUM}.
// La banda equilibrium [eqLo, eqHi] (default 0.45-0.55, §2.3) tiene PRIORIDAD: dentro
// de ella -> EQUILIBRIUM (confluencia #31, resta peso por falta de ventaja). Fuera:
// pct>0.5 premium (favorece short), pct<0.5 discount (favorece long); el corte real
// premium/discount es el 50% (§2.3), la banda solo neutraliza el centro. Rango invalido
// (na o top<=bottom) -> [na, na]. Pura -> golden tests MQL5 directos (ADR-002).
f_premiumDiscount(float price, float top, float bottom, float eqLo, float eqHi) =>
    int   zone = na
    float pct  = na
    if not na(top) and not na(bottom) and top > bottom
        pct  := (price - bottom) / (top - bottom)
        zone := pct >= eqLo and pct <= eqHi ? PD_EQUILIBRIUM : pct > 0.5 ? PD_PREMIUM : PD_DISCOUNT
    [zone, pct]

// --- Gradient Levels: grading del rango [reglas-smc-ict §5.16] · T41 ---
// f_computeGradientLevels: generaliza f_premiumDiscount (§2.3) de 2 zonas a un grid de N
// puntos. Dado [bottom, top] (top>bottom), devuelve [levels, isQuadrant]: quadrants
// {0,0.25,0.5,0.75,1} SIEMPRE + eighths {0.125,0.375,0.625,0.875} si includeEighths.
// levels en orden ascendente (fraccion -> precio). PURA -> golden test MQL5 directo
// (ADR-002). NO dibuja, NO lee series globales. Rango invalido (top<=bottom) -> arrays vacios.
f_computeGradientLevels(float top, float bottom, bool includeEighths) =>
    array<float> levels     = array.new<float>()
    array<bool>  isQuadrant = array.new<bool>()
    if not na(top) and not na(bottom) and top > bottom
        float span = top - bottom
        for i = 0 to 8
            bool q = i % 2 == 0
            if q or includeEighths
                array.push(levels, bottom + (i / 8.0) * span)
                array.push(isQuadrant, q)
    [levels, isQuadrant]

// f_gradientZone: clasifica 'price' contra un grid ya calculado. Devuelve [idxMasCercano,
// distEnATR]: indice del nivel mas cercano en 'levels' y |price-level|/atr. PURA.
// Grid vacio o atr invalido -> [na, na].
f_gradientZone(float price, array<float> levels, float atr) =>
    int   idx  = na
    float dist = na
    int n = array.size(levels)
    if n > 0 and not na(price) and not na(atr) and atr > 0
        float best = na
        for i = 0 to n - 1
            float d = math.abs(price - array.get(levels, i))
            if na(best) or d < best
                best := d
                idx  := i
        dist := best / atr
    [idx, dist]

// f_nearGradientLevel: test booleano "price toca/esta sobre un gradient level". 'tol' en
// PRECIO (el consumidor pasa gradTol*ATR14). Consumido por T42 (confluencia) y T43
// (FVG-valido). PURA. Grid vacio -> false.
f_nearGradientLevel(float price, array<float> levels, float tol) =>
    bool near = false
    int n = array.size(levels)
    if n > 0 and not na(price) and not na(tol)
        for i = 0 to n - 1
            if math.abs(price - array.get(levels, i)) <= tol
                near := true
                break
    near

// f_bodyRespectsLevel: desempate cuerpos-vs-nivel (§5.16). Cuenta de las velas recientes
// (recentOpens/recentCloses, misma escala) cuantas tienen el CUERPO recostado sobre el
// grid: min(open,close) Y max(open,close) ambos dentro de 'tol' de algun nivel. El grid
// candidato con mayor conteo gana. 'tol' en PRECIO. PURA (arrays por parametro, no
// request.security). Velas o grid vacios -> 0.
f_bodyRespectsLevel(array<float> recentOpens, array<float> recentCloses, array<float> levels, float tol) =>
    int count = 0
    int nb = math.min(array.size(recentOpens), array.size(recentCloses))
    int nl = array.size(levels)
    if nb > 0 and nl > 0 and not na(tol)
        for b = 0 to nb - 1
            float bodyLo = math.min(array.get(recentOpens, b), array.get(recentCloses, b))
            float bodyHi = math.max(array.get(recentOpens, b), array.get(recentCloses, b))
            bool loNear = false
            bool hiNear = false
            for i = 0 to nl - 1
                float lv = array.get(levels, i)
                if math.abs(bodyLo - lv) <= tol
                    loNear := true
                if math.abs(bodyHi - lv) <= tol
                    hiNear := true
            if loNear and hiNear
                count += 1
    count

// f_gradientConfluenceBonus: T42 (#52) — multiplicador exponencial de confluencia sobre
// quadrant (regla §5.17, ADR-013). NO suma al score: se aplica como factor (1+bonus) sobre
// scoreDir_raw en Fase 2 (F2-T01). Forma creciente saturante: (gradMultMax-1)*(1-e^(-k*n));
// n=0 -> 0 (neutro), n->inf -> gradMultMax-1 (tope). gradMultMax y k = calibracion Fase 3
// (ADR-002). PURA -> golden test MQL5 directo. n<=0 o params invalidos -> 0.
f_gradientConfluenceBonus(int nSobreQuadrant, float gradMultMax, float k) =>
    float bonus = 0.0
    if nSobreQuadrant > 0 and gradMultMax > 1.0 and k > 0
        bonus := (gradMultMax - 1.0) * (1.0 - math.exp(-k * nSobreQuadrant))
    bonus

// f_selectGradientSource: politica de rango-fuente (regla §5.16). P1 (dealing range) es la
// fuente por defecto; P2 (suspension diario) la desafia SOLO cuando P1 es "stale" (swing
// origen a mas de gradStaleBars velas) y entonces gana el desempate cuerpos-vs-nivel
// (f_bodyRespectsLevel: mas cuerpos recostados sobre su grid). P3 (opening gaps) NO se
// selecciona aqui: corre en paralelo en el consumidor (alimenta T43). Recibe los niveles YA
// calculados de cada candidato (levels1/levels2) para no recomputar ni destructurar. Devuelve
// [top, bottom, srcKind] del ganador; el consumidor ya tiene sus niveles. PURA -> golden test.
f_selectGradientSource(float top1, float bottom1, array<float> levels1, float top2, float bottom2, array<float> levels2, bool p1Stale, array<float> recentOpens, array<float> recentCloses, float tol) =>
    bool  v1 = not na(top1) and not na(bottom1) and top1 > bottom1
    bool  v2 = not na(top2) and not na(bottom2) and top2 > bottom2
    float rt = na
    float rb = na
    int   rk = GRAD_SRC_PD
    if v1 and v2
        bool useP2 = false
        if p1Stale
            int c1 = f_bodyRespectsLevel(recentOpens, recentCloses, levels1, tol)
            int c2 = f_bodyRespectsLevel(recentOpens, recentCloses, levels2, tol)
            useP2 := c2 > c1
        rt := useP2 ? top2 : top1
        rb := useP2 ? bottom2 : bottom1
        rk := useP2 ? GRAD_SRC_SUSPENSION : GRAD_SRC_PD
    else if v1
        rt := top1
        rb := bottom1
        rk := GRAD_SRC_PD
    else if v2
        rt := top2
        rb := bottom2
        rk := GRAD_SRC_SUSPENSION
    [rt, rb, rk]

// --- Equal Highs / Equal Lows (EQH/EQL) [reglas-smc-ict §2.4] · T08 ---
// f_detectEQHL: porta el EQH/EQL de LuxAlgo (drawEqualHighLow :384-402,
// getCurrentStructure equalHighLow=true :419-448; v5->v6). Dos swings consecutivos del
// MISMO tipo a nivel "igual" = doble techo/suelo -> liquidez acumulada (BSL arriba en
// EQH, SSL abajo en EQL) que el precio tiende a barrer: alimenta los pools (§Liquidez) y
// es objetivo de sweep. Escala PROPIA eqlLength=3 (= equalHighsLowsLengthInput), separada
// del swingLen=5 estructural y del pdSwingLen=50 (cf. P/D T07) -> mas sensible. Funcion
// pura: compara el pivote recien confirmado (curPrice) con el PREVIO del mismo tipo
// (prevPrice); iguales si |cur-prev| <= threshold (= eqThreshold*ATR14, §2.4). NB: LuxAlgo
// usa "<" estricto; la doc usa "<=" -> desviacion trivial, la doc manda. Devuelve un
// SMC_Event en el nivel actual (kind KIND_EQH/KIND_EQL; dir informativa EQH=BEAR /
// EQL=BULL, cf. color bearish/bullish de LuxAlgo) o na si no son iguales o falta el
// previo. El anclaje izquierdo del dibujo (barra del pivote previo) lo aporta el consumidor
// (estado plano). Pura (sin series) -> golden tests MQL5 directos (ADR-002).
f_detectEQHL(bool isHigh, float curPrice, int curBarIdx, int curBarTime, float prevPrice, float threshold) =>
    SMC_Event ev = na
    if not na(prevPrice) and not na(curPrice) and math.abs(curPrice - prevPrice) <= threshold
        ev := SMC_Event.new(curPrice, isHigh ? DIR_BEAR : DIR_BULL, curBarIdx, curBarTime, "", isHigh ? KIND_EQH : KIND_EQL)
    ev

// --- Pools de liquidez BSL/SSL [reglas-smc-ict §3.1] · T09 ---
// f_buildPools: construye el set de pools de liquidez clusterizando EQH/EQL (§2.4, kind
// KIND_EQH/KIND_EQL en 'eqhl') + swings NO barridos (HH/LH para BSL, HL/LL para SSL) cuyos
// niveles caen dentro de tolPrice (= poolTol*ATR14) entre si. Cada EQH/EQL aporta 2 touches
// (es un doble techo/suelo YA confirmado por T08); cada swing no barrido aporta 1. Un cluster
// con touches >= minTouches forma un SMC_Pool: level = promedio de los niveles miembros,
// dir = +1 BSL (lado highs, iman al alza) / -1 SSL (lado lows), touches = suma de aportes,
// barTime = el del miembro mas reciente, swept = false (el barrido lo marca el sweep, T10).
// Lado highs y lado lows por separado (no se mezclan). NO hay algoritmo LuxAlgo que portar:
// LuxAlgo carece de pools -> diseño propio §3.1. Funcion PURA (reconstruye el set completo
// desde sus entradas, sin estado ni series) -> determinista y portable a golden tests MQL5
// (ADR-002). Clustering voraz sobre niveles ordenados, agrupando mientras |nivel-media| <=
// tolPrice (media corrida del cluster). El consumidor la llama en barra confirmada cuando hay
// un cambio relevante y vuelca el resultado en SMC_pools.
f_buildPools(array<SMC_Event> eqhl, array<SMC_Swing> swings, float tolPrice, int minTouches) =>
    array<SMC_Pool> pools = array.new<SMC_Pool>()
    for side = 0 to 1
        bool isHigh = side == 0
        array<float> lv = array.new<float>()
        array<int>   wt = array.new<int>()
        array<int>   tm = array.new<int>()
        if array.size(eqhl) > 0
            for j = 0 to array.size(eqhl) - 1
                SMC_Event e = array.get(eqhl, j)
                if (isHigh and e.kind == KIND_EQH) or (not isHigh and e.kind == KIND_EQL)
                    array.push(lv, e.price)
                    array.push(wt, 2)
                    array.push(tm, e.barTime)
        if array.size(swings) > 0
            for m = 0 to array.size(swings) - 1
                SMC_Swing s = array.get(swings, m)
                bool hi = s.kind == KIND_HH or s.kind == KIND_LH
                bool lo = s.kind == KIND_HL or s.kind == KIND_LL
                if not s.swept and ((isHigh and hi) or (not isHigh and lo))
                    array.push(lv, s.price)
                    array.push(wt, 1)
                    array.push(tm, s.barTime)
        int n = array.size(lv)
        if n > 0
            array<int> ord = array.sort_indices(lv, order.ascending)
            float clSum   = na
            int   clCount = 0
            int   clTouch = 0
            int   clTime  = 0
            for k = 0 to n - 1
                int   idx   = array.get(ord, k)
                float level = array.get(lv, idx)
                int   w     = array.get(wt, idx)
                int   t     = array.get(tm, idx)
                float clMean = clCount > 0 ? clSum / clCount : na
                if clCount > 0 and math.abs(level - clMean) <= tolPrice
                    clSum   := clSum + level
                    clCount := clCount + 1
                    clTouch := clTouch + w
                    clTime  := t > clTime ? t : clTime
                else
                    if clCount > 0 and clTouch >= minTouches
                        array.push(pools, SMC_Pool.new(clSum / clCount, isHigh ? DIR_BULL : DIR_BEAR, clTouch, clTime, false, ""))
                    clSum   := level
                    clCount := 1
                    clTouch := w
                    clTime  := t
            if clCount > 0 and clTouch >= minTouches
                array.push(pools, SMC_Pool.new(clSum / clCount, isHigh ? DIR_BULL : DIR_BEAR, clTouch, clTime, false, ""))
    pools

// --- Ciclo de vida de pools: upsert + barrido (sweep) [reglas-smc-ict §3.1/§3.2] · T09b/T10 ---
// [P1] Modelo PERSISTENTE: en vez de reconstruir el set cada vela (f_buildPools borra el estado
// swept), el consumidor MANTIENE SMC_pools entre velas y lo actualiza incremental. Asi se recuerda
// que pool ya fue barrido (deja de ser iman) -> el grafico no se satura con niveles muertos.
// f_buildPools se conserva (export / golden test / seeding) pero YA NO se llama en deteccion.
// Todas estas funciones son PURAS (reciben precios/arrays por parametro, no dibujan, no leen series
// ni request.security) -> portables a golden tests MQL5 (ADR-002).

// f_upsertPool: alta/merge INCREMENTAL de UN candidato (swing o EQH/EQL) contra el set VIVO. Busca
// un pool vivo (swept==false) del mismo lado (isHigh -> BSL, else SSL) con |level-p.level| <=
// tolPrice; si existe -> merge (touches += weight, level = media ponderada por touches, barTime/
// barIdx = el mas reciente); si no -> alta nueva (touches = weight). La visibilidad (touches >=
// minTouches) la decide el dibujo/scoring, NO esta funcion: un swing suelto (weight 1) queda
// almacenado para poder fusionar con otro cercano y promover a pool.
f_upsertPool(array<SMC_Pool> pools, bool isHigh, float level, int weight, int barTime, int barIdx, float tolPrice) =>
    int poolDir  = isHigh ? DIR_BULL : DIR_BEAR
    int matchIdx = -1
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            SMC_Pool p = array.get(pools, i)
            if not p.swept and p.dir == poolDir and math.abs(level - p.level) <= tolPrice
                matchIdx := i
                break
    if matchIdx >= 0
        SMC_Pool p = array.get(pools, matchIdx)
        int newTouches = p.touches + weight
        p.level   := (p.level * p.touches + level * weight) / newTouches
        p.touches := newTouches
        if barTime > p.barTime
            p.barTime := barTime
            p.barIdx  := barIdx
    else
        array.push(pools, SMC_Pool.new(level, poolDir, weight, barTime, false, "", barIdx, na, na))
    pools

// f_markPoolsSwept: marca como barrido (swept) cada pool VIVO cuyo nivel cruza la barra actual.
// BSL (dir==DIR_BULL) barrido si barHigh >= level; SSL (dir==DIR_BEAR) si barLow <= level. El pool
// deja de ser iman (la liquidez se tomo, sea trampa o ruptura) y registra sweptBarTime/Idx para el
// marcador (Propuesta B). La CLASIFICACION trampa-vs-ruptura la hace f_detectSweep. Llamar SOLO en
// barstate.isconfirmed (anti-repaint; §3.2 evalua al cierre).
f_markPoolsSwept(array<SMC_Pool> pools, float barHigh, float barLow, int barTime, int barIdx) =>
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            SMC_Pool p = array.get(pools, i)
            if not p.swept
                bool crossed = (p.dir == DIR_BULL and barHigh >= p.level) or (p.dir == DIR_BEAR and barLow <= p.level)
                if crossed
                    p.swept        := true
                    p.sweptBarTime := barTime
                    p.sweptBarIdx  := barIdx
    pools

// f_detectSweep [T10, §3.2]: clasifica TRAMPA sobre los pools barridos EN esta barra (sweptBarIdx ==
// barIdx). Un pool es sweep (no ruptura) si el close vuelve dentro del rango: BSL barrido con close <
// level -> trampa bajista (sesgo DIR_BEAR); SSL barrido con close > level -> trampa alcista
// (DIR_BULL). El sesgo es CONTRARIO al lado barrido (§3.2, confluencia #10). Si el close queda mas
// alla del nivel = ruptura/false breakout (§3.7), NO es sweep. Devuelve el SMC_Event KIND_SWEEP del
// pool mas relevante (mayor touches), o na. PURA. minTouches exige que el pool barrido sea un pool
// real (>= toques), no un nivel de un solo swing.
f_detectSweep(array<SMC_Pool> pools, float barClose, int barIdx, int barTime, int minTouches) =>
    SMC_Event ev = na
    int bestTouches = 0
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            SMC_Pool p = array.get(pools, i)
            if p.swept and p.sweptBarIdx == barIdx and p.touches >= minTouches
                bool trapBSL = p.dir == DIR_BULL and barClose < p.level
                bool trapSSL = p.dir == DIR_BEAR and barClose > p.level
                if (trapBSL or trapSSL) and p.touches > bestTouches
                    bestTouches := p.touches
                    ev := SMC_Event.new(p.level, trapBSL ? DIR_BEAR : DIR_BULL, barIdx, barTime, "", KIND_SWEEP)
    ev

// f_prunePools: acota el set persistente a maxN. Borra primero el pool BARRIDO mas antiguo
// (historial/marcador, prescindible); si no hay barridos, el del frente (mas antiguo). Mantiene los
// imanes vivos el mayor tiempo posible. PURA (muta y devuelve el array).
f_prunePools(array<SMC_Pool> pools, int maxN) =>
    while array.size(pools) > maxN
        int rm = -1
        for i = 0 to array.size(pools) - 1
            if array.get(pools, i).swept
                rm := i
                break
        array.remove(pools, rm >= 0 ? rm : 0)
    pools

// --- Kill Zones / sesiones [reglas-smc-ict §3.4 · ADR-001] · T11 ---
// Confluencia ponderada, NO filtro duro: identifica que sesion institucional esta activa y si es la
// PRIMERA MITAD (requerido por el Judas §3.5). f_killZone es PURA: la membresia de sesion en hora
// LOCAL con DST automatico (time(timeframe.period, session, tz), P-25) se extrae en el consumidor y se
// pasa como booleanos — mismo patron que el buffer del OB — para portabilidad MQL5 (golden tests,
// ADR-002). Perfiles: SP_LONDON_NY = London+NY · SP_ASIA = London+NY+Tokyo · SP_NONE = sin sesiones
// (cripto / indices 24h). Prioridad en solapamiento London > NY > Tokyo. Devuelve [int session, bool
// firstHalf]. NO bloquea la entrada: la sesion activa solo aporta peso a la confluencia #34 (calibrado
// por simbolo, Fase 3/5); con SP_NONE la confluencia #34 no aporta.
f_killZone(bool inLondon, bool inLondonFirst, bool inNY, bool inNYFirst, bool inTokyo, bool inTokyoFirst, int sessionProfile) =>
    int  session   = KZ_NONE
    bool firstHalf = false
    if sessionProfile != SP_NONE
        if inLondon
            session   := KZ_LONDON
            firstHalf := inLondonFirst
        else if inNY
            session   := KZ_NY
            firstHalf := inNYFirst
        else if sessionProfile == SP_ASIA and inTokyo
            session   := KZ_TOKYO
            firstHalf := inTokyoFirst
    [session, firstHalf]

// --- Macros intradia [reglas-smc-ict §5.14] · T39 ---
// f_macroActive: extiende §3.4 -> ¿la hora local NY (en minutos del dia) cae en una ventana MACRO
// canonica ICT? Refina #34 (Kill Zone) con sub-ventana de mayor peso; NO es confluencia nueva ni bloquea
// (ADR-001: el reloj informa). Ventanas (minutos NY): London 02:33-03:00 / 04:03-04:30 (kind 1); NY AM
// 08:50-09:10 / 09:50-10:10 / 10:50-11:10 / 11:50-12:10 (kind 2); NY PM 13:10-13:40 / 15:15-15:45 (kind
// 4); NY Lunch 12:00-13:00 (kind 3, baja actividad = filtro). Prioridad AM/PM sobre Lunch en el solape.
// PURA (aritmetica sobre nyMin que el consumidor calcula con hour/minute en tz NY). Devuelve [activa, kind].
f_macroActive(int nyMin) =>
    bool active = false
    int  kind   = 0
    if (nyMin >= 153 and nyMin < 180) or (nyMin >= 243 and nyMin < 270)
        active := true
        kind   := 1
    else if (nyMin >= 530 and nyMin < 550) or (nyMin >= 590 and nyMin < 610) or (nyMin >= 650 and nyMin < 670) or (nyMin >= 710 and nyMin < 730)
        active := true
        kind   := 2
    else if (nyMin >= 790 and nyMin < 820) or (nyMin >= 915 and nyMin < 945)
        active := true
        kind   := 4
    else if nyMin >= 720 and nyMin < 780
        active := true
        kind   := 3
    [active, kind]

// --- RTH vs ETH [reglas-smc-ict §5.15] · T40 ---
// f_sessionType: Regular Trading Hours vs Extended. Por PERFIL de simbolo (ADR-001): si enabled y la
// hora NY (nyMin) cae en la ventana [rthStartMin, rthEndMin) -> RTH (mayor calidad); fuera -> ETH. Si NO
// enabled (FX 24h) -> siempre RTH (no hay distincion -> el perfil neutraliza la modulacion). Modula #34
// (calidad), no es confluencia nueva. PURA. Devuelve bool isRTH.
f_sessionType(int nyMin, int rthStartMin, int rthEndMin, bool enabled) =>
    enabled ? (nyMin >= rthStartMin and nyMin < rthEndMin) : true

// f_nearestN [Sprint 1.4 · T13b · ADR-009]: recolecta los capN objetos de un array<SMC_Zone>
// del 'kind' dado, NO mitigados (state < ZS_MITIGATED), MAS CERCANOS al precio px, y los anexa a
// los arrays-candidato compartidos (ck/ct/cb/cd/cdist). Generaliza f_pNearZone (que devuelve 1)
// -> al CORE porque la usa el transporte MTF (paridad MQL5 SMC_MTF.mqh). Pura.
f_nearestN(array<SMC_Zone> src, int kind, float px, int capN, array<int> ck, array<float> ct, array<float> cb, array<int> cd, array<float> cdist, array<int> ctA, array<int> ctB) =>
    if capN > 0 and array.size(src) > 0
        mi = array.new<int>()
        md = array.new<float>()
        for i = 0 to array.size(src) - 1
            SMC_Zone z = array.get(src, i)
            if z.kind == kind and z.state < ZS_MITIGATED
                array.push(mi, i)
                array.push(md, math.abs((z.top + z.bottom) / 2.0 - px))
        if array.size(mi) > 0
            ord = array.sort_indices(md, order.ascending)
            cnt = math.min(capN, array.size(ord))
            for j = 0 to cnt - 1
                int sidx = array.get(ord, j)
                SMC_Zone z = array.get(src, array.get(mi, sidx))
                array.push(ck, kind)
                array.push(ct, z.top)
                array.push(cb, z.bottom)
                array.push(cd, z.dir)
                array.push(cdist, array.get(md, sidx))
                array.push(ctA, z.barTime)
                array.push(ctB, int(na))
    array.size(ck)

// f_nearestNPools [T13b · ADR-009]: idem para pools NO barridos; nivel como top==bottom,
// etiquetados KIND_POOL (dir = BSL/SSL). Pura.
f_nearestNPools(array<SMC_Pool> src, float px, int capN, array<int> ck, array<float> ct, array<float> cb, array<int> cd, array<float> cdist, array<int> ctA, array<int> ctB) =>
    if capN > 0 and array.size(src) > 0
        mi = array.new<int>()
        md = array.new<float>()
        for i = 0 to array.size(src) - 1
            SMC_Pool p = array.get(src, i)
            if not p.swept
                array.push(mi, i)
                array.push(md, math.abs(p.level - px))
        if array.size(mi) > 0
            ord = array.sort_indices(md, order.ascending)
            cnt = math.min(capN, array.size(ord))
            for j = 0 to cnt - 1
                int sidx = array.get(ord, j)
                SMC_Pool p = array.get(src, array.get(mi, sidx))
                array.push(ck, KIND_POOL)
                array.push(ct, p.level)
                array.push(cb, p.level)
                array.push(cd, p.dir)
                array.push(cdist, array.get(md, sidx))
                array.push(ctA, p.barTime)
                array.push(ctB, int(na))
    array.size(ck)

// f_pushMTFEvent [T13c · ADR-010]: acumula en arrays paralelos var (kind/level/dir/tA/tB) los
// conceptos-TRAMO o -MARCA del HTF (BOS/CHoCH origen->ruptura, EQH/EQL toque->toque, Sweep en su
// barra) para poder seleccionarlos por cercania despues. FIFO acotado a MAX_EVENTS. Pura.
f_pushMTFEvent(array<int> sk, array<float> sl, array<int> sd, array<int> sta, array<int> stb, int k, float lvl, int d, int ta, int tb) =>
    array.push(sk, k)
    array.push(sl, lvl)
    array.push(sd, d)
    array.push(sta, ta)
    array.push(stb, tb)
    if array.size(sk) > MAX_EVENTS
        array.shift(sk)
        array.shift(sl)
        array.shift(sd)
        array.shift(sta)
        array.shift(stb)
    array.size(sk)

// f_nearestNEvents [T13c · ADR-010]: idem f_nearestN pero sobre los arrays paralelos de
// f_pushMTFEvent. Filtra por 'kind', toma los capN mas cercanos al precio px y los anexa a los
// arrays-candidato anclando tA/tB reales (tramo BOS/CHoCH/EQ o marca sweep). top==bottom==level
// (nivel unico). Pura -> paridad MQL5 SMC_MTF.mqh.
f_nearestNEvents(array<int> sk, array<float> sl, array<int> sd, array<int> sta, array<int> stb, int kind, float px, int capN, array<int> ck, array<float> ct, array<float> cb, array<int> cd, array<float> cdist, array<int> ctA, array<int> ctB) =>
    if capN > 0 and array.size(sk) > 0
        mi = array.new<int>()
        md = array.new<float>()
        for i = 0 to array.size(sk) - 1
            if array.get(sk, i) == kind
                array.push(mi, i)
                array.push(md, math.abs(array.get(sl, i) - px))
        if array.size(mi) > 0
            ord = array.sort_indices(md, order.ascending)
            cnt = math.min(capN, array.size(ord))
            for j = 0 to cnt - 1
                int sidx = array.get(ord, j)
                int src  = array.get(mi, sidx)
                array.push(ck, kind)
                array.push(ct, array.get(sl, src))
                array.push(cb, array.get(sl, src))
                array.push(cd, array.get(sd, src))
                array.push(cdist, array.get(md, sidx))
                array.push(ctA, array.get(sta, src))
                array.push(ctB, array.get(stb, src))
    array.size(ck)

// f_computeTFState [Sprint 1.4 · T13a escalares + T13b mapa rico · ESQUELETO-P3 §2.4 · ADR-009]:
// encapsula la cadena de deteccion de un TF en UNA funcion con estado var INTERNO (R-P3-1, spike
// S039 OK), evaluable via request.security(sym, tf, f_computeTFState(...), lookahead_off) SIN
// contaminar el chart. Corre estructura swing (bias + BOS/CHoCH), MSS, P/D, EMAs/ATR (escalares,
// T13a) Y ADEMAS OB/FVG/pools/sweep (T13b) con arrays var internos, y emite los K objetos activos
// MAS CERCANOS AL PRECIO como BUFFER GENERICO ETIQUETADO por kind (ADR-009: ranura =
// [kind,top,bottom,dir]; kind=0 vacia; pool/sweep top==bottom==level; cap por concepto 0-10,
// 0=off). Devuelve TUPLE PLANO (R-P3-2: security no transporta UDT/array) -> paridad MQL5 Fase 4
// (SMC_MTF.mqh). Anti-repaint (#1): eventos en barstate.isconfirmed; el llamador usa lookahead_off.
// EXTENSIBILIDAD (ADR-009): conceptos nuevos (Sprint 1.5/1.6) se anaden haciendo push a zonesTf/
// poolsTf con su kind + una llamada f_nearestN; el contrato del tuple no cambia. 2a llamada/TF
// (mas cupo) preparada en el consumidor, no activada aun.
// CONTRATO DEL TUPLE (orden exacto, replicar en MQL5):
//   [ bias, bosP,bosD,bosT, chochP,chochD,chochT, mssP,mssD,mssT, pdHigh,pdLow,pdMid,
//     ema20,ema50,ema200, atr14,                 (17 escalares T13a)
//     {kind,top,bottom,dir,tA,tB} x MTF_K ]      (ranuras T13c, ADR-010: 6 campos con anclaje)
// T13c (ADR-010): la ranura crece de 4 a 6 campos -> tA=tiempo barra ORIGEN (left caja / 1er toque
// EQ / inicio tramo BOS-CHoCH / barra del sweep o pool), tB=tiempo FIN (na=extiende al borde; 2o
// toque EQ; barra de ruptura BOS-CHoCH). El consumidor reconstruye la FORMA NATIVA por xloc.bar_time
// (caja OB/FVG, linea tramo EQ/estructura, marca sweep). BOS/CHoCH y EQH/EQL ahora SI se emiten al
// buffer (antes solo escalares/pools). Cap 0-10 por concepto para TODOS (0=off). time epoch-ms cabe
// exacto en float64 -> viaja por security sin perdida.
f_computeTFState(int swingLen, int pdLen, float dispFactor, float bodyPct, int eqlLength, float eqThreshold, float obHighVolFactor, bool obMitClose, float fvgThreshold, float poolTol, int minTouches, int capOB, int capFVG, int capPool, int capSweep, int capEQ, int capBOS, int capCHoCH) =>
    var SMC_TFState   st       = SMC_TFState.new()
    var SMC_Structure structTf = SMC_Structure.new()
    var SMC_Trailing  trailTf  = SMC_Trailing.new()
    var array<SMC_Zone> zonesTf = array.new<SMC_Zone>()
    var array<SMC_Pool> poolsTf = array.new<SMC_Pool>()
    var array<float> obBufHigh = array.new<float>()
    var array<float> obBufLow  = array.new<float>()
    var array<int>   obBufIdx  = array.new<int>()
    var array<int>   obBufTime = array.new<int>()
    var array<float> obBufVol  = array.new<float>()
    var float prevEqHigh   = na
    var float prevEqLow    = na
    var int   prevEqHighTime = na
    var int   prevEqLowTime  = na
    // Buffer paralelo de conceptos-tramo/marca (BOS/CHoCH/EQH/EQL/Sweep) con anclaje tA/tB [T13c]
    var array<int>   evK  = array.new<int>()
    var array<float> evL  = array.new<float>()
    var array<int>   evD  = array.new<int>()
    var array<int>   evTA = array.new<int>()
    var array<int>   evTB = array.new<int>()
    float atr14      = ta.atr(14)
    float volMeasure = ta.atr(200)
    [sh, sl]     = f_detectSwings(swingLen)
    [pdH, pdL]   = f_detectSwings(pdLen)
    [eqPH, eqPL] = f_detectSwings(eqlLength)
    if barstate.isconfirmed and not na(sh)
        f_setStructureHigh(structTf, sh, bar_index - swingLen, time[swingLen])
    if barstate.isconfirmed and not na(sl)
        f_setStructureLow(structTf, sl, bar_index - swingLen, time[swingLen])
    if barstate.isconfirmed and not na(pdH)
        f_resetTrailingHigh(trailTf, pdH, bar_index - pdLen, time[pdLen])
    if barstate.isconfirmed and not na(pdL)
        f_resetTrailingLow(trailTf, pdL, bar_index - pdLen, time[pdLen])
    f_updateTrailing(trailTf, high, low, time)
    if barstate.isconfirmed
        st.pdHigh := trailTf.top
        st.pdLow  := trailTf.bottom
        SMC_Event ev = f_detectStructure(structTf, bar_index, time, true, true)
        f_updateTFState(st, ev)
        if not na(ev) and (ev.kind == KIND_BOS or ev.kind == KIND_CHOCH)
            int origT = ev.dir == DIR_BULL ? structTf.highTime : structTf.lowTime
            f_pushMTFEvent(evK, evL, evD, evTA, evTB, ev.kind, ev.price, ev.dir, origT, ev.barTime)
        SMC_Event evM = f_detectMSS(ev, open, high, low, close, atr14, dispFactor, bodyPct)
        if not na(evM)
            st.lastMSSPrice := evM.price
            st.lastMSSDir   := evM.dir
            st.lastMSSTime  := evM.barTime
        array.push(obBufHigh, high)
        array.push(obBufLow,  low)
        array.push(obBufIdx,  bar_index)
        array.push(obBufTime, time)
        array.push(obBufVol,  volMeasure)
        if array.size(obBufIdx) > MAX_BARBUF
            array.shift(obBufHigh)
            array.shift(obBufLow)
            array.shift(obBufIdx)
            array.shift(obBufTime)
            array.shift(obBufVol)
        if array.size(zonesTf) > 0
            for zi = 0 to array.size(zonesTf) - 1
                f_updateZoneMitigation(array.get(zonesTf, zi), obMitClose)
        if not na(ev)
            int obOrigin = ev.dir == DIR_BULL ? structTf.highBarIdx : structTf.lowBarIdx
            SMC_Zone obZone = f_detectOB(ev, obOrigin, obBufHigh, obBufLow, obBufIdx, obBufTime, obBufVol, obHighVolFactor, KIND_OB)
            if not na(obZone)
                f_pushZone(zonesTf, obZone, MAX_ZONES, close, atr14, st.bias)
        // FVG: barTime = vela MEDIA (time[1] = barIdx-1, el desplazamiento que crea el gap, igual
        // que el dibujo nativo f_drawFVG) -> el transporte MTF ancla la caja exacta vela-a-vela en el
        // LTF sin quedar "corrida" una barra a la derecha (pref. usuario S042). [T13c]
        SMC_Zone fvgZone = f_detectFVG(high, low, high[2], low[2], bar_index, time[1], fvgThreshold * atr14, KIND_FVG)
        if not na(fvgZone)
            f_pushZone(zonesTf, fvgZone, MAX_ZONES, close, atr14, st.bias)
        SMC_Event evEqH = na
        SMC_Event evEqL = na
        if not na(eqPH)
            evEqH := f_detectEQHL(true, eqPH, bar_index - eqlLength, time[eqlLength], prevEqHigh, eqThreshold * atr14)
            if not na(evEqH) and not na(prevEqHighTime)
                f_pushMTFEvent(evK, evL, evD, evTA, evTB, KIND_EQH, evEqH.price, DIR_BULL, prevEqHighTime, evEqH.barTime)
            prevEqHigh     := eqPH
            prevEqHighTime := time[eqlLength]
        if not na(eqPL)
            evEqL := f_detectEQHL(false, eqPL, bar_index - eqlLength, time[eqlLength], prevEqLow, eqThreshold * atr14)
            if not na(evEqL) and not na(prevEqLowTime)
                f_pushMTFEvent(evK, evL, evD, evTA, evTB, KIND_EQL, evEqL.price, DIR_BEAR, prevEqLowTime, evEqL.barTime)
            prevEqLow     := eqPL
            prevEqLowTime := time[eqlLength]
        if not na(sh)
            f_upsertPool(poolsTf, true,  sh, 1, time[swingLen], bar_index - swingLen, poolTol * atr14)
        if not na(sl)
            f_upsertPool(poolsTf, false, sl, 1, time[swingLen], bar_index - swingLen, poolTol * atr14)
        if not na(evEqH)
            f_upsertPool(poolsTf, true,  evEqH.price, 2, evEqH.barTime, evEqH.barIdx, poolTol * atr14)
        if not na(evEqL)
            f_upsertPool(poolsTf, false, evEqL.price, 2, evEqL.barTime, evEqL.barIdx, poolTol * atr14)
        f_markPoolsSwept(poolsTf, high, low, time, bar_index)
        SMC_Event evSweep = f_detectSweep(poolsTf, close, bar_index, time, minTouches)
        if not na(evSweep)
            f_pushMTFEvent(evK, evL, evD, evTA, evTB, KIND_SWEEP, evSweep.price, evSweep.dir, evSweep.barTime, int(na))
        f_prunePools(poolsTf, MAX_POOLS)
    st.pdMid  := na(st.pdHigh) or na(st.pdLow) ? na : (st.pdHigh + st.pdLow) / 2.0
    st.ema20  := ta.ema(close, 20)
    st.ema50  := ta.ema(close, 50)
    st.ema200 := ta.ema(close, 200)
    st.atr14  := atr14
    cKind = array.new<int>()
    cTop  = array.new<float>()
    cBot  = array.new<float>()
    cDir  = array.new<int>()
    cDist = array.new<float>()
    cTA   = array.new<int>()
    cTB   = array.new<int>()
    f_nearestN(zonesTf, KIND_OB,  close, capOB,   cKind, cTop, cBot, cDir, cDist, cTA, cTB)
    f_nearestN(zonesTf, KIND_FVG, close, capFVG,  cKind, cTop, cBot, cDir, cDist, cTA, cTB)
    f_nearestNPools(poolsTf,      close, capPool, cKind, cTop, cBot, cDir, cDist, cTA, cTB)
    f_nearestNEvents(evK, evL, evD, evTA, evTB, KIND_BOS,   close, capBOS,   cKind, cTop, cBot, cDir, cDist, cTA, cTB)
    f_nearestNEvents(evK, evL, evD, evTA, evTB, KIND_CHOCH, close, capCHoCH, cKind, cTop, cBot, cDir, cDist, cTA, cTB)
    f_nearestNEvents(evK, evL, evD, evTA, evTB, KIND_EQH,   close, capEQ,    cKind, cTop, cBot, cDir, cDist, cTA, cTB)
    f_nearestNEvents(evK, evL, evD, evTA, evTB, KIND_EQL,   close, capEQ,    cKind, cTop, cBot, cDir, cDist, cTA, cTB)
    f_nearestNEvents(evK, evL, evD, evTA, evTB, KIND_SWEEP, close, capSweep, cKind, cTop, cBot, cDir, cDist, cTA, cTB)
    mk  = array.new<int>()
    mt  = array.new<float>()
    mb  = array.new<float>()
    mdr = array.new<int>()
    mta = array.new<int>()
    mtb = array.new<int>()
    ordG = array.size(cDist) > 0 ? array.sort_indices(cDist, order.ascending) : array.new<int>()
    for s = 0 to MTF_K - 1
        if s < array.size(ordG)
            int gi = array.get(ordG, s)
            array.push(mk,  array.get(cKind, gi))
            array.push(mt,  array.get(cTop,  gi))
            array.push(mb,  array.get(cBot,  gi))
            array.push(mdr, array.get(cDir,  gi))
            array.push(mta, array.get(cTA,   gi))
            array.push(mtb, array.get(cTB,   gi))
        else
            array.push(mk, 0)
            array.push(mt, na)
            array.push(mb, na)
            array.push(mdr, 0)
            array.push(mta, int(na))
            array.push(mtb, int(na))
    [ st.bias, st.lastBOSPrice, st.lastBOSDir, st.lastBOSTime, st.lastCHoCHPrice, st.lastCHoCHDir, st.lastCHoCHTime, st.lastMSSPrice, st.lastMSSDir, st.lastMSSTime, st.pdHigh, st.pdLow, st.pdMid, st.ema20, st.ema50, st.ema200, st.atr14,
      array.get(mk, 0), array.get(mt, 0), array.get(mb, 0), array.get(mdr, 0), array.get(mta, 0), array.get(mtb, 0),
      array.get(mk, 1), array.get(mt, 1), array.get(mb, 1), array.get(mdr, 1), array.get(mta, 1), array.get(mtb, 1),
      array.get(mk, 2), array.get(mt, 2), array.get(mb, 2), array.get(mdr, 2), array.get(mta, 2), array.get(mtb, 2),
      array.get(mk, 3), array.get(mt, 3), array.get(mb, 3), array.get(mdr, 3), array.get(mta, 3), array.get(mtb, 3),
      array.get(mk, 4), array.get(mt, 4), array.get(mb, 4), array.get(mdr, 4), array.get(mta, 4), array.get(mtb, 4),
      array.get(mk, 5), array.get(mt, 5), array.get(mb, 5), array.get(mdr, 5), array.get(mta, 5), array.get(mtb, 5),
      array.get(mk, 6), array.get(mt, 6), array.get(mb, 6), array.get(mdr, 6), array.get(mta, 6), array.get(mtb, 6),
      array.get(mk, 7), array.get(mt, 7), array.get(mb, 7), array.get(mdr, 7), array.get(mta, 7), array.get(mtb, 7),
      array.get(mk, 8), array.get(mt, 8), array.get(mb, 8), array.get(mdr, 8), array.get(mta, 8), array.get(mtb, 8),
      array.get(mk, 9), array.get(mt, 9), array.get(mb, 9), array.get(mdr, 9), array.get(mta, 9), array.get(mtb, 9),
      array.get(mk, 10), array.get(mt, 10), array.get(mb, 10), array.get(mdr, 10), array.get(mta, 10), array.get(mtb, 10),
      array.get(mk, 11), array.get(mt, 11), array.get(mb, 11), array.get(mdr, 11), array.get(mta, 11), array.get(mtb, 11) ]

// === DETECCIÓN TF PROPIO ===
// Estado global del chart actual. Arrays con prefijo SMC_ [PINE-PLAN §2].
// Las detecciones que los pueblan llegan en T02+ (swings, BOS/CHoCH, ...).
var array<SMC_Swing> SMC_swings = array.new<SMC_Swing>()
var array<SMC_Event> SMC_events = array.new<SMC_Event>()
var array<SMC_Zone>  SMC_zones  = array.new<SMC_Zone>()
var array<SMC_Pool>  SMC_pools  = array.new<SMC_Pool>()
var array<SMC_Event> SMC_sweeps = array.new<SMC_Event>()

// Snapshot consolidado del bias del TF propio [T04]. Declarado AQUI (antes de los swings) para que
// su bias -var, persistente- alimente la fuerza de swings/eventos ya en esta vela (usa el valor
// consolidado de la vela previa; se re-consolida mas abajo con f_updateTFState). Detalle §1.3/§1.4.
var SMC_TFState chartState = SMC_TFState.new()

// --- Insumos de fuerza (strength) para los sitios de creacion [Eje2 · ADR-014 · HANDOFF §5.2] ---
// evRangeAtr/evBodyPct = rango y cuerpo de la vela CONFIRMADA actual (la mayoria de eventos se
// detecta en su propia vela; sAtr14 propio porque el atr14 global se declara mas abajo). sweptRecently
// = hubo un sweep en las ultimas velas ANTES de esta (SMC_sweeps aun trae el estado hasta la vela
// previa, se repuebla mas abajo) -> "sweep previo" (§5.2). biasDir se pasa como chartState.bias en
// cada sitio (valor vigente en ese punto). Insumos baratos, al cierre (anti-repaint).
float sAtr14        = ta.atr(14)
float evRangeAtr    = sAtr14 > 0 ? (high - low) / sAtr14 : 0.0
float evBodyPct     = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0.0
bool  sweptRecently = false
if array.size(SMC_sweeps) > 0
    SMC_Event lastSw = array.get(SMC_sweeps, array.size(SMC_sweeps) - 1)
    sweptRecently := (bar_index - lastSw.barIdx) <= 3

// --- Swings [T02] ---
// pivothigh/low(len,len) recien confirma len velas tras el pivote -> el guard
// barstate.isconfirmed evita actuar sobre la vela en formacion (anti-repaint
// [§1.1]). El swing pertenece a la vela t = bar_index - len; clasificar ANTES de
// hacer push (f_classifySwing lee el swing previo del mismo tipo ya almacenado).
[swingHigh, swingLow] = f_detectSwings(i_swingLen)
newSwingHigh = barstate.isconfirmed and not na(swingHigh)
newSwingLow  = barstate.isconfirmed and not na(swingLow)
int swingHighKind = na
int swingLowKind  = na
if newSwingHigh
    swingHighKind := f_classifySwing(true, swingHigh, SMC_swings)
    f_pushSwing(SMC_swings, SMC_Swing.new(swingHigh, bar_index - i_swingLen, time[i_swingLen], swingHighKind, false), MAX_SWINGS, chartState.bias)
if newSwingLow
    swingLowKind := f_classifySwing(false, swingLow, SMC_swings)
    f_pushSwing(SMC_swings, SMC_Swing.new(swingLow, bar_index - i_swingLen, time[i_swingLen], swingLowKind, false), MAX_SWINGS, chartState.bias)

// --- Estructura BOS/CHoCH [T03] ---
// Estado estructural persistente por escala. structSwing = bias mayor (headline);
// structInternal = estructura fina (internalLen), no voltea el bias swing [§1.4].
var SMC_Structure structSwing    = SMC_Structure.new()
var SMC_Structure structInternal = SMC_Structure.new()

// Estructura DOMINANTE (escala 50) [T07B]. Capa aditiva: reutiliza el CORE escala-
// agnostico (SMC_Structure / f_setStructure* / f_detectStructure) sin tocarlo. Sus
// eventos van a un array dedicado (NO al SMC_events compartido que consume el OB).
// NO alimenta f_updateTFState -> el bias headline (swingLen=5) no cambia [§1.3/§1.4].
var SMC_Structure structMajor = SMC_Structure.new()
var array<SMC_Event> SMC_eventsMajor = array.new<SMC_Event>()

// (chartState declarado mas arriba, antes de los swings, para alimentar la fuerza [Eje2]. Se
// alimenta SOLO del evento de escala swing -structSwing- -> el bias mayor; lo que el MTF exporta
// [Sprint 1.4] y el scoring lee [Sprint 2.1]. structInternal queda fuera, no voltea el bias, §1.4.)

// Dealing range Premium/Discount [T07]: trailing extremes anclados al ultimo swing de
// ESCALA P/D (opcion A, ver docs/decisiones-pd-rango.md). Estado del consumidor (el TYPE
// vive en CORE). Swing P/D dedicado (i_pdSwingLen, default 50 = swing de LuxAlgo), NO el
// swingLen=5 estructural: el dealing range de LuxAlgo se basa en
// getCurrentStructure(swingsLengthInput=50) (ref :782) -> rango DOMINANTE, no local.
var SMC_Trailing trailing = SMC_Trailing.new()
[pdSwingHigh, pdSwingLow] = f_detectSwings(i_pdSwingLen)

// Pivotes internos (los swing ya se calcularon arriba). Mismo guard anti-repaint.
[internalHigh, internalLow] = f_detectSwings(i_internalLen)
newInternalHigh = barstate.isconfirmed and not na(internalHigh)
newInternalLow  = barstate.isconfirmed and not na(internalLow)

// Fijar el swing recien confirmado como nivel estructural vigente (anclado a t).
if newSwingHigh
    f_setStructureHigh(structSwing, swingHigh, bar_index - i_swingLen, time[i_swingLen])
if newSwingLow
    f_setStructureLow(structSwing, swingLow, bar_index - i_swingLen, time[i_swingLen])
if newInternalHigh
    f_setStructureHigh(structInternal, internalHigh, bar_index - i_internalLen, time[i_internalLen])
if newInternalLow
    f_setStructureLow(structInternal, internalLow, bar_index - i_internalLen, time[i_internalLen])

// --- Estructura dominante: pivotes escala 50 [T07B] ---
// Mismo guard anti-repaint que swing/interno. Latencia inherente = i_majorLen velas
// (~2 dias en H1): el pivote pertenece a la vela t = bar_index - i_majorLen y NO existe
// hasta su cierre [§1.1]. Es correcto, no un bug.
[majorHigh, majorLow] = f_detectSwings(i_majorLen)
newMajorHigh = barstate.isconfirmed and not na(majorHigh)
newMajorLow  = barstate.isconfirmed and not na(majorLow)
if newMajorHigh
    f_setStructureHigh(structMajor, majorHigh, bar_index - i_majorLen, time[i_majorLen])
if newMajorLow
    f_setStructureLow(structMajor, majorLow, bar_index - i_majorLen, time[i_majorLen])

// --- Premium/Discount: dealing range [T07] ---
// Reanclaje a los swings de ESCALA P/D (i_pdSwingLen, default 50 = swing de LuxAlgo; ref
// :782 getCurrentStructure(swingsLengthInput,false)). Solo en swings confirmados (anti-
// repaint); el swing P/D pertenece a la vela t = bar_index - i_pdSwingLen. Luego
// f_updateTrailing expande el rango CADA barra (incl. la viva) como LuxAlgo
// (updateTrailingExtremes :770-771, no gated) -> el precio vivo nunca excede el rango y el
// pct queda en 0..1. Orden reset->expand. El snapshot para el scoring se congela SOLO en
// barstate.isconfirmed (determinista, no repinta historia).
if barstate.isconfirmed and not na(pdSwingHigh)
    f_resetTrailingHigh(trailing, pdSwingHigh, bar_index - i_pdSwingLen, time[i_pdSwingLen])
if barstate.isconfirmed and not na(pdSwingLow)
    f_resetTrailingLow(trailing, pdSwingLow, bar_index - i_pdSwingLen, time[i_pdSwingLen])
f_updateTrailing(trailing, high, low, time)
if barstate.isconfirmed
    chartState.pdHigh := trailing.top
    chartState.pdLow  := trailing.bottom

// Ruptura estructural solo al cierre confirmado (anti-repaint [D-PINE-03]). El
// interno usa guard de nivel-distinto: no duplica la senal cuando su pivote coincide
// con el del swing (cf. LuxAlgo extraCondition).
SMC_Event evStructSwing = na
SMC_Event evStructInt   = na
if barstate.isconfirmed
    evStructSwing := f_detectStructure(structSwing, bar_index, time, true, true)
    bool okIntHigh = structInternal.highLevel != structSwing.highLevel
    bool okIntLow  = structInternal.lowLevel  != structSwing.lowLevel
    evStructInt   := f_detectStructure(structInternal, bar_index, time, okIntHigh, okIntLow)
    if not na(evStructSwing)
        f_pushEvent(SMC_events, evStructSwing, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
    if not na(evStructInt)
        f_pushEvent(SMC_events, evStructInt, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
    // Consolidar el bias del TF tras la posible ruptura swing de esta barra [T04].
    f_updateTFState(chartState, evStructSwing)

// Ruptura estructural de escala DOMINANTE (50) [T07B]. Es la mayor -> guards true,true
// (no necesita dedupe contra una escala superior). Eventos a array dedicado; NO se
// llama f_updateTFState con este evento: el bias headline NO cambia (ver §1.3/§1.4).
SMC_Event evStructMajor = na
if barstate.isconfirmed
    evStructMajor := f_detectStructure(structMajor, bar_index, time, true, true)
    if not na(evStructMajor)
        f_pushEvent(SMC_eventsMajor, evStructMajor, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)

// --- Order Blocks [T05] ---
// Buffers ROLLING de barras (high/low/barIdx/time/ATR200) poblados cada barra
// confirmada y acotados a MAX_BARBUF: f_detectOB recorre estos arrays (acceso
// estatico, sin referencia historica dinamica de series) -> runtime-safe (evita
// RE10045) y portable a golden tests MQL5 (ADR-002). En barra confirmada: empuja la
// barra al buffer, actualiza la mitigacion de las zonas vivas y, si hubo ruptura
// SWING, detecta el OB de la pierna (origen = pivote roto, misma ancla que el dibujo
// de estructura). Escala SWING (confluencia #19 OB chart); el OB interno reusa
// f_detectOB con structInternal y queda para su tarea.
var array<float> obBufHigh = array.new<float>()
var array<float> obBufLow  = array.new<float>()
var array<int>   obBufIdx  = array.new<int>()
var array<int>   obBufTime = array.new<int>()
var array<float> obBufVol  = array.new<float>()
float volMeasure = ta.atr(200)
float atr14      = ta.atr(14)
var int lastSweepBar = na  // ultima barra con sweep -> gate del Mitigation Block (§2.8: "sin sweep previo")
// --- Gradient Levels: rango-fuente P1/P2/P3 + seleccion + ghost [reglas-smc-ict §5.16 · T41] ---
// P1 = dealing range (trailing). P2 = suspension diario = highest/lowest del ULTIMO dia D1
// CONFIRMADO (request.security high[1]/low[1], lookahead_off -> anti-repaint, TF-agnostico).
// P3 = gaps de apertura measurables (mini-rango [close_prev, open]) que corren en PARALELO
// (alimentan T43; NO reemplazan a P1/P2). f_selectGradientSource elige el grid PRIMARIO (P1 por
// defecto; P2 si P1 stale y gana el desempate cuerpos-vs-nivel). Ghost: al RE-FIJARSE el
// rango-fuente primario (nuevo swing dominante / nueva frontera de dia) se archiva el grid previo
// hasta i_gradPersistDays. Bloque de wiring de consumidor (usa inputs/request.security) -> FUERA
// del LIBRARY CORE byte-identico.
[gradSusTop, gradSusBot] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_off)
bool gradNewDay = ta.change(time("D")) != 0
var array<SMC_GradientGrid> SMC_gapGrids   = array.new<SMC_GradientGrid>()
var array<SMC_GradientGrid> SMC_gradGhosts = array.new<SMC_GradientGrid>()
var float gradSelTop  = na
var float gradSelBot  = na
var int   gradSelKind = GRAD_SRC_PD
var array<float> gradSelLevels = array.new<float>()
var array<bool>  gradSelQuad   = array.new<bool>()
var int   gradPrevKind   = na
var int   gradPrevPdAnch = na
if barstate.isconfirmed
    // P3: nuevo gap de apertura measurable -> nuevo mini-grid en paralelo (cuota i_gradPersistDays)
    if gradNewDay
        bool gpMeas = not na(atr14) and math.abs(open - close[1]) >= i_gapMin * atr14
        if gpMeas
            float gpTop = math.max(close[1], open)
            float gpBot = math.min(close[1], open)
            [gpLv, gpQ] = f_computeGradientLevels(gpTop, gpBot, i_gradEighths)
            if array.size(gpLv) > 0
                array.push(SMC_gapGrids, SMC_GradientGrid.new(gpTop, gpBot, GRAD_SRC_OPENGAP, time, bar_index, gpLv, gpQ, 0))
                while array.size(SMC_gapGrids) > i_gradPersistDays
                    array.shift(SMC_gapGrids)
    // Seleccion del grid PRIMARIO (P1 vs P2, §5.16)
    bool gradP1Stale = not na(trailing.barIdx) and (bar_index - trailing.barIdx) > i_gradStaleBars
    [gradP1Lv, gradP1Q] = f_computeGradientLevels(trailing.top, trailing.bottom, i_gradEighths)
    [gradP2Lv, gradP2Q] = f_computeGradientLevels(gradSusTop, gradSusBot, i_gradEighths)
    array<float> gradRecentO = array.new<float>()
    array<float> gradRecentC = array.new<float>()
    for gb = 1 to i_gradBodyLookback
        array.push(gradRecentO, open[gb])
        array.push(gradRecentC, close[gb])
    [gradSTop, gradSBot, gradSKind] = f_selectGradientSource(trailing.top, trailing.bottom, gradP1Lv, gradSusTop, gradSusBot, gradP2Lv, gradP1Stale, gradRecentO, gradRecentC, i_gradTol * atr14)
    // Ghost: archivar el grid PRIMARIO previo SOLO cuando el rango-fuente se RE-FIJA (no en cada
    // expansion intrabar del trailing) -> cambio de fuente, nuevo swing dominante (barIdx) o nuevo dia.
    bool gradSrcRefixed = (not na(gradSelTop)) and ((gradSKind != gradPrevKind) or (gradSKind == GRAD_SRC_PD and trailing.barIdx != gradPrevPdAnch) or (gradSKind == GRAD_SRC_SUSPENSION and gradNewDay))
    if gradSrcRefixed and i_gradPersistDays > 0 and array.size(gradSelLevels) > 0
        array.push(SMC_gradGhosts, SMC_GradientGrid.new(gradSelTop, gradSelBot, gradSelKind, na, na, array.copy(gradSelLevels), array.copy(gradSelQuad), 1))
        while array.size(SMC_gradGhosts) > i_gradPersistDays
            array.shift(SMC_gradGhosts)
    // Winner sin recomputar (reusa los levels/quad de la fuente elegida)
    bool gradSelIsP2 = gradSKind == GRAD_SRC_SUSPENSION
    gradSelTop    := gradSTop
    gradSelBot    := gradSBot
    gradSelKind   := gradSKind
    gradSelLevels := gradSelIsP2 ? gradP2Lv : gradP1Lv
    gradSelQuad   := gradSelIsP2 ? gradP2Q  : gradP1Q
    gradPrevKind   := gradSKind
    gradPrevPdAnch := trailing.barIdx
if barstate.isconfirmed
    array.push(obBufHigh, high)
    array.push(obBufLow,  low)
    array.push(obBufIdx,  bar_index)
    array.push(obBufTime, time)
    array.push(obBufVol,  volMeasure)
    if array.size(obBufIdx) > MAX_BARBUF
        array.shift(obBufHigh)
        array.shift(obBufLow)
        array.shift(obBufIdx)
        array.shift(obBufTime)
        array.shift(obBufVol)
    // Mitigacion comun + Breaker [T19] + IFVG [T27]: tras mutar cada zona, si un OB ACABA de invalidarse
    // se engendra un KIND_BREAKER (§2.6) y si un FVG ACABA de invalidarse un KIND_IFVG (§5.2), ambos de
    // polaridad invertida. Se recolectan aparte y se empujan DESPUES del loop (no mutar SMC_zones mientras
    // se itera). Entran a SMC_zones y desde la barra siguiente los gestiona la misma maquina (retest).
    array<SMC_Zone> SMC_newBreakers = array.new<SMC_Zone>()
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone zMit = array.get(SMC_zones, i)
            int prevState = zMit.state
            f_updateZoneMitigation(zMit, i_obMitClose)
            SMC_Zone bz = f_detectBreaker(zMit, prevState)
            if not na(bz)
                array.push(SMC_newBreakers, bz)
            SMC_Zone iz = f_detectIFVG(zMit, prevState)
            if not na(iz)
                array.push(SMC_newBreakers, iz)
    if array.size(SMC_newBreakers) > 0
        for i = 0 to array.size(SMC_newBreakers) - 1
            f_pushZone(SMC_zones, array.get(SMC_newBreakers, i), MAX_ZONES, close, atr14, chartState.bias)
    if not na(evStructSwing)
        int obOrigin = evStructSwing.dir == DIR_BULL ? structSwing.highBarIdx : structSwing.lowBarIdx
        SMC_Zone obZone = f_detectOB(evStructSwing, obOrigin, obBufHigh, obBufLow, obBufIdx, obBufTime, obBufVol, i_obHighVolFactor, KIND_OB)
        if not na(obZone)
            // Propulsion [T34 · §5.8]: ¿anidado en un OB vivo previo mismo-sentido? -> OB de continuacion.
            obZone.propulsion := f_isPropulsion(obZone, SMC_zones, i_propOverlap)
            f_pushZone(SMC_zones, obZone, MAX_ZONES, close, atr14, chartState.bias)
    // --- Mitigation Block [§2.8 #24] ---
    // Ultima vela contraria antes de un impulso que rompe estructura INTERNA, SIN sweep previo de un pool
    // (si hubo sweep -> es contexto de breaker/OB, no mitigation block, §2.8). Zona = high/low de esa vela:
    // reusa f_detectOB sobre el evento INTERNO (mismo "ultima vela contraria"). Gate: ningun sweep entre el
    // origen y la ruptura (lastSweepBar < mbOrigin). KIND_MITIGATION; ciclo de vida via la maquina comun.
    if not na(evStructInt)
        int mbOrigin = evStructInt.dir == DIR_BULL ? structInternal.highBarIdx : structInternal.lowBarIdx
        bool mbNoSweep = na(lastSweepBar) or lastSweepBar < mbOrigin
        if mbNoSweep
            SMC_Zone mbZone = f_detectOB(evStructInt, mbOrigin, obBufHigh, obBufLow, obBufIdx, obBufTime, obBufVol, i_obHighVolFactor, KIND_MITIGATION)
            if not na(mbZone)
                f_pushZone(SMC_zones, mbZone, MAX_ZONES, close, atr14, chartState.bias)
    // --- Vacuum Block [T33 · §5.7] ---
    // Gap grande de apertura (open vs close previo) -> zona-vacio iman de retorno. Se empuja DESPUES de la
    // mitigacion comun (como OB/FVG) -> no se mitiga en su barra; en FX solo aparece en frontera (fin de semana).
    SMC_Zone vacZone = f_detectVacuumBlock(open, close[1], atr14, i_vacuumFactor, bar_index, time)
    if not na(vacZone)
        f_pushZone(SMC_zones, vacZone, MAX_ZONES, close, atr14, chartState.bias)
    // --- Fair Value Gaps [T06] ---
    // FVG de 3 velas sobre el TF propio (sin request.security: el MTF es T13). Se
    // confirma al cierre de la 3.a vela (este barstate.isconfirmed); offsets fijos
    // [0]/[2] = referencia estatica RE10045-safe. Umbral fixed 0.25*ATR14 (default
    // validado). Se empuja a SMC_zones DESPUES de la mitigacion comun (loop arriba)
    // -> no se mitiga en su barra de creacion; en barras siguientes el loop la gestiona
    // como al OB (misma maquina f_updateZoneMitigation, §2.2).
    SMC_Zone fvgZone = f_detectFVG(high, low, high[2], low[2], bar_index, time, i_fvgThreshold * atr14, KIND_FVG)
    if not na(fvgZone)
        // True FVG [T26 · §5.1]: la VELA MEDIA del trio (bar[1], la que crea el gap) es displacement
        // (§4.1) -> FVG de alta calidad institucional. Reusa f_detectDisplacement (requireContraction
        // false: §5.1 no exige contraccion). Es un FLAG sobre el FVG (refina #18/#20), no zona nueva ->
        // sigue en la familia FVG (mitigacion/dibujo); eleva su peso en el scoring (Fase 3).
        SMC_Event fvgMidDisp = f_detectDisplacement(open[1], high[1], low[1], close[1], atr14, i_dispFactor, i_dispBodyPct, false, false, bar_index - 1, time[1])
        fvgZone.trueFvg := not na(fvgMidDisp)
        // FVG valido [T43 · §5.18]: el CE del FVG toca un gradient level. Fuente = grid PRIMARIO
        // seleccionado por f_selectGradientSource (P1/P2, §5.16) O cualquier mini-grid P3 de gap de
        // apertura reciente (corren en PARALELO). Flag gradedFvg (refina #18/#20, no zona nueva) ->
        // eleva strength en la capa de discriminacion. Anti-repaint: mismo instante de confirmacion.
        float fvgCE = (fvgZone.top + fvgZone.bottom) / 2.0
        bool fvgGraded = array.size(gradSelLevels) > 0 and f_nearGradientLevel(fvgCE, gradSelLevels, i_gradTol * atr14)
        if not fvgGraded and array.size(SMC_gapGrids) > 0
            for gi = 0 to array.size(SMC_gapGrids) - 1
                if f_nearGradientLevel(fvgCE, array.get(SMC_gapGrids, gi).levels, i_gradTol * atr14)
                    fvgGraded := true
                    break
        fvgZone.gradedFvg := fvgGraded
        // BPR [T28 · §5.3]: ¿este FVG nuevo se solapa con un FVG vivo de dir OPUESTO reciente? -> zona de
        // precio balanceado. Se busca ANTES de empujar el FVG (compara contra los previos en SMC_zones).
        SMC_Zone bprZone = f_detectBPR(fvgZone, SMC_zones, close, bar_index, i_bprWindow, i_bprMinOverlap * atr14)
        f_pushZone(SMC_zones, fvgZone, MAX_ZONES, close, atr14, chartState.bias)
        if not na(bprZone)
            f_pushZone(SMC_zones, bprZone, MAX_ZONES, close, atr14, chartState.bias)
    // --- OTE / Golden Pocket [T22 · §2.5] ---
    // Sobre un BOS confirmado: expira las zonas GP/OTE de la pierna anterior (la regla redibuja con cada
    // impulso) y crea las de la pierna nueva (rango estructural [lowLevel, highLevel]). El ciclo de vida
    // (entrada/invalidacion) lo gestiona el loop de mitigacion comun de arriba (KIND_GP/KIND_OTE son
    // SMC_Zone). Origen del box = barra del extremo de ORIGEN de la pierna. r1/r2/r3 = 50/61.8/79%.
    if not na(evStructSwing) and evStructSwing.kind == KIND_BOS
        if array.size(SMC_zones) > 0
            for zi = 0 to array.size(SMC_zones) - 1
                SMC_Zone zo = array.get(SMC_zones, zi)
                if zo.kind == KIND_GP or zo.kind == KIND_OTE
                    f_expireOTE(zo, true)
        int oteOrigin = evStructSwing.dir == DIR_BULL ? structSwing.lowBarIdx : structSwing.highBarIdx
        [gpZone, oteZone] = f_detectOTE(evStructSwing, structSwing.highLevel, structSwing.lowLevel, oteOrigin, time, i_oteR1, i_oteR2, i_oteR3)
        if not na(gpZone)
            f_pushZone(SMC_zones, gpZone, MAX_ZONES, close, atr14, chartState.bias)
        if not na(oteZone)
            f_pushZone(SMC_zones, oteZone, MAX_ZONES, close, atr14, chartState.bias)

// --- MSS — Market Structure Shift [T12] ---
// Califica el CHoCH swing de ESTA barra como MSS si su vela de ruptura (la barra
// confirmada actual) es displacement (§1.5). Capa ADITIVA: el CHoCH ya esta en
// SMC_events; el MSS va a su array dedicado SMC_eventsMSS (confluencia #5, mayor peso),
// igual que la estructura dominante usa SMC_eventsMajor [T07B]. atr14 ya disponible
// arriba. La vela de ruptura es la barra confirmada actual -> OHLC = open/high/low/close.
var array<SMC_Event> SMC_eventsMSS = array.new<SMC_Event>()
SMC_Event evMSS = na
if barstate.isconfirmed and not na(evStructSwing)
    evMSS := f_detectMSS(evStructSwing, open, high, low, close, atr14, i_mssDispFactor, i_mssBodyPct)
    if not na(evMSS)
        f_pushEvent(SMC_eventsMSS, evMSS, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)

// --- Displacement [§4.1] · T16 ---
// La vela impulsiva (capa de CONTEXTO/ICT, confluencia "displacement previo"). Detecta sobre
// la barra confirmada actual (OHLC = vela recien cerrada). priorContraction = las 3 velas
// previas con rango < ATR14 (expansion-tras-compresion §4.1); se precomputa aqui porque el
// core es puro. atr14 ya disponible arriba. Va a su array dedicado SMC_displacements.
var array<SMC_Event> SMC_displacements = array.new<SMC_Event>()
SMC_Event evDisp = na
if barstate.isconfirmed
    bool priorContraction = (high[1] - low[1]) < atr14 and (high[2] - low[2]) < atr14 and (high[3] - low[3]) < atr14
    evDisp := f_detectDisplacement(open, high, low, close, atr14, i_dispFactor, i_dispBodyPct, i_dispContraction, priorContraction, bar_index, time)
    if not na(evDisp)
        f_pushEvent(SMC_displacements, evDisp, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)

// --- IDM — Inducement [§3.6] · T17 ---
// Grab de liquidez INTERNA (internalLen): el nivel senuelo es la estructura interna vigente
// (structInternal, fijada arriba). En barra confirmada, si la mecha barre el internal low/high
// y el cierre vuelve -> IDM (confluencia #33). Distinto del sweep de pools (escala swing/EQHL).
var array<SMC_Event> SMC_idm = array.new<SMC_Event>()
SMC_Event evIDM = na
if barstate.isconfirmed
    evIDM := f_detectIDM(structInternal.lowLevel, structInternal.highLevel, low, high, close, bar_index, time)
    if not na(evIDM)
        f_pushEvent(SMC_idm, evIDM, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)

// --- Immediate Rebalance [§5.4] · T29 ---
// Vela de impulso (bar[1]) rebalanceada por la vela actual (bar[0], close) sin dejar ineficiencia.
// Evento puntual a su array dedicado SMC_ir (contraste con FVG; matiza el contexto de eficiencia).
var array<SMC_Event> SMC_ir = array.new<SMC_Event>()
SMC_Event evIR = na
if barstate.isconfirmed
    evIR := f_detectImmediateRebalance(open[1], high[1], low[1], close[1], close, atr14, i_irFactor, i_irBodyPct, bar_index - 1, time[1])
    if not na(evIR)
        f_pushEvent(SMC_ir, evIR, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)

// --- Volume Imbalance [§5.5] · T31 ---
// Micro-imbalance entre cuerpos con solape de mechas. ARRAY DEDICADO SMC_vi (NO SMC_zones): es muy
// frecuente y saturaria el cap de zonas reales (OB/FVG). Ciclo de vida propio (misma f_updateZoneMitigation)
// para no crear su propia maquina. Detecta la vela actual vs la previa; se empuja tras mitigar las vivas.
var array<SMC_Zone> SMC_vi = array.new<SMC_Zone>()
if barstate.isconfirmed
    if array.size(SMC_vi) > 0
        for i = 0 to array.size(SMC_vi) - 1
            f_updateZoneMitigation(array.get(SMC_vi, i), i_obMitClose)
    SMC_Zone viZone = f_detectVolumeImbalance(open, high, low, close[1], high[1], low[1], atr14, i_viThreshold, bar_index, time)
    if not na(viZone)
        f_pushZone(SMC_vi, viZone, MAX_ZONES, close, atr14, chartState.bias)

// --- Gaps de apertura NWOG/NDOG/NYMO + Breakaway [§5.10] · T30 ---
// Fronteras con ta.change CADA barra (fuera del if): semana / dia broker / medianoche NY. Niveles ancla
// PERSISTENTES (S/R, refina #36 como serie). Breakaway (KIND_BAG, #45) = gap measurable con continuacion.
bool ogNewWeek = ta.change(time("W")) != 0
bool ogNewDay  = ta.change(time("D")) != 0
bool ogNYMid   = ta.change(dayofmonth(time, "America/New_York")) != 0
var float ndogLvl = na
var int   ndogT   = na
var float nwogLvl = na
var int   nwogT   = na
var float nymoLvl = na
var int   nymoT   = na
var array<SMC_Event> SMC_bag = array.new<SMC_Event>()
if barstate.isconfirmed
    if ogNewWeek
        nwogLvl := open
        nwogT   := time
    if ogNewDay
        ndogLvl := open
        ndogT   := time
        [ogMeas, ogDir] = f_classifyOpenGap(open, close[1], atr14, i_gapMin)
        if ogMeas and ((ogDir == DIR_BULL and close > open) or (ogDir == DIR_BEAR and close < open))
            f_pushEvent(SMC_bag, SMC_Event.new(open, ogDir, bar_index, time, "", KIND_BAG), MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
    if ogNYMid
        nymoLvl := open
        nymoT   := time

// --- CISD — Change in State of Delivery [§5.6] · T32 ---
// Mantiene el RUN de delivery vigente (var): direccion, longitud y origen (open de su 1a vela). Cada
// barra confirmada: primero CHEQUEA el CISD contra el run formado hasta la barra previa, luego ACTUALIZA
// el run con la barra actual (mismo color -> extiende; cambio/doji -> nuevo run). Va a SMC_cisd.
var int   cisdRunDir  = 0
var int   cisdRunLen  = 0
var float cisdRunOrig = na
var array<SMC_Event> SMC_cisd = array.new<SMC_Event>()
SMC_Event evCISD = na
if barstate.isconfirmed
    evCISD := f_detectCISD(open, close, cisdRunDir, cisdRunOrig, cisdRunLen, i_cisdMinRun, bar_index, time)
    if not na(evCISD)
        f_pushEvent(SMC_cisd, evCISD, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
    int cisdCol = close > open ? 1 : close < open ? -1 : 0
    if cisdCol == cisdRunDir and cisdCol != 0
        cisdRunLen += 1
    else
        cisdRunDir  := cisdCol
        cisdRunLen  := cisdCol == 0 ? 0 : 1
        cisdRunOrig := cisdCol == 0 ? na : open

// --- IPR — Imbalanced Price Range [§5.9] · T35 ---
// Contexto de bias: rango con FVG apilados del mismo lado. currentIpr = el IPR vigente (recomputado cada
// barra, NO entra a SMC_zones: es contexto, no zona operable). Se registra en SMC_ipr solo al FORMARSE
// uno nuevo (transicion de dir) para dejar traza de que/donde paso, sin spamear.
var array<SMC_Zone> SMC_ipr = array.new<SMC_Zone>()
var SMC_Zone currentIpr = na
var int lastIprDir = 0
if barstate.isconfirmed
    currentIpr := f_detectIPR(SMC_zones, bar_index, time, i_iprWindow, i_iprMinGaps)
    int curIprDir = na(currentIpr) ? 0 : currentIpr.dir
    if curIprDir != 0 and curIprDir != lastIprDir
        f_pushZone(SMC_ipr, currentIpr, MAX_ZONES, close, atr14, chartState.bias)
    lastIprDir := curIprDir

// --- Inside Day [§5.12] · T37 ---
// Snapshot D1 via request.security (lookahead_off, anti-repaint): high/low del dia recien cerrado (1) y
// el previo (2). Se evalua en la TRANSICION de dia (reusa ogNewDay del T30). Compresion -> SMC_insideDays.
[id_h1, id_l1, id_h2, id_l2] = request.security(syminfo.tickerid, "D", [high[1], low[1], high[2], low[2]], lookahead = barmerge.lookahead_off)
var array<SMC_Event> SMC_insideDays = array.new<SMC_Event>()
SMC_Event evInsideDay = na
if barstate.isconfirmed and ogNewDay
    evInsideDay := f_detectInsideDay(id_h1, id_l1, id_h2, id_l2, bar_index, time)
    if not na(evInsideDay)
        f_pushEvent(SMC_insideDays, evInsideDay, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)

// --- Impulsive / Corrective [§4.4] · T25 ---
// Clasificador de estado: al confirmar una ruptura, MARCA y ALMACENA el tramo. legHadDisp recuerda si
// hubo displacement (§4.1) desde la ultima ruptura (incluida la vela de ruptura, por eso se actualiza
// antes de clasificar); f_classifyLeg decide IMPULSIVO (displacement + BOS alineado al sesgo dominante
// o MSS) vs CORRECTIVO. Se ancla en la ruptura (dir/price del MSS si lo hay, si no del evento swing).
// Va a SMC_legs -> queda registrado QUE paso y DONDE (pref. usuario) para analisis/scoring Fase 3.
var array<SMC_Event> SMC_legs = array.new<SMC_Event>()
var bool legHadDisp = false
SMC_Event evLeg = na
if barstate.isconfirmed
    if not na(evDisp)
        legHadDisp := true
    if not na(evStructSwing) or not na(evMSS)
        int legKind = f_classifyLeg(evStructSwing, evMSS, structMajor.bias, legHadDisp)
        if legKind != 0
            int   legDir = not na(evMSS) ? evMSS.dir : evStructSwing.dir
            float legPx  = not na(evMSS) ? evMSS.price : evStructSwing.price
            evLeg := SMC_Event.new(legPx, legDir, bar_index, time, "", legKind)
            f_pushEvent(SMC_legs, evLeg, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
        legHadDisp := false

// --- Equal Highs / Equal Lows [T08] ---
// Pivotes a escala PROPIA eqlLength (3) — no los swing(5)/major(50). Mismo guard anti-
// repaint (el pivote pertenece a t = bar_index - i_eqlLength). El pivote recien confirmado
// se compara con el PREVIO del mismo tipo (estado plano prevEq*); si son "iguales"
// (f_detectEQHL) -> SMC_Event EQH/EQL al array dedicado SMC_eqhl (futuros pools §Liquidez,
// NO el SMC_events del OB). El previo SIEMPRE avanza al actual (cf. LuxAlgo, que actualiza
// equalHigh/equalLow tras el check, iguales o no). Las vars eq?Prev* guardan el ancla del
// pivote previo ANTES de sobrescribir, para que el dibujo trace el segmento (Visual).
var array<SMC_Event> SMC_eqhl = array.new<SMC_Event>()
var float prevEqHigh     = na
var int   prevEqHighIdx  = na
var int   prevEqHighTime = na
var float prevEqLow      = na
var int   prevEqLowIdx   = na
var int   prevEqLowTime  = na
[eqPivotHigh, eqPivotLow] = f_detectSwings(i_eqlLength)
float eqHPrevLvl  = na
int   eqHPrevIdx  = na
int   eqHPrevTime = na
float eqLPrevLvl  = na
int   eqLPrevIdx  = na
int   eqLPrevTime = na
SMC_Event evEqHigh = na
SMC_Event evEqLow  = na
if barstate.isconfirmed and not na(eqPivotHigh)
    evEqHigh := f_detectEQHL(true, eqPivotHigh, bar_index - i_eqlLength, time[i_eqlLength], prevEqHigh, i_eqThreshold * atr14)
    if not na(evEqHigh)
        eqHPrevLvl  := prevEqHigh
        eqHPrevIdx  := prevEqHighIdx
        eqHPrevTime := prevEqHighTime
        f_pushEvent(SMC_eqhl, evEqHigh, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
    prevEqHigh     := eqPivotHigh
    prevEqHighIdx  := bar_index - i_eqlLength
    prevEqHighTime := time[i_eqlLength]
if barstate.isconfirmed and not na(eqPivotLow)
    evEqLow := f_detectEQHL(false, eqPivotLow, bar_index - i_eqlLength, time[i_eqlLength], prevEqLow, i_eqThreshold * atr14)
    if not na(evEqLow)
        eqLPrevLvl  := prevEqLow
        eqLPrevIdx  := prevEqLowIdx
        eqLPrevTime := prevEqLowTime
        f_pushEvent(SMC_eqhl, evEqLow, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
    prevEqLow     := eqPivotLow
    prevEqLowIdx  := bar_index - i_eqlLength
    prevEqLowTime := time[i_eqlLength]

// --- Pools de liquidez: persistentes con ciclo de vida [T09b] + sweep [T10] ---
// [P1 · T09b] Modelo PERSISTENTE (reemplaza el rebuild stateless de T09). En barstate.isconfirmed:
//   1) UPSERT de cada nivel recien confirmado contra el set vivo (EQH/EQL weight 2, swing weight 1).
//   2) MARK: f_markPoolsSwept marca barridos los pools vivos cruzados por high/low de la barra.
//   3) SWEEP [T10]: f_detectSweep clasifica trampa (perfora + cierra de vuelta) -> SMC_sweeps.
//   4) PRUNE: acota a MAX_POOLS (borra el historial barrido mas antiguo primero).
// NO array.clear: el set persiste entre velas y recuerda swept (anti-saturacion). El orden
// upsert -> mark respeta el esqueleto §3.A.3. tolPrice = i_poolTol*ATR14 (§3.1). El nº bruto de
// pools (alto con los defaults 0.1/2) es ruido de calibracion Fase 3 (anti-overfitting, ADR-002).
// evSweepAlert: espejo de scope externo del sweep de esta barra (evSweep es local al if) para
// que la seccion ALERTAS [T15] pueda engancharlo via alertcondition() sin tocar el detector.
SMC_Event evSweepAlert = na
if barstate.isconfirmed
    if newSwingHigh
        f_upsertPool(SMC_pools, true,  swingHigh, 1, time[i_swingLen], bar_index - i_swingLen, i_poolTol * atr14)
    if newSwingLow
        f_upsertPool(SMC_pools, false, swingLow,  1, time[i_swingLen], bar_index - i_swingLen, i_poolTol * atr14)
    if not na(evEqHigh)
        f_upsertPool(SMC_pools, true,  evEqHigh.price, 2, evEqHigh.barTime, evEqHigh.barIdx, i_poolTol * atr14)
    if not na(evEqLow)
        f_upsertPool(SMC_pools, false, evEqLow.price,  2, evEqLow.barTime, evEqLow.barIdx, i_poolTol * atr14)
    f_markPoolsSwept(SMC_pools, high, low, time, bar_index)
    SMC_Event evSweep = f_detectSweep(SMC_pools, close, bar_index, time, i_minTouches)
    if not na(evSweep)
        // Refina el sweep en su subtipo Spring/Raid [T24 · §3.7]. rangeLow = discount del dealing range.
        evSweep.kind := f_classifySweep(SMC_pools, evSweep.price, evSweep.dir, evSweep.barIdx, chartState.pdLow, i_raidTouches, i_poolTol * atr14)
        f_pushEvent(SMC_sweeps, evSweep, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
        evSweepAlert := evSweep
        lastSweepBar := bar_index
    f_prunePools(SMC_pools, MAX_POOLS)
    // Fuerza de pools: son DINAMICOS (touches/swept/cercania cambian por f_upsertPool) -> se refresca
    // al cierre en vez de fijarse en un unico sitio de creacion [Eje2 · ADR-014 · §5.5]. Guard de tamano
    // por la semantica de 'for 0 to size-1' de Pine (con size=0 iteraria a -1).
    if array.size(SMC_pools) > 0
        for pi = 0 to array.size(SMC_pools) - 1
            SMC_Pool pStr = array.get(SMC_pools, pi)
            pStr.strength := f_poolStrength(pStr, close, atr14)

// --- False Breakout [§3.7 #14] · T24 ---
// CIERRE mas alla de un nivel de pool que REVIERTE en <= i_fbBars velas (distinto del sweep, que es solo
// mecha). Pendientes en SMC_fbreaks (var): (1) actualizar -> emitir FB confirmado (dir = reversion, la
// real) o expirar (= breakout real/BOS); (2) registrar roturas FRESCAS por close (la barra previa estaba
// del otro lado del nivel), evitando duplicar un nivel ya pendiente. Anti-repaint: en barstate.isconfirmed.
var array<SMC_FBreak> SMC_fbreaks      = array.new<SMC_FBreak>()
var array<SMC_Event>  SMC_fbreakEvents = array.new<SMC_Event>()
if barstate.isconfirmed
    if array.size(SMC_fbreaks) > 0
        for i = array.size(SMC_fbreaks) - 1 to 0
            SMC_FBreak fb = array.get(SMC_fbreaks, i)
            int fbRes = f_detectFalseBreak(fb, close, bar_index, i_fbBars)
            if fbRes == 1
                f_pushEvent(SMC_fbreakEvents, SMC_Event.new(fb.level, fb.breakDir > 0 ? DIR_BEAR : DIR_BULL, bar_index, time, "", KIND_FALSEBREAK), MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
                array.remove(SMC_fbreaks, i)
            else if fbRes == -1
                array.remove(SMC_fbreaks, i)
    if array.size(SMC_pools) > 0
        for i = 0 to array.size(SMC_pools) - 1
            SMC_Pool p = array.get(SMC_pools, i)
            int bd = (p.dir == DIR_BULL and close > p.level and close[1] <= p.level) ? 1 : (p.dir == DIR_BEAR and close < p.level and close[1] >= p.level) ? -1 : 0
            if bd != 0
                bool dup = false
                if array.size(SMC_fbreaks) > 0
                    for j = 0 to array.size(SMC_fbreaks) - 1
                        if math.abs(array.get(SMC_fbreaks, j).level - p.level) <= i_poolTol * atr14
                            dup := true
                            break
                if not dup
                    array.push(SMC_fbreaks, SMC_FBreak.new(p.level, bd, bar_index))
    while array.size(SMC_fbreaks) > MAX_FBREAKS
        array.remove(SMC_fbreaks, 0)

// --- Kill Zones / sesiones [§3.4 · ADR-001] · T11 ---
// Membresia en hora LOCAL con DST automatico (P-25): time(timeframe.period, session, tz) es na fuera
// de la ventana. Se calcula consumer-side (necesita contexto de barra) y se pasa a la f_killZone pura.
// Ventanas §3.4: London 07:00-10:00 Europe/London (1ª mitad 07:00-08:30), NY AM 08:00-11:00
// America/New_York (1ª mitad 08:00-09:30), Tokyo 09:00-11:00 Asia/Tokyo (1ª mitad 09:00-10:00).
int kzProfile = i_sessionProfile == "FX-Asia" ? SP_ASIA : i_sessionProfile == "None" ? SP_NONE : SP_LONDON_NY
bool kzInLondon      = kzProfile != SP_NONE and not na(time(timeframe.period, "0700-1000", "Europe/London"))
bool kzInLondonFirst = kzProfile != SP_NONE and not na(time(timeframe.period, "0700-0830", "Europe/London"))
bool kzInNY          = kzProfile != SP_NONE and not na(time(timeframe.period, "0800-1100", "America/New_York"))
bool kzInNYFirst     = kzProfile != SP_NONE and not na(time(timeframe.period, "0800-0930", "America/New_York"))
bool kzInTokyo       = kzProfile == SP_ASIA and not na(time(timeframe.period, "0900-1100", "Asia/Tokyo"))
bool kzInTokyoFirst  = kzProfile == SP_ASIA and not na(time(timeframe.period, "0900-1000", "Asia/Tokyo"))
[curKZ, curKZFirst] = f_killZone(kzInLondon, kzInLondonFirst, kzInNY, kzInNYFirst, kzInTokyo, kzInTokyoFirst, kzProfile)
// Ribbon KZ [Eje2 · Paso 5 · §F9/§6.3]: rastrea el INICIO de la sesion EN CURSO (transicion de sesion)
// para dibujar una tira delgada arriba en la seccion L0 (reemplaza el bgcolor full-height que solapaba el
// grid). Anti-repaint: solo barras confirmadas; na fuera de sesion.
var int kzActiveStart = na
if barstate.isconfirmed
    kzActiveStart := curKZ == KZ_NONE ? na : (curKZ != curKZ[1] ? time : kzActiveStart)

// --- Macros intradia [§5.14] · T39 ---
// Minutos del dia en hora NY (DST automatico) -> f_macroActive. Refina #34 (peso); para el scoring
// (Fase 2) y un sombreado tenue (bgcolor) cuando hay macro activa. No bloquea (ADR-001, el reloj informa).
int  nyMinNow = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
[curMacroActive, curMacroKind] = f_macroActive(nyMinNow)
// Sombreado -> movido a la seccion L0 (fondo temporal), gateado a Estudio+ (Paso 5 · §F9). Aqui solo detecta.

// --- RTH vs ETH [§5.15] · T40 ---
// Tipo de sesion por perfil (reusa nyMinNow). En FX (i_rthEnable off) = siempre RTH (sin modulacion).
// Sombrea ETH tenue cuando esta activo (instrumentos con sesion acotada). Para el scoring (#34 calidad).
bool curIsRTH = f_sessionType(nyMinNow, i_rthStart, i_rthEnd, i_rthEnable)
// Sombreado ETH -> movido a la seccion L0 (fondo temporal), gateado a modo Todo (Paso 5 · §F9). Aqui solo detecta.

// --- SMT Divergence [§5.13 · ADR-011] · T38 ---
// 2o request.security al par CORRELACIONADO (default GBPUSD positiva, ADR-011) -> sus ultimos 2 swings via
// f_smtPivots; si SMT off, security sobre si mismo (coste minimo, deteccion gateada). Pivotes del chart:
// se rastrean los ultimos 2 swing highs/lows con var (reusa newSwingHigh/swingHigh). f_detectSMT compara
// la divergencia al confirmar un swing del chart. lookahead_off (anti-repaint). Pobla SMC_smt.
string smtTicker = i_smtEnable and i_smtSymbol != "" ? i_smtSymbol : syminfo.tickerid
[smtCoSHcur, smtCoSHprev, smtCoSLcur, smtCoSLprev] = request.security(smtTicker, timeframe.period, f_smtPivots(i_swingLen), lookahead = barmerge.lookahead_off)
var float smtChSHcur  = na
var float smtChSHprev = na
var float smtChSLcur  = na
var float smtChSLprev = na
var array<SMC_Event> SMC_smt = array.new<SMC_Event>()
SMC_Event evSMT = na
if barstate.isconfirmed
    if newSwingHigh
        smtChSHprev := smtChSHcur
        smtChSHcur  := swingHigh
    if newSwingLow
        smtChSLprev := smtChSLcur
        smtChSLcur  := swingLow
    if i_smtEnable
        evSMT := f_detectSMT(newSwingHigh, smtChSHcur, smtChSHprev, newSwingLow, smtChSLcur, smtChSLprev, smtCoSHcur, smtCoSHprev, smtCoSLcur, smtCoSLprev, i_smtInverse, bar_index, time)
        if not na(evSMT)
            f_pushEvent(SMC_smt, evSMT, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)

// --- Judas Swing [§3.5] · T18 ---
// Composicion sweep+displacement: sweep (§3.2) en 1a mitad de KZ + displacement (§4.1) en la direccion
// real <= i_judasBars velas despues (confluencia #13). El detector es PURO; el sweep PENDIENTE vive aqui
// (var, entre barras) y se pasa por parametro. Entradas de ESTA barra: evSweepAlert (sweep, espejo de
// scope externo del bloque pools [T15]), evDisp (displacement [T16]), curKZFirst (1a mitad KZ, gate de
// registro). Todas calculadas arriba. Va a su array dedicado SMC_judas (confluencia #13, scoring Fase 3).
var array<SMC_Event> SMC_judas = array.new<SMC_Event>()
var int   judasPendDir   = 0
var int   judasPendIdx   = na
var float judasPendLevel = na
SMC_Event evJudas = na
if barstate.isconfirmed
    [jEv, jDir, jIdx, jLvl] = f_detectJudas(evSweepAlert, evDisp, curKZFirst, judasPendDir, judasPendIdx, judasPendLevel, bar_index, time, i_judasBars)
    judasPendDir   := jDir
    judasPendIdx   := jIdx
    judasPendLevel := jLvl
    evJudas := jEv
    if not na(evJudas)
        f_pushEvent(SMC_judas, evJudas, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)

// --- Rejection [§2.7] · T20 ---
// Vela de rechazo (mecha larga) anclada a un nivel clave. La geometria la decide f_detectRejection
// (pura); el ANCLA (nearLow/nearHigh) la computa aqui f_wickNearLevel sobre el estado vigente: zonas
// (SMC_zones OB/FVG/Breaker), pools vivos (SMC_pools), EQH/EQL (SMC_eqhl), bordes P/D (chartState) y
// EMAs del chart. tol = i_rejTouchTol*ATR14. EMAs ta.ema CADA barra (fuera del if, RE-safe). Va a su
// array dedicado SMC_rejections (confluencia #23, scoring Fase 3).
// EMAs del chart [T23 · §4.3], periodos configurables. ta.ema CADA barra (fuera del if, RE-safe).
// Compartidas: las consume la Rejection (ancla a nivel), el estado EMA #37-#42 y el panel.
float emaFast = ta.ema(close, i_emaFast)
float emaMid  = ta.ema(close, i_emaMid)
float emaSlow = ta.ema(close, i_emaSlow)
var array<SMC_Event> SMC_rejections = array.new<SMC_Event>()
SMC_Event evRej = na
if barstate.isconfirmed
    float rejTol = i_rejTouchTol * atr14
    bool rejNearLow  = f_wickNearLevel(low,  SMC_zones, SMC_pools, SMC_eqhl, chartState.pdHigh, chartState.pdLow, chartState.pdMid, emaFast, emaMid, emaSlow, rejTol)
    bool rejNearHigh = f_wickNearLevel(high, SMC_zones, SMC_pools, SMC_eqhl, chartState.pdHigh, chartState.pdLow, chartState.pdMid, emaFast, emaMid, emaSlow, rejTol)
    evRej := f_detectRejection(open, high, low, close, i_rejWickFactor, rejNearLow, rejNearHigh, bar_index, time)
    if not na(evRej)
        f_pushEvent(SMC_rejections, evRej, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)

// --- Flip [§2.8] · T21 ---
// Nivel roto por cierre limpio (lo provee la estructura swing: BOS/CHoCH) que cambia de rol al ser
// retesteado. SMC_flips = niveles PENDIENTES (var); cada barra confirmada se actualizan por OHLC, y al
// confirmarse (LF_FLIPPED) se emite KIND_FLIP a SMC_flipEvents (confluencia #25). Orden: actualizar/
// limpiar terminales -> registrar el nuevo (no se evalua en su barra de ruptura). Nivel roto + direccion
// = evStructSwing.price/.dir. Recorre hacia atras para poder remover terminales en el mismo loop.
var array<SMC_Flip>  SMC_flips      = array.new<SMC_Flip>()
var array<SMC_Event> SMC_flipEvents = array.new<SMC_Event>()
SMC_Event evFlip = na
if barstate.isconfirmed
    if array.size(SMC_flips) > 0
        for i = array.size(SMC_flips) - 1 to 0
            SMC_Flip f = array.get(SMC_flips, i)
            f_updateFlip(f, high, low, close)
            if f.state == LF_FLIPPED
                evFlip := SMC_Event.new(f.level, f.breakDir > 0 ? DIR_BULL : DIR_BEAR, bar_index, time, "", KIND_FLIP)
                f_pushEvent(SMC_flipEvents, evFlip, MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
                array.remove(SMC_flips, i)
            else if f.state == LF_INVALID
                array.remove(SMC_flips, i)
    if not na(evStructSwing)
        array.push(SMC_flips, SMC_Flip.new(evStructSwing.price, evStructSwing.dir, LF_PENDING, bar_index, time))
    while array.size(SMC_flips) > MAX_FLIPS
        array.remove(SMC_flips, 0)

// --- EMAs estado / cruces / rebotes [§4.3] · T23 ---
// #40 cruce reciente: ta.crossover/under de cualquier par (cada barra, fuera del if) -> recuerda el
// ultimo cruce y su direccion; aporta si ocurrio en <= i_emaCrossBars velas. #41 rebote: la mecha toca
// una EMA y cierra de vuelta (>= rejWickFactor*cuerpo) en la direccion de la tendencia (close vs lenta).
// f_emaState empaqueta #37-#42; emaAggr (suma direccional) queda para el scoring Fase 3 / panel. Rebote
// emite KIND_EMABOUNCE a SMC_emaBounces (marcador #41).
// ta.crossover/under SIEMPRE a variable propia (cada barra): dentro de un 'or' el cortocircuito puede
// saltarse llamadas con historia -> calculo inconsistente (warning Pine). Se combinan despues.
bool emaCu1 = ta.crossover(emaFast, emaMid)
bool emaCu2 = ta.crossover(emaMid, emaSlow)
bool emaCu3 = ta.crossover(emaFast, emaSlow)
bool emaCd1 = ta.crossunder(emaFast, emaMid)
bool emaCd2 = ta.crossunder(emaMid, emaSlow)
bool emaCd3 = ta.crossunder(emaFast, emaSlow)
bool emaCU = emaCu1 or emaCu2 or emaCu3
bool emaCD = emaCd1 or emaCd2 or emaCd3
var int emaLastCrossDir = 0
var int emaLastCrossBar = na
if emaCU
    emaLastCrossDir := 1
    emaLastCrossBar := bar_index
if emaCD
    emaLastCrossDir := -1
    emaLastCrossBar := bar_index
int emaRecentCrossDir = (not na(emaLastCrossBar) and (bar_index - emaLastCrossBar) <= i_emaCrossBars) ? emaLastCrossDir : 0
var array<SMC_Event> SMC_emaBounces = array.new<SMC_Event>()
var array<SMC_Event> SMC_emaCrosses = array.new<SMC_Event>()
var array<SMC_Event> SMC_emaStacks  = array.new<SMC_Event>()
var int emaAggr = 0
if barstate.isconfirmed
    float emaBody = math.abs(close - open)
    float emaLW   = math.min(open, close) - low
    float emaUW   = high - math.max(open, close)
    bool touchLowEma  = (low <= emaFast and close > emaFast) or (low <= emaMid and close > emaMid) or (low <= emaSlow and close > emaSlow)
    bool touchHighEma = (high >= emaFast and close < emaFast) or (high >= emaMid and close < emaMid) or (high >= emaSlow and close < emaSlow)
    int emaBounceDir = 0
    if emaLW >= i_rejWickFactor * emaBody and touchLowEma and close > emaSlow
        emaBounceDir := 1
    else if emaUW >= i_rejWickFactor * emaBody and touchHighEma and close < emaSlow
        emaBounceDir := -1
    [es37, es38, es39, es40, es41, es42] = f_emaState(close, emaFast, emaMid, emaSlow, emaRecentCrossDir, emaBounceDir)
    emaAggr := es37 + es38 + es39 + es40 + es41 + es42
    if emaBounceDir != 0
        f_pushEvent(SMC_emaBounces, SMC_Event.new(emaBounceDir > 0 ? low : high, emaBounceDir, bar_index, time, "", KIND_EMABOUNCE), MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
    // Eventos de cruce por par [§4.3]: marca + registro (el par va en tf para el peso del scoring).
    int xc2050  = f_emaCrossDir(emaFast, emaFast[1], emaMid,  emaMid[1])
    int xc50200 = f_emaCrossDir(emaMid,  emaMid[1],  emaSlow, emaSlow[1])
    int xc20200 = f_emaCrossDir(emaFast, emaFast[1], emaSlow, emaSlow[1])
    if xc2050 != 0
        f_pushEvent(SMC_emaCrosses, SMC_Event.new(emaMid,  xc2050,  bar_index, time, "20x50",  KIND_EMACROSS), MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
    if xc50200 != 0
        f_pushEvent(SMC_emaCrosses, SMC_Event.new(emaSlow, xc50200, bar_index, time, "50x200", KIND_EMACROSS), MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
    if xc20200 != 0
        f_pushEvent(SMC_emaCrosses, SMC_Event.new(emaSlow, xc20200, bar_index, time, "20x200", KIND_EMACROSS), MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)
    // Stack Flip [§4.3]: 20 y 50 al MISMO lado de la 200 con transicion de regimen (golden/death cross).
    int stackNow  = (emaFast > emaSlow and emaMid > emaSlow) ? 1 : (emaFast < emaSlow and emaMid < emaSlow) ? -1 : 0
    int stackPrev = (emaFast[1] > emaSlow[1] and emaMid[1] > emaSlow[1]) ? 1 : (emaFast[1] < emaSlow[1] and emaMid[1] < emaSlow[1]) ? -1 : 0
    if stackNow != 0 and stackNow != stackPrev
        f_pushEvent(SMC_emaStacks, SMC_Event.new(emaSlow, stackNow, bar_index, time, "", KIND_EMASTACK), MAX_EVENTS, evRangeAtr, evBodyPct, sweptRecently, chartState.bias)

// Plot de las 3 EMAs (global). i_showEMA conmuta via color na (plot no admite condicional directo).
plot(i_showEMA ? emaFast : na, "EMA rapida", color = color.new(color.aqua,   0), linewidth = 1)
plot(i_showEMA ? emaMid  : na, "EMA media",  color = color.new(color.orange, 0), linewidth = 1)
plot(i_showEMA ? emaSlow : na, "EMA lenta",  color = color.new(color.red,    0), linewidth = 2)

// === MTF === [T13a · ESQUELETO-P3 §2.4/§4.1]
// Escalares de cada HTF traidos como TUPLE PLANO via request.security (R-P3-2: security NO
// transporta UDT/array). f_computeTFState se evalua en el contexto del HTF con estado var
// INTERNO por-contexto (R-P3-1, spike S039 ✅) -> no contamina el chart. lookahead_off
// SIEMPRE (regla #1, anti-repaint). Se reconstituyen a SMC_TFState ligeros (orden de campos
// = orden del tuple, .new posicional) que el dibujo en cascada consume. Mapa rico = T13b.
[d1_bias, d1_bosP, d1_bosD, d1_bosT, d1_chP, d1_chD, d1_chT, d1_mssP, d1_mssD, d1_mssT, d1_pdH, d1_pdL, d1_pdM, d1_e20, d1_e50, d1_e200, d1_atr, d1_k0, d1_t0, d1_b0, d1_d0, d1_ta0, d1_tb0, d1_k1, d1_t1, d1_b1, d1_d1, d1_ta1, d1_tb1, d1_k2, d1_t2, d1_b2, d1_d2, d1_ta2, d1_tb2, d1_k3, d1_t3, d1_b3, d1_d3, d1_ta3, d1_tb3, d1_k4, d1_t4, d1_b4, d1_d4, d1_ta4, d1_tb4, d1_k5, d1_t5, d1_b5, d1_d5, d1_ta5, d1_tb5, d1_k6, d1_t6, d1_b6, d1_d6, d1_ta6, d1_tb6, d1_k7, d1_t7, d1_b7, d1_d7, d1_ta7, d1_tb7, d1_k8, d1_t8, d1_b8, d1_d8, d1_ta8, d1_tb8, d1_k9, d1_t9, d1_b9, d1_d9, d1_ta9, d1_tb9, d1_k10, d1_t10, d1_b10, d1_d10, d1_ta10, d1_tb10, d1_k11, d1_t11, d1_b11, d1_d11, d1_ta11, d1_tb11] = request.security(syminfo.tickerid, "D", f_computeTFState(i_swingLen, i_pdSwingLen, i_mssDispFactor, i_mssBodyPct, i_eqlLength, i_eqThreshold, i_obHighVolFactor, i_obMitClose, i_fvgThreshold, i_poolTol, i_minTouches, i_mtfCapOB, i_mtfCapFVG, i_mtfCapPool, i_mtfCapSweep, i_mtfCapEQ, i_mtfCapBOS, i_mtfCapCHoCH), lookahead = barmerge.lookahead_off)
[h1_bias, h1_bosP, h1_bosD, h1_bosT, h1_chP, h1_chD, h1_chT, h1_mssP, h1_mssD, h1_mssT, h1_pdH, h1_pdL, h1_pdM, h1_e20, h1_e50, h1_e200, h1_atr, h1_k0, h1_t0, h1_b0, h1_d0, h1_ta0, h1_tb0, h1_k1, h1_t1, h1_b1, h1_d1, h1_ta1, h1_tb1, h1_k2, h1_t2, h1_b2, h1_d2, h1_ta2, h1_tb2, h1_k3, h1_t3, h1_b3, h1_d3, h1_ta3, h1_tb3, h1_k4, h1_t4, h1_b4, h1_d4, h1_ta4, h1_tb4, h1_k5, h1_t5, h1_b5, h1_d5, h1_ta5, h1_tb5, h1_k6, h1_t6, h1_b6, h1_d6, h1_ta6, h1_tb6, h1_k7, h1_t7, h1_b7, h1_d7, h1_ta7, h1_tb7, h1_k8, h1_t8, h1_b8, h1_d8, h1_ta8, h1_tb8, h1_k9, h1_t9, h1_b9, h1_d9, h1_ta9, h1_tb9, h1_k10, h1_t10, h1_b10, h1_d10, h1_ta10, h1_tb10, h1_k11, h1_t11, h1_b11, h1_d11, h1_ta11, h1_tb11] = request.security(syminfo.tickerid, "60", f_computeTFState(i_swingLen, i_pdSwingLen, i_mssDispFactor, i_mssBodyPct, i_eqlLength, i_eqThreshold, i_obHighVolFactor, i_obMitClose, i_fvgThreshold, i_poolTol, i_minTouches, i_mtfCapOB, i_mtfCapFVG, i_mtfCapPool, i_mtfCapSweep, i_mtfCapEQ, i_mtfCapBOS, i_mtfCapCHoCH), lookahead = barmerge.lookahead_off)
SMC_TFState d1State = SMC_TFState.new(d1_bias, d1_bosP, d1_bosD, d1_bosT, d1_chP, d1_chD, d1_chT, d1_mssP, d1_mssD, d1_mssT, d1_pdH, d1_pdL, d1_pdM, d1_e20, d1_e50, d1_e200, d1_atr)
SMC_TFState h1State = SMC_TFState.new(h1_bias, h1_bosP, h1_bosD, h1_bosT, h1_chP, h1_chD, h1_chT, h1_mssP, h1_mssD, h1_mssT, h1_pdH, h1_pdL, h1_pdM, h1_e20, h1_e50, h1_e200, h1_atr)
// Buffer generico de ranuras reconstituido por HTF (ADR-009). 2a llamada/TF (mas cupo) se
// activaria aqui con un 2o request.security cuando Sprint 1.5/1.6 lo exijan (no ahora).
d1Kind = array.from(d1_k0, d1_k1, d1_k2, d1_k3, d1_k4, d1_k5, d1_k6, d1_k7, d1_k8, d1_k9, d1_k10, d1_k11)
d1Top  = array.from(d1_t0, d1_t1, d1_t2, d1_t3, d1_t4, d1_t5, d1_t6, d1_t7, d1_t8, d1_t9, d1_t10, d1_t11)
d1Bot  = array.from(d1_b0, d1_b1, d1_b2, d1_b3, d1_b4, d1_b5, d1_b6, d1_b7, d1_b8, d1_b9, d1_b10, d1_b11)
d1Dir  = array.from(d1_d0, d1_d1, d1_d2, d1_d3, d1_d4, d1_d5, d1_d6, d1_d7, d1_d8, d1_d9, d1_d10, d1_d11)
d1TA   = array.from(d1_ta0, d1_ta1, d1_ta2, d1_ta3, d1_ta4, d1_ta5, d1_ta6, d1_ta7, d1_ta8, d1_ta9, d1_ta10, d1_ta11)
d1TB   = array.from(d1_tb0, d1_tb1, d1_tb2, d1_tb3, d1_tb4, d1_tb5, d1_tb6, d1_tb7, d1_tb8, d1_tb9, d1_tb10, d1_tb11)
h1Kind = array.from(h1_k0, h1_k1, h1_k2, h1_k3, h1_k4, h1_k5, h1_k6, h1_k7, h1_k8, h1_k9, h1_k10, h1_k11)
h1Top  = array.from(h1_t0, h1_t1, h1_t2, h1_t3, h1_t4, h1_t5, h1_t6, h1_t7, h1_t8, h1_t9, h1_t10, h1_t11)
h1Bot  = array.from(h1_b0, h1_b1, h1_b2, h1_b3, h1_b4, h1_b5, h1_b6, h1_b7, h1_b8, h1_b9, h1_b10, h1_b11)
h1Dir  = array.from(h1_d0, h1_d1, h1_d2, h1_d3, h1_d4, h1_d5, h1_d6, h1_d7, h1_d8, h1_d9, h1_d10, h1_d11)
h1TA   = array.from(h1_ta0, h1_ta1, h1_ta2, h1_ta3, h1_ta4, h1_ta5, h1_ta6, h1_ta7, h1_ta8, h1_ta9, h1_ta10, h1_ta11)
h1TB   = array.from(h1_tb0, h1_tb1, h1_tb2, h1_tb3, h1_tb4, h1_tb5, h1_tb6, h1_tb7, h1_tb8, h1_tb9, h1_tb10, h1_tb11)

// --- PALETA CENTRALIZADA (COL_*) + MATRIZ DE RENDER [Eje2 · Paso 3 · ESQUELETO-FABLE §5.2/5.3/5.4] ---
// 100% render -> vive FUERA del === LIBRARY CORE === (no rompe check-core-sync). Colapsa el "rainbow"
// disperso a la paleta canonica por FAMILIA (§5.2): el HUE identifica QUE es; la direccion, dentro de
// una familia de ZONA, va por TONO (claro=alcista / oscuro=bajista). EXCEPCION (pedido del usuario):
// la direccion se lee en VERDE/ROJO en ESTRUCTURA/swings, P/D, pools, sweeps, legs y stack EMA
// (lenguaje nativo del trader). Valores CONGELADOS hasta Fase 3 (ADR-002): recalibrar AQUI, en un
// solo lugar, sin tocar los ~40 bloques. El switching de nivel P/S/T (f_visualLevel) es el Paso 4.
// --- Direccion verde/rojo (se conserva) ---
color COL_BULL    = #089981                 // alcista: estructura/swings/legs/stack (teal)
color COL_BEAR    = #F23645                 // bajista: estructura/swings/legs/stack (rojo)
color COL_BSL     = color.rgb(229, 99, 99)  // liquidez BSL (sobre highs, para ventas): rojo suave
color COL_SSL     = color.rgb(94, 196, 112) // liquidez SSL (bajo lows, para compras): verde suave
color COL_PREM    = color.red               // Premium (zona de venta del dealing range)
color COL_DISC    = color.green             // Discount (zona de compra)
// --- Familias, hue por familia (§5.2); tono claro=alcista / oscuro=bajista ---
color COL_OB_BULL = color.rgb(74, 130, 235) // OB/Breaker/MB/Vacuum (azul) alcista
color COL_OB_BEAR = color.rgb(26, 72, 184)  // azul bajista
color COL_OB      = #2962FF                 // azul base (neutro, p.ej. Vacuum/BPR-azul)
color COL_FVG_BULL= color.rgb(255, 183, 77) // FVG/IFVG/BPR/IR/VI/IPR/opening-gaps (naranja) alcista
color COL_FVG_BEAR= color.rgb(239, 108, 0)  // naranja bajista
color COL_FVG     = #FF9800                 // naranja base (neutro/bidireccional)
color COL_LIQ     = #9C27B0                 // liquidez-evento: sweeps ctx / IDM / Judas / EQH-EQL (violeta)
color COL_OTE_GP  = color.rgb(212, 175, 55) // Golden Pocket (ambar claro)
color COL_OTE     = color.rgb(150, 110, 20) // OTE profundo (ambar oscuro)
color COL_FRAME_Q = #787B86                 // marco: quadrants grid/PD (gris-azul)
color COL_FRAME_E = #5D606B                 // marco: eighths (gris-azul oscuro)
color COL_GHOST   = #9598A1                 // ghosts / mitigado / neutro / herramientas (gris)
// --- KZ por sesion (§5.2; ribbon = Paso 5) ---
color COL_KZ_LON  = #4CAF50                 // London
color COL_KZ_NY   = #E91E63                 // New York
color COL_KZ_ASIA = #3F51B5                 // Asia / Tokyo
// --- Matriz de render por nivel (§5.3) — numeros CONGELADOS; el switching P/S/T = Paso 4 ---
int TRANSP_PRIM = 82                         // fill Primario
int TRANSP_SEC  = 92                         // fill Secundario
int W_PRIM      = 2                          // grosor linea Primario
int W_SEC       = 1                          // grosor linea Secundario

// --- Densidad visual (i_densidad) + nivel visual f_visualLevel [Eje2 · Paso 4 · §2.2/§2.4/§8.1] ---
// Filtro TRANSVERSAL adicional a los i_show*: consume el strength del Paso 2 (via f_strengthLevel del
// CORE) para decidir cuanto "grita" cada marca. Nivel visual 0/1/2 = Terciario/Secundario/Primario; se
// dibuja si alcanza el minimo del modo (densMin). Las ANCLAS estructurales (§2.3, isAnchor) fuerzan
// Primario. FUNDACION del Paso 4: el top-N por score (f_strongestN §2.5), los pisos MTF (§7.1) y la
// matriz fina por-familia (§8.2) son la iteracion siguiente. Default "Todo" = NO oculta nada (no
// regresivo); el usuario baja a Estudio/Operacion para depurar. Umbrales CONGELADOS hasta Fase 3.
string GRP_DENS = "Densidad visual (§8)"
i_densidad = input.string("Todo", "Densidad", options = ["Operación", "Estudio", "Todo"], group = GRP_DENS, tooltip = "Operación = solo Primario (lo mas fuerte / anclas) · Estudio = + Secundario · Todo = todo (default)")
int densMin = i_densidad == "Operación" ? 2 : i_densidad == "Estudio" ? 1 : 0
// --- Matriz modo×familia §8.2 (curacion por familia, ENCIMA del filtro strength) ---
// modeIdx 0<1<2: mayor = mas laxo (habilita mas familias). Operacion = solo familias de DECISION
// (OB/Breaker/FVG/IFVG/OTE + anclas); Estudio suma refinamientos (BPR/Mitigation/Vacuum); Todo suma
// micro-conceptos (VI/IPR). Default "Todo" => todas visibles (no regresivo). Congelado hasta Fase 3.
int modeIdx  = i_densidad == "Operación" ? 0 : i_densidad == "Estudio" ? 1 : 2
int FAM_OP   = 0                                                                                           // Operacion+ (decision)
int FAM_EST  = 1                                                                                           // Estudio+ (refinamientos)
int FAM_TODO = 2                                                                                           // solo Todo (micro)
f_famOK(int famMinMode) => modeIdx >= famMinMode
// nivel visual 0/1/2 a partir del strength quantizado del CORE (§2.2). Orden: ancla -> Primario forzado
// (§2.3); si no, el mayor entre el nivel por strength y el PISO MTF (§7.1-2: una heredada Primaria en su
// TF origen entra con piso Secundario y nunca cae a Terciaria). mtfFloor=0 para marcas nativas del TF.
f_visualLevel(int sLevel, bool isAnchor, int mtfFloor) =>
    isAnchor ? 2 : math.max(sLevel, mtfFloor)
// atajo por marca NATIVA (sin piso MTF): true si debe dibujarse en el modo actual.
f_densOK(float strength, bool isAnchor) =>
    f_visualLevel(f_strengthLevel(strength), isAnchor, 0) >= densMin
// score_render §2.5 (CONGELADO Fase 3): strength × f(cercania), f = 1 − min(distAtr/6, 0.8). La
// cercania pondera pero NO anula una zona fuerte algo lejana. Llave de orden de anclas y del top-N.
f_renderScore(float strength, float distAtr) =>
    strength * (1.0 - math.min(distAtr / 6.0, 0.8))

// --- Anclas estructurales §2.3 (Primarias SIEMPRE, independiente del strength) ---
// "Zona activa mas cercana por lado": 1 arriba + 1 abajo del precio, la de mayor score_render, sobre
// OB/FVG/Breaker activos (no mitigados/invalidados). Se precomputan los INDICES en SMC_zones; cada loop
// de dibujo compara su i -> isAnchor -> f_visualLevel fuerza Primario (salta densMin, §2.2 paso 2). Las
// anclas NO consumen el top-N de su familia (se reservan aparte). Tie-break: mayor score; a igualdad,
// gana el primero hallado (orden de insercion ~ frescura). Guardado con barstate.islast (coste 1 pasada).
int anchorHiIdx = -1
int anchorLoIdx = -1
if barstate.islast and array.size(SMC_zones) > 0
    float aPx  = close
    float aAtr = chartState.atr14
    if not na(aAtr) and aAtr > 0
        float hiScore = -1.0
        float loScore = -1.0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            bool elig = (z.kind == KIND_OB or z.kind == KIND_FVG or z.kind == KIND_BREAKER) and z.state != ZS_INVALID and z.state != ZS_MITIGATED
            if elig
                bool above = z.bottom > aPx                                                                // zona por encima del precio
                bool below = z.top < aPx                                                                   // zona por debajo (mutuamente exclusivas)
                if above or below
                    float dAtr = above ? (z.bottom - aPx) / aAtr : (aPx - z.top) / aAtr
                    float sc   = f_renderScore(z.strength, dAtr)
                    if above and sc > hiScore
                        hiScore   := sc
                        anchorHiIdx := i
                    else if below and sc > loScore
                        loScore   := sc
                        anchorLoIdx := i

// === DIBUJO ===
// f_draw<Concepto>() por concepto, cada uno con su cuota de objetos [PINE-PLAN §5].

// === §6.5 · PRESUPUESTO GLOBAL DE TINTA (desalojo determinista) [Eje2 · Paso 6 · S090] ================
// El budget de labels es GLOBAL por modo (Operación 25 / Estudio 60 / Todo 150). La herencia MTF (§7.1)
// y las anclas (§2.3) son MANDATORIAS y NUNCA se desalojan; el excedente se corta de las familias L3
// nativas discrecionales (EQHL/pools/sweep/flip/gaps) por orden inverso de frescura (las mas viejas
// primero). En M5 se heredan DOS capas MTF (D1+H1) -> el chart limpio se logra soltando el ruido nativo
// del TF activo, NO la herencia. Sin arrays nuevos (contador int + dedup string) -> no dispara RE10045.
// Hallazgo S090: el budget ≤25 se cumplia en H1/D1 por aritmetica del top-N, pero M5 (doble capa MTF)
// llegaba a 35 labels sin este desalojo (§6.5 estaba marcado [impl] sin implementar).
// f_mtfLblYield: cuenta los labels que EMITIRA la capa MTF (mirror del label-yield de f_drawMTFZones:
// labelKinds distintos por (kind,dir)). Sobre-cuenta los BOS/CHoCH que luego se fusionan (no dibujan
// label) -> reserva CONSERVADORA (corta un pelo mas de nativo = seguro para el budget).
f_mtfLblYield(array<int> kinds, array<int> dirs, array<float> tops) =>
    string seen = ""
    int n = 0
    if array.size(kinds) > 0
        for i = 0 to array.size(kinds) - 1
            int k = array.get(kinds, i)
            float tp = array.get(tops, i)
            int dr = array.get(dirs, i)
            bool labelKind = k == KIND_EQH or k == KIND_EQL or k == KIND_POOL or k == KIND_SWEEP or k == KIND_BOS or k == KIND_CHOCH
            string key = "|" + str.tostring(k) + "_" + str.tostring(dr) + "|"
            if labelKind and not na(tp) and not str.contains(seen, key)
                seen := seen + key
                n += 1
    n
// f_capLbls: recorta un array de labels (con sus lineas 1:1) al budget restante borrando las MAS VIEJAS
// (array.shift) hasta que gCount + size <= cap. Devuelve [nuevoGCount, cortadas]. Solo actua cuando el
// presupuesto aprieta (Operacion/M5); en Estudio+/Todo el cap holgado deja el while inactivo.
f_capLbls(array<label> lbls, array<line> lns, int gCount, int cap) =>
    int cut = 0
    while array.size(lbls) > 0 and gCount + array.size(lbls) > cap
        label.delete(array.shift(lbls))
        if array.size(lns) > 0
            line.delete(array.shift(lns))
        cut += 1
    [gCount + array.size(lbls), cut]
f_capLblsOnly(array<label> lbls, int gCount, int cap) =>
    int cut = 0
    while array.size(lbls) > 0 and gCount + array.size(lbls) > cap
        label.delete(array.shift(lbls))
        cut += 1
    [gCount + array.size(lbls), cut]
// Reserva MTF + presupuesto de eventos nativos. mtfShow* se recomputa aqui (los flags viven mas abajo).
bool budMtfD1 = i_showD1 and timeframe.in_seconds() < timeframe.in_seconds("D")
bool budMtfH1 = i_showH1 and timeframe.in_seconds() < timeframe.in_seconds("60")
int budgetLbl = i_densidad == "Operación" ? 25 : i_densidad == "Estudio" ? 60 : 150
int FRAME_RESERVE = 8                                                                                       // P/D nativo(3)+grid(2)+estructura ancla(~3); default congelado §11.3
int mtfReserve = (budMtfD1 ? f_mtfLblYield(d1Kind, d1Dir, d1Top) + 2 : 0) + (budMtfH1 ? f_mtfLblYield(h1Kind, h1Dir, h1Top) + 2 : 0)
int eventCap = math.max(0, budgetLbl - mtfReserve - FRAME_RESERVE)                                          // labels que quedan para eventos nativos L3
int gEvtLbl = 0                                                                                             // contador de labels de eventos nativos ya emitidos (orden de dibujo)
int gEvtCut = 0                                                                                             // §10-#8: desalojados -> panel T14 (nada desaparece en silencio)

// === L0 · FONDO TEMPORAL [Eje2 · Paso 5 · ESQUELETO-FABLE §3/§F9/§6.3] ================================
// Contexto de TIEMPO (Kill Zones, macros, RTH/ETH). Regla "un solo fondo de area" (§6.3): la KZ se rinde
// como RIBBON (tira delgada arriba, SOLO la sesion EN CURSO = ancla §2.3) en vez del bgcolor full-height
// que solapaba el grid gris-azul (L1) -> resuelve el choque grid vs Kill Zones (checklist §10-4). El
// bgcolor tenue de sesion queda SOLO en Estudio+; macros = Estudio+; RTH/ETH = solo Todo (§F9). Asi en
// Operacion NO hay dos fills de area grande a la vez. Ribbon anclado sobre el maximo reciente (no tapa
// precio), alto ~0.35xATR. Numeros CONGELADOS (Fase 3 · ADR-002).
float kzRibTop = ta.highest(high, 100) + nz(chartState.atr14) * 0.6
float kzRibBot = kzRibTop - nz(chartState.atr14) * 0.35
var box   kzRibbon    = na
var label kzRibbonLbl = na
if i_showKZ and barstate.islast
    box.delete(kzRibbon)
    label.delete(kzRibbonLbl)
    kzRibbon    := na
    kzRibbonLbl := na
    if curKZ != KZ_NONE and not na(kzActiveStart) and not na(chartState.atr14)
        color  kzc = curKZ == KZ_LONDON ? COL_KZ_LON : curKZ == KZ_NY ? COL_KZ_NY : COL_KZ_ASIA
        string kzn = curKZ == KZ_LONDON ? "London" : curKZ == KZ_NY ? "NY" : "Asia"
        kzRibbon    := box.new(kzActiveStart, kzRibTop, time, kzRibBot, xloc = xloc.bar_time, bgcolor = color.new(kzc, 25), border_color = color.new(kzc, 25), border_width = 1)
        kzRibbonLbl := label.new(kzActiveStart, kzRibTop, kzn, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(kzc, 20), textcolor = color.white, size = size.tiny)
// bgcolor de sesion: SOLO Estudio+ (ultra-tenue >=92 transp), solo la KZ activa (§F9). En Operacion no hay fondo.
bgcolor(i_showKZ and f_famOK(FAM_EST) and curKZ != KZ_NONE ? (curKZ == KZ_LONDON ? color.new(COL_KZ_LON, 93) : curKZ == KZ_NY ? color.new(COL_KZ_NY, 93) : color.new(COL_KZ_ASIA, 93)) : na, title = "Kill Zone activa (Estudio+)")
// Macros intradia (§F9): sombreado SOLO Estudio+. Gris = NY Lunch (kind 3, filtro), purpura = macros de impulso.
bgcolor(i_showMacros and f_famOK(FAM_EST) and curMacroActive ? color.new(curMacroKind == 3 ? color.gray : color.purple, 92) : na, title = "Macro activa (Estudio+)")
// RTH/ETH (§F9): sombreado de ETH SOLO en modo Todo (contexto de sesion acotada; en FX i_rthEnable off = siempre RTH).
bgcolor(i_rthEnable and f_famOK(FAM_TODO) and not curIsRTH ? color.new(color.gray, 94) : na, title = "ETH (Todo)")

// === L1 · MARCO DE PRECIO [Eje2 · Paso 5b · ESQUELETO-FABLE §3] =====================================
// Contexto de PRECIO (OTE/GP, Premium/Discount, Gradient grid). LINEAS/cajas fib, SIN fill de area
// grande (§6.3) -> se dibuja PRIMERO (detras de zonas L2 y estructura L3). Reubicado aqui en Paso 5b
// (antes se dibujaba al final = encima de todo; corrige la inversion grid-sobre-zonas). Ver §3/§7.4.
// f_drawOTE: caja de la zona fib OTE/GP [T22 · §2.5] (solo Visual). GP (Golden Pocket, 50-61.8%) en
// DORADO; OTE (61.8-79%, mas profunda) en AMBAR mas oscuro -> ambos distintos del OB/FVG. Origen = barra
// del origen de la pierna; se extiende a la derecha hasta la barra actual. Transparencia por estado; la
// mitigada se atenua, la invalidada (pierna superseded o retroceso roto) no se dibuja.
f_drawOTE(SMC_Zone z) =>
    bool isGP = z.kind == KIND_GP
    col = isGP ? COL_OTE_GP : COL_OTE
    int transp = z.state == ZS_ACTIVE ? 80 : z.state == ZS_PARTIAL ? 86 : 92
    color bg = z.state == ZS_MITIGATED ? color.new(color.gray, 92) : color.new(col, transp)
    box.new(left = z.barIdx, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = bg, border_color = color.new(col, 50), border_width = 1, xloc = xloc.bar_index)

// En la ultima barra limpia y repinta las cajas OTE/GP vivas (KIND_GP/KIND_OTE, no invalidadas).
var array<box>   SMC_oteBoxes  = array.new<box>()
var array<label> SMC_oteLabels = array.new<label>()
if i_showOTE and barstate.islast
    for b in SMC_oteBoxes
        box.delete(b)
    for lb in SMC_oteLabels
        label.delete(lb)
    array.clear(SMC_oteBoxes)
    array.clear(SMC_oteLabels)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            if (z.kind == KIND_GP or z.kind == KIND_OTE) and z.state != ZS_INVALID and f_densOK(z.strength, false)
                array.push(SMC_oteBoxes, f_drawOTE(z))
                color oteCol = z.kind == KIND_GP ? COL_OTE_GP : COL_OTE
                string oteTxt = z.kind == KIND_GP ? "GP" : "OTE"
                array.push(SMC_oteLabels, label.new(math.round((z.barIdx + bar_index) / 2.0), (z.top + z.bottom) / 2.0, oteTxt, style = label.style_label_center, color = color.new(color.gray, 100), textcolor = oteCol, size = size.small, xloc = xloc.bar_index))

// f_drawPDLine: una linea de nivel del dealing range [T07] (solo Visual). Como LuxAlgo
// (drawTrailingExtremes :715-732): cada linea se ancla en SU PROPIO extremo via tiempo —
// premium en trailing.topTime (la barra del strong high), discount en trailing.bottomTime
// (la del strong low), no en un ancla compartida (eso hacia "volar" la linea). Dibuja con
// xloc.bar_time hasta la barra actual. Menos ruido que cajas (pref. usuario, Sesion-021).
f_drawPDLine(int leftTime, float level, color col, string lineStyle) =>
    line.new(leftTime, level, time, level, xloc = xloc.bar_time, color = col, style = lineStyle, width = 1)

// En la ultima barra limpia y repinta las 3 lineas P/D + las etiquetas. Premium = linea
// solida roja en trailing.top desde la barra del high (trailing.topTime, cf. LuxAlgo
// lastTopTime :725); Discount = linea solida verde en trailing.bottom desde la barra del
// low (trailing.bottomTime, cf. :730); Equilibrium = punteada gris en el 50% desde el
// extremo mas antiguo. La banda [45%,55%] (i_pdEqBand) ya no se dibuja: solo alimenta la
// clasificacion del panel (#31). Sin cajas -> sin ruido.
var array<line>  SMC_pdLines  = array.new<line>()
var array<label> SMC_pdLabels = array.new<label>()
if i_showPD and barstate.islast and not na(trailing.top) and not na(trailing.bottom) and trailing.top > trailing.bottom
    for l in SMC_pdLines
        line.delete(l)
    for lb in SMC_pdLabels
        label.delete(lb)
    array.clear(SMC_pdLines)
    array.clear(SMC_pdLabels)
    float eqLvl    = (trailing.top + trailing.bottom) / 2.0
    int   topLeft  = nz(trailing.topTime, time)
    int   botLeft  = nz(trailing.bottomTime, time)
    int   eqLeft   = topLeft < botLeft ? topLeft : botLeft
    array.push(SMC_pdLines, f_drawPDLine(topLeft, trailing.top,    color.new(COL_PREM, 0),  line.style_solid))
    array.push(SMC_pdLines, f_drawPDLine(eqLeft,  eqLvl,           color.new(COL_GHOST, 20), line.style_dotted))
    array.push(SMC_pdLines, f_drawPDLine(botLeft, trailing.bottom, color.new(COL_DISC, 0),  line.style_solid))
    // Tarjetas P/D/EQ a la DERECHA de la vela (style_label_left) y 2 velas de margen (bar_index + 2),
    // como las de BSL/SSL (pref. usuario): siguen el precio pero por el lado derecho, sin quedar pegadas.
    array.push(SMC_pdLabels, label.new(bar_index + 2, trailing.top,    "Premium "  + str.tostring(trailing.top, format.mintick),    style = label.style_label_left, color = color.new(COL_PREM, 80),  textcolor = COL_PREM,  size = size.small))
    array.push(SMC_pdLabels, label.new(bar_index + 2, eqLvl,           "EQ "       + str.tostring(eqLvl, format.mintick),           style = label.style_label_left, color = color.new(COL_GHOST, 80), textcolor = COL_GHOST, size = size.small))
    array.push(SMC_pdLabels, label.new(bar_index + 2, trailing.bottom, "Discount " + str.tostring(trailing.bottom, format.mintick), style = label.style_label_left, color = color.new(COL_DISC, 80), textcolor = COL_DISC, size = size.small))

// --- Gradient Levels: grid PRIMARIO seleccionado + ghosts [§5.16 · T41] (Visual-only) ---
// Dibuja el grid del rango-fuente PRIMARIO elegido por f_selectGradientSource (P1 dealing range o P2
// suspension diario) en GRIS-AZUL de familia marco (§5.2, COL_FRAME_Q; P1/P2 se distinguen por el
// sufijo "s" del label). Quadrants solidos, eighths punteados. Cuando la fuente es
// P1 se saltan 0/0.5/1 (ya los dibuja el bloque P/D Discount/EQ/Premium -> no duplicar tinta);
// para P2 se dibujan todos (el rango suspension no lo cubre P/D). Ademas dibuja los grids GHOST
// archivados (rango-fuente previo, solo quadrants, gris muy tenue, hasta i_gradPersistDays). Los
// mini-grids P3 de gaps NO se dibujan (son filtro de T43). Toggle i_showGradient.
// GRID SIN FILL (§6.3 · Paso 5): el marco de PRECIO posee el eje via LINEAS (line.new width=1), nunca
// fill de area grande -> el ribbon KZ (L0) posee el eje de TIEMPO. Un solo fondo de area por modo. Verificado.
var array<line>  SMC_gradLines  = array.new<line>()
var array<label> SMC_gradLabels = array.new<label>()
var int hidGrad = 0                                                                                         // §9-1: eighths del gradient ocultos en Operacion (§8.2 F6)
if i_showGradient and barstate.islast
    hidGrad := 0
    for l in SMC_gradLines
        line.delete(l)
    for lb in SMC_gradLabels
        label.delete(lb)
    array.clear(SMC_gradLines)
    array.clear(SMC_gradLabels)
    // Ghosts (rango-fuente previo) primero, debajo: solo quadrants, gris muy tenue, sin etiqueta.
    if array.size(SMC_gradGhosts) > 0
        for ghi = 0 to array.size(SMC_gradGhosts) - 1
            SMC_GradientGrid gg = array.get(SMC_gradGhosts, ghi)
            if array.size(gg.levels) > 0
                for gj = 0 to array.size(gg.levels) - 1
                    if array.get(gg.isQuadrant, gj)
                        array.push(SMC_gradLines, line.new(time - 172800000, array.get(gg.levels, gj), time, array.get(gg.levels, gj), xloc = xloc.bar_time, color = color.new(COL_GHOST, 88), style = line.style_dotted, width = 1))
    // Grid PRIMARIO vigente.
    if not na(gradSelTop) and not na(gradSelBot) and gradSelTop > gradSelBot and array.size(gradSelLevels) > 0
        bool  selP2   = gradSelKind == GRAD_SRC_SUSPENSION
        color baseCol = COL_FRAME_Q
        int   gLeft   = selP2 ? time - 172800000 : math.min(nz(trailing.topTime, time), nz(trailing.bottomTime, time))
        float gSpan   = gradSelTop - gradSelBot
        for gi = 0 to array.size(gradSelLevels) - 1
            float lvl  = array.get(gradSelLevels, gi)
            bool  q    = array.get(gradSelQuad, gi)
            float frac = (lvl - gradSelBot) / gSpan
            bool  skip = (not selP2) and (frac <= 0.001 or frac >= 0.999 or math.abs(frac - 0.5) < 0.001)
            bool showLvl = q or f_famOK(FAM_EST)                                                            // §8.2 F6: Operacion = solo quadrants (LQ/EQ/UQ); eighths desde Estudio+
            if not skip and not showLvl
                hidGrad += 1
            else if not skip
                color  gcol   = q ? color.new(baseCol, 35) : color.new(baseCol, 70)
                string gstyle = q ? line.style_solid : line.style_dotted
                array.push(SMC_gradLines, line.new(gLeft, lvl, time, lvl, xloc = xloc.bar_time, color = gcol, style = gstyle, width = 1))
                string src  = selP2 ? "s" : ""
                string gtxt = q ? (math.abs(frac - 0.5) < 0.001 ? "CE" : frac < 0.5 ? "LQ" : "UQ") + src + " " + str.tostring(lvl, format.mintick) : str.tostring(math.round(frac * 8)) + "/8"
                array.push(SMC_gradLabels, label.new(bar_index + 2, lvl, gtxt, style = label.style_label_left, color = color.new(baseCol, 90), textcolor = baseCol, size = size.tiny))

// === L2 ZONAS + L3 LIQUIDEZ/ESTRUCTURA [Eje2 · Paso 5b · ESQUELETO-FABLE §3] =========================
// A partir de aqui: estructura/swings/EQHL/pools/sweeps/eventos (L3) y cajas OB/FVG/Breaker/... (L2).
// El marco L1 (arriba) y el fondo L0 ya se dibujaron -> quedan detras. NOTA (follow-up, no bloquea el
// gate #4): el orden interno L3-antes-de-L2 (estructura dibujada antes que las cajas de zona) se conserva
// del layout previo; §3 pide L3 al frente de L2. Los fills de zona son translucidos (82/92) -> la
// estructura trasluce; el swap fino L2<->L3 se difiere a una pasada con validacion visual (TV).
// f_drawSwing: etiqueta flotante HH/HL/LH/LL en la vela del pivote. Estructura
// alcista (HH/HL) en verde-azulado, bajista (LH/LL) en rojo. style_label_down
// sobre swing highs (texto colgando bajo el techo), style_label_up bajo lows.
f_drawSwing(int barIdx, float price, int kind) =>
    bool isHigh = kind == KIND_HH or kind == KIND_LH
    [txt, col] = switch kind
        KIND_HH => ["HH", COL_BULL]
        KIND_HL => ["HL", COL_BULL]
        KIND_LH => ["LH", COL_BEAR]
        KIND_LL => ["LL", COL_BEAR]
        => ["?", COL_GHOST]
    label.new(barIdx, price, txt, style = isHigh ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 100), textcolor = col, size = size.small)

// Escalas de estructura (Visual-only): UNA sola f_drawStructure para las 3 variantes del
// MISMO concepto BOS/CHoCH (anti-duplicacion; antes habia f_drawStructure + f_drawStructureMajor
// casi gemelas). La escala parametriza grosor/estilo/xloc/sufijo/size.
SC_INTERNAL = 0
SC_SWING    = 1
SC_MAJOR    = 2

// Top-N vigente de estructura (§8.2 F1 Operacion = P · §4). Anti-flood del hallazgo S087
// (validacion vivo): ~120 BOS/CHoCH historicos inundaban Operacion sin recorte. f_drawStructure
// REGISTRA cada linea+label aqui; el recorte a las STRUCT_OP_CAP mas recientes se hace en islast
// (solo Operacion; Estudio+ conserva la traza completa). CONGELADO Fase 3 (ADR-002).
int STRUCT_OP_CAP = 3
var array<line>  SMC_structLines  = array.new<line>()
var array<label> SMC_structLabels = array.new<label>()
var int hidStruct = 0                                                                                       // §9-1: estructura oculta (detectada - dibujada) para el panel T14

// f_drawStructure: linea del nivel roto (origen pivote -> barra de ruptura) + etiqueta
// BOS/CHoCH centrada en el midpoint (bar_index). SIN recuadro (fondo transparente) con gap,
// como los LL/HH (pref. usuario): ALCISTA encima de la linea (style_label_down), BAJISTA
// debajo (style_label_up). Alcista teal / bajista rojo.
// scale [variantes del concepto estructura]:
//   SC_INTERNAL -> width 1, dashed, xloc bar_index, size tiny
//   SC_SWING    -> width 2, solid,  xloc bar_index, size small
//   SC_MAJOR    -> width 3, solid,  xloc bar_TIME (robusto en spans largos), sufijo " +", size normal
// isMSS [T12]: solo escala swing; si el CHoCH es MSS (§1.5) la etiqueta dice "CHoCH MSS" en el
// MISMO color direccional (una sola marca, sin capa fucsia). pivotTime/breakTime solo se usan
// en SC_MAJOR (xloc.bar_time); las otras escalas anclan por bar_index.
f_drawStructure(int pivotTime, int pivotBarIdx, float level, int breakTime, int breakBarIdx, int kind, int dir, int scale, bool isMSS) =>
    col = dir == DIR_BULL ? COL_BULL : COL_BEAR
    bool isInt = scale == SC_INTERNAL
    bool isMaj = scale == SC_MAJOR
    string txt = (kind == KIND_CHOCH ? (isMSS ? "CHoCH MSS" : "CHoCH") : "BOS") + (isMaj ? " +" : "")
    line ln = isMaj ? line.new(pivotTime, level, breakTime, level, xloc = xloc.bar_time, color = col, style = line.style_solid, width = 3) : line.new(pivotBarIdx, level, breakBarIdx, level, color = col, style = isInt ? line.style_dashed : line.style_solid, width = isInt ? 1 : 2)
    int midIdx = math.round((pivotBarIdx + breakBarIdx) / 2.0)
    label lb = label.new(midIdx, level, txt, style = dir == DIR_BULL ? label.style_label_down : label.style_label_up, color = color.new(col, 100), textcolor = col, size = isMaj ? size.normal : isInt ? size.tiny : size.small)
    array.push(SMC_structLines, ln)
    array.push(SMC_structLabels, lb)

// Matriz §8.2 (§F1): swings HH/HL/LH/LL = ruido en Operacion -> solo Estudio+ (f_famOK FAM_EST).
if i_showSwings and f_famOK(FAM_EST) and newSwingHigh
    f_drawSwing(bar_index - i_swingLen, swingHigh, swingHighKind)
if i_showSwings and f_famOK(FAM_EST) and newSwingLow
    f_drawSwing(bar_index - i_swingLen, swingLow, swingLowKind)

// [T12] El MSS ya NO es una capa fucsia aparte: si el CHoCH swing es MSS, la propia
// etiqueta dice "CHoCH MSS" (mismo color direccional). isMSS = i_showMSS and not na(evMSS).
// Las 3 escalas (interno/swing/dominante) usan la MISMA f_drawStructure (anti-duplicacion).
if i_showStruct and not na(evStructSwing)
    bool up = evStructSwing.dir == DIR_BULL
    int originIdx = up ? structSwing.highBarIdx : structSwing.lowBarIdx
    int originT   = up ? structSwing.highTime  : structSwing.lowTime
    f_drawStructure(originT, originIdx, evStructSwing.price, evStructSwing.barTime, evStructSwing.barIdx, evStructSwing.kind, evStructSwing.dir, SC_SWING, i_showMSS and not na(evMSS))
if i_showInternal and f_famOK(FAM_EST) and not na(evStructInt)                                              // estructura interna = Estudio+ (§F1)
    bool up = evStructInt.dir == DIR_BULL
    int originIdx = up ? structInternal.highBarIdx : structInternal.lowBarIdx
    int originT   = up ? structInternal.highTime  : structInternal.lowTime
    f_drawStructure(originT, originIdx, evStructInt.price, evStructInt.barTime, evStructInt.barIdx, evStructInt.kind, evStructInt.dir, SC_INTERNAL, false)

// Estructura dominante (50) [T07B]: misma f_drawStructure con escala SC_MAJOR (grosor 3,
// sufijo " +", linea por bar_time). Antes era una funcion aparte f_drawStructureMajor.
if i_showMajor and not na(evStructMajor)
    bool up = evStructMajor.dir == DIR_BULL
    int pivotT = up ? structMajor.highTime : structMajor.lowTime
    int pivotB = up ? structMajor.highBarIdx : structMajor.lowBarIdx
    f_drawStructure(pivotT, pivotB, evStructMajor.price, evStructMajor.barTime, evStructMajor.barIdx, evStructMajor.kind, evStructMajor.dir, SC_MAJOR, false)

// Recorte top-N vigente de estructura (§8.2 F1 = P): en Operacion deja solo las STRUCT_OP_CAP
// marcas mas recientes (BOS/CHoCH/major); Estudio+ conserva la traza completa. array.shift saca
// las mas antiguas (deja las vigentes al frente del precio). Resuelve el flood ~120 del hallazgo S087.
if barstate.islast
    int structBefore = array.size(SMC_structLabels)
    int structKeep = f_famOK(FAM_EST) ? 100000 : STRUCT_OP_CAP
    while array.size(SMC_structLabels) > structKeep
        label.delete(array.shift(SMC_structLabels))
    while array.size(SMC_structLines) > structKeep
        line.delete(array.shift(SMC_structLines))
    hidStruct := structBefore - array.size(SMC_structLabels)                                                // §9-1

// f_drawEQHL [T08]: linea punteada conectando los dos pivotes "iguales" + etiqueta
// EQH/EQL en el midpoint (bar_index). VIOLETA para ambos (familia liquidez §5.2): doble
// techo/suelo = liquidez (BSL arriba / SSL abajo). VIOLETA (familia liquidez, §5.2, COL_LIQ).
// Linea por xloc.bar_time (robusta en spans largos, cf. f_drawStructureMajor); etiqueta
// por bar_index (centra pese a los gaps de finde). Replica drawEqualHighLow LuxAlgo (style
// dotted).
// Top-N vigente de EQH/EQL (§8.2 F7 Operacion = P): en Operacion deja solo las EQ_OP_CAP
// igualdades mas recientes (anti-flood S087); Estudio+ conserva todo. CONGELADO Fase 3 (ADR-002).
int EQ_OP_CAP = 2
var array<line>  SMC_eqLines  = array.new<line>()
var array<label> SMC_eqLabels = array.new<label>()
var int hidEq = 0                                                                                           // §9-1: EQH/EQL ocultas para el panel T14
f_drawEQHL(int prevTime, float prevLevel, int prevBarIdx, int curTime, int curBarIdx, float level, bool isHigh) =>
    col = COL_LIQ
    txt = isHigh ? "EQH" : "EQL"
    line lnEq = line.new(prevTime, prevLevel, curTime, level, xloc = xloc.bar_time, color = col, style = line.style_dotted, width = 1)
    int midIdx = math.round((prevBarIdx + curBarIdx) / 2.0)
    label lbEq = label.new(midIdx, level, txt, style = isHigh ? label.style_label_down : label.style_label_up, color = color.new(col, 100), textcolor = col, size = size.small)
    array.push(SMC_eqLines, lnEq)
    array.push(SMC_eqLabels, lbEq)

if i_showEQHL and not na(evEqHigh)
    f_drawEQHL(eqHPrevTime, eqHPrevLvl, eqHPrevIdx, evEqHigh.barTime, evEqHigh.barIdx, evEqHigh.price, true)
if i_showEQHL and not na(evEqLow)
    f_drawEQHL(eqLPrevTime, eqLPrevLvl, eqLPrevIdx, evEqLow.barTime, evEqLow.barIdx, evEqLow.price, false)
// Recorte top-N vigente EQH/EQL (§8.2 F7 = P): Operacion deja solo EQ_OP_CAP recientes.
if barstate.islast
    int eqBefore = array.size(SMC_eqLabels)
    int eqKeep = f_famOK(FAM_EST) ? 100000 : EQ_OP_CAP
    while array.size(SMC_eqLabels) > eqKeep
        label.delete(array.shift(SMC_eqLabels))
    while array.size(SMC_eqLines) > eqKeep
        line.delete(array.shift(SMC_eqLines))
    hidEq := eqBefore - array.size(SMC_eqLabels)                                                            // §9-1

// f_drawPools [T09b]: linea horizontal del nivel del pool. VIVO (swept==false): dashed de barTime
// -> barra actual (la liquidez vive hasta ser barrida). BARRIDO (swept==true): dotted tenue de
// barTime -> sweptBarTime (la linea TERMINA en el barrido, Propuesta B; no se extiende a la
// derecha). BSL (sobre highs) ROJO suave = liquidez tomada para VENTAS / SSL (bajo lows) VERDE suave
// = liquidez tomada para COMPRAS (pref. usuario): son lineas de objetivo de precio -> SEMITRANSPARENTES
// (vivo transp 35, barrido 75). Solo touches >= minTouches.
f_drawPools(SMC_Pool p) =>
    bool isBSL = p.dir == DIR_BULL
    col = isBSL ? COL_BSL : COL_SSL
    int xEnd = p.swept ? p.sweptBarTime : time
    line.new(p.barTime, p.level, xEnd, p.level, xloc = xloc.bar_time, color = color.new(col, p.swept ? 75 : 35), style = p.swept ? line.style_dotted : line.style_dashed, width = 1)

// En la ultima barra limpia y repinta las lineas + etiquetas de los pools (vivos + barridos).
var array<line>  SMC_poolLines  = array.new<line>()
var array<label> SMC_poolLabels = array.new<label>()
var int hidPools = 0                                                                                        // §9-1: pools vivos NO-objetivo ocultos en Operacion (§8.2 F8)
if i_showPools and barstate.islast
    for l in SMC_poolLines
        line.delete(l)
    for lb in SMC_poolLabels
        label.delete(lb)
    array.clear(SMC_poolLines)
    array.clear(SMC_poolLabels)
    hidPools := 0
    // §8.2 F8: en Operacion solo el "pool objetivo" por lado (BSL vivo mas cercano arriba, SSL abajo).
    int poolBSLIdx = -1
    int poolSSLIdx = -1
    if array.size(SMC_pools) > 0 and not f_famOK(FAM_EST)
        float bslD = 1e9
        float sslD = 1e9
        for i = 0 to array.size(SMC_pools) - 1
            SMC_Pool pp = array.get(SMC_pools, i)
            if pp.touches >= i_minTouches and not pp.swept
                if pp.dir == DIR_BULL and pp.level >= close and (pp.level - close) < bslD
                    bslD := pp.level - close
                    poolBSLIdx := i
                else if pp.dir == DIR_BEAR and pp.level <= close and (close - pp.level) < sslD
                    sslD := close - pp.level
                    poolSSLIdx := i
    if array.size(SMC_pools) > 0
        for i = 0 to array.size(SMC_pools) - 1
            SMC_Pool p = array.get(SMC_pools, i)
            bool eligible   = p.touches >= i_minTouches and (not p.swept or (i_showSwept and f_famOK(FAM_EST)))   // pools barridos = Estudio+ (§F8)
            bool isObjetivo = f_famOK(FAM_EST) or i == poolBSLIdx or i == poolSSLIdx
            if eligible and not p.swept and not isObjetivo
                hidPools += 1
            if eligible and isObjetivo
                bool isBSL = p.dir == DIR_BULL
                color col = isBSL ? COL_BSL : COL_SSL
                array.push(SMC_poolLines, f_drawPools(p))
                if not p.swept
                    // Etiqueta 2 velas a la derecha del borde (bar_index + 2): margen para que no
                    // quede pegada a la vela (pref. usuario); style_label_left = cuerpo a la derecha.
                    array.push(SMC_poolLabels, label.new(bar_index + 2, p.level, (isBSL ? "BSL ·" : "SSL ·") + str.tostring(p.touches), style = label.style_label_left, color = color.new(col, 80), textcolor = col, size = size.small, xloc = xloc.bar_index))

// Marcadores de sweep (trampa) [T10, Propuesta B]: cada SMC_sweeps es un pool barrido cuyo close
// volvio dentro (trampa). Sweep de BSL = sesgo bajista (rojo, marca arriba); sweep de SSL = sesgo
// alcista (verde, marca abajo). Cuota P4: solo los i_maxShowSweeps mas recientes (anti-saturacion).
// ANCLAJE por xloc.bar_time (sw.barTime), no bar_index: un sweep a >10000 barras de la barra viva
// (historia profunda) reventaba en runtime con xloc.bar_index. bar_time no tiene ese limite (cf.
// lineas de pool y estructura dominante).
var array<label> SMC_sweepLabels = array.new<label>()
if i_showSweeps and barstate.islast
    for lb in SMC_sweepLabels
        label.delete(lb)
    array.clear(SMC_sweepLabels)
    int nSw = array.size(SMC_sweeps)
    if nSw > 0
        int sweepCap = f_famOK(FAM_EST) ? i_maxShowSweeps : 1                                               // Operacion: solo el ultimo sweep/raid (§8.2 F8)
        int firstSw = math.max(0, nSw - sweepCap)
        for i = firstSw to nSw - 1
            SMC_Event sw = array.get(SMC_sweeps, i)
            bool bearTrap = sw.dir == DIR_BEAR
            color scol = bearTrap ? COL_BEAR : COL_BULL
            // Subtipo refinado [T24 · §3.7]: Raid (pool alta liquidez) / Spring (sweep alcista en minimo
            // de rango) / sweep simple. El texto distingue los tres; el color sigue el sesgo del sweep.
            string sbase = sw.kind == KIND_RAID ? "⚡ Raid" : sw.kind == KIND_SPRING ? "⇧ Spring" : "✗ Sweep"
            string stxt = sbase + (bearTrap ? " ↓" : " ↑")
            array.push(SMC_sweepLabels, label.new(sw.barTime, sw.price, stxt, style = bearTrap ? label.style_label_down : label.style_label_up, color = color.new(scol, 70), textcolor = scol, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de Displacement [T16 · §4.1]. Mismo patron repintado-en-islast que los sweeps
// (objetos acotados a i_maxShowDisp). Naranja: lo distingue del teal/rojo de estructura y del
// verde/rojo de sweep. La direccion va en la flecha del texto (↑/↓). Se DESPLAZA ~3 barras a la
// DERECHA de la vela (dispOffMs = 3*duracion de barra, en bar_time) + style_label_left -> la
// etiqueta flota despejada y NO la tapa la vela (pref. usuario, igual filosofia que los pools
// que usan bar_index+2). Anclado por bar_time (robusto en spans largos / historia profunda).
var array<label> SMC_dispLabels = array.new<label>()
if i_showDisp and f_famOK(FAM_EST) and barstate.islast                                                      // Displacement = Estudio+ (§F2)
    for lb in SMC_dispLabels
        label.delete(lb)
    array.clear(SMC_dispLabels)
    int dispOffMs = 3 * (time - time[1])
    int nD = array.size(SMC_displacements)
    if nD > 0
        int firstD = math.max(0, nD - i_maxShowDisp)
        for i = firstD to nD - 1
            SMC_Event dp = array.get(SMC_displacements, i)
            bool bull = dp.dir == DIR_BULL
            string dtxt = bull ? "⚡ Disp ↑" : "⚡ Disp ↓"
            array.push(SMC_dispLabels, label.new(dp.barTime + dispOffMs, dp.price, dtxt, style = label.style_label_left, color = color.new(COL_FVG, 75), textcolor = COL_FVG, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de IDM [T17 · §3.6]. Mismo patron repintado-en-islast (acotado a i_maxShowIDM).
// VIOLETA (familia liquidez, §5.2, COL_LIQ). Direccion en la
// flecha (↑/↓). Se DESPLAZA ~3 barras a la DERECHA (idmOffMs) + style_label_left -> flota
// despejado, no lo tapa la vela (igual que displacement y los pools).
var array<label> SMC_idmLabels = array.new<label>()
if i_showIDM and f_famOK(FAM_EST) and barstate.islast                                                       // IDM = Estudio+ (§F8)
    for lb in SMC_idmLabels
        label.delete(lb)
    array.clear(SMC_idmLabels)
    int idmOffMs = 3 * (time - time[1])
    int nI = array.size(SMC_idm)
    if nI > 0
        int firstI = math.max(0, nI - i_maxShowIDM)
        for i = firstI to nI - 1
            SMC_Event im = array.get(SMC_idm, i)
            bool bullIdm = im.dir == DIR_BULL
            string itxt = bullIdm ? "IDM ↑" : "IDM ↓"
            array.push(SMC_idmLabels, label.new(im.barTime + idmOffMs, im.price, itxt, style = label.style_label_left, color = color.new(COL_LIQ, 75), textcolor = COL_LIQ, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de Immediate Rebalance [T29 · §5.4]. Mismo patron repintado-en-islast (acotado a
// i_maxShowIR). NARANJA (familia imbalance, §5.2, COL_FVG). Anclado al 50% de la vela de impulso rebalanceada;
// desplazado ~3 barras a la derecha (no tapa la vela). La flecha marca el dir del impulso.
var array<label> SMC_irLabels = array.new<label>()
if i_showIR and f_famOK(FAM_EST) and barstate.islast                                                        // IR = Estudio+ (§F4)
    for lb in SMC_irLabels
        label.delete(lb)
    array.clear(SMC_irLabels)
    int irOffMs = 3 * (time - time[1])
    int nIR = array.size(SMC_ir)
    if nIR > 0
        int firstIR = math.max(0, nIR - i_maxShowIR)
        for i = firstIR to nIR - 1
            SMC_Event ir = array.get(SMC_ir, i)
            bool bullIr = ir.dir == DIR_BULL
            string irtxt = bullIr ? "IR ↑" : "IR ↓"
            array.push(SMC_irLabels, label.new(ir.barTime + irOffMs, ir.price, irtxt, style = label.style_label_left, color = color.new(COL_FVG, 70), textcolor = COL_FVG, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de CISD [T32 · §5.6]. Mismo patron repintado-en-islast (acotado a i_maxShowCISD). Cambio de
// estado de entrega anclado al origen del run roto. Direccional teal/rojo (familia estructura, §5.2), flecha por dir.
var array<label> SMC_cisdLabels = array.new<label>()
if i_showCISD and f_famOK(FAM_EST) and barstate.islast                                                      // CISD = Estudio+ (§F1)
    for lb in SMC_cisdLabels
        label.delete(lb)
    array.clear(SMC_cisdLabels)
    int nC = array.size(SMC_cisd)
    if nC > 0
        int firstC = math.max(0, nC - i_maxShowCISD)
        for i = firstC to nC - 1
            SMC_Event ce = array.get(SMC_cisd, i)
            bool bullC = ce.dir == DIR_BULL
            string ctxt = bullC ? "CISD ↑" : "CISD ↓"
            array.push(SMC_cisdLabels, label.new(ce.barTime, ce.price, ctxt, style = bullC ? label.style_label_up : label.style_label_down, color = color.new(bullC ? COL_BULL : COL_BEAR, 65), textcolor = bullC ? COL_BULL : COL_BEAR, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de SMT Divergence [T38 · §5.13]. Mismo patron repintado-en-islast (acotado a i_maxShowSMT).
// Divergencia con el par correlacionado (senal de calidad alta). NARANJA fuerte, flecha por dir real.
var array<label> SMC_smtLabels = array.new<label>()
if i_smtEnable and barstate.islast
    for lb in SMC_smtLabels
        label.delete(lb)
    array.clear(SMC_smtLabels)
    int nS = array.size(SMC_smt)
    if nS > 0
        int firstS = math.max(0, nS - i_maxShowSMT)
        for i = firstS to nS - 1
            SMC_Event se = array.get(SMC_smt, i)
            bool bullS = se.dir == DIR_BULL
            string stxt = bullS ? "SMT ↑" : "SMT ↓"
            array.push(SMC_smtLabels, label.new(se.barTime, se.price, stxt, style = bullS ? label.style_label_up : label.style_label_down, color = color.new(bullS ? COL_BULL : COL_BEAR, 55), textcolor = color.white, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de Judas [T18 · §3.5]. Mismo patron repintado-en-islast (acotado a i_maxShowJudas).
// Fucsia: lo distingue del naranja (displacement), amarillo (IDM) y verde/rojo (sweep). La trampa de
// apertura de sesion (sweep en 1a mitad de KZ + displacement contrario). VIOLETA (familia liquidez, §5.2). Direccion REAL en la flecha
// (↑/↓), anclado al nivel barrido (origen de la trampa) en la barra del displacement. Se DESPLAZA ~3
// barras a la DERECHA (judasOffMs) + style_label_left -> flota despejado, no lo tapa la vela.
var array<label> SMC_judasLabels = array.new<label>()
if i_showJudas and f_famOK(FAM_EST) and barstate.islast                                                     // Judas = Estudio+ (§F8)
    for lb in SMC_judasLabels
        label.delete(lb)
    array.clear(SMC_judasLabels)
    int judasOffMs = 3 * (time - time[1])
    int nJ = array.size(SMC_judas)
    if nJ > 0
        int firstJ = math.max(0, nJ - i_maxShowJudas)
        for i = firstJ to nJ - 1
            SMC_Event jd = array.get(SMC_judas, i)
            bool bullJudas = jd.dir == DIR_BULL
            string jtxt = bullJudas ? "Judas ↑" : "Judas ↓"
            array.push(SMC_judasLabels, label.new(jd.barTime + judasOffMs, jd.price, jtxt, style = label.style_label_left, color = color.new(COL_LIQ, 70), textcolor = COL_LIQ, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de Rejection [T20 · §2.7]. Mismo patron repintado-en-islast (acotado a i_maxShowRej).
// AQUA: lo distingue del naranja (disp), amarillo (IDM), fucsia (Judas) y verde/rojo (sweep). Anclado
// VIOLETA (familia liquidez, §5.2). Anclado a la PUNTA de la mecha rechazada (low alcista / high bajista), apuntando hacia la vela (label_up
// alcista debajo del low / label_down bajista sobre el high). La flecha del texto marca la direccion.
var array<label> SMC_rejLabels = array.new<label>()
if i_showRej and f_famOK(FAM_EST) and barstate.islast                                                       // Rejections = Estudio+ (§F2)
    for lb in SMC_rejLabels
        label.delete(lb)
    array.clear(SMC_rejLabels)
    int nR = array.size(SMC_rejections)
    if nR > 0
        int firstR = math.max(0, nR - i_maxShowRej)
        for i = firstR to nR - 1
            SMC_Event rj = array.get(SMC_rejections, i)
            bool bullRej = rj.dir == DIR_BULL
            string rtxt = bullRej ? "Rej ↑" : "Rej ↓"
            array.push(SMC_rejLabels, label.new(rj.barTime, rj.price, rtxt, style = bullRej ? label.style_label_up : label.style_label_down, color = color.new(COL_LIQ, 70), textcolor = COL_LIQ, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de Flip [T21 · §2.8]. Mismo patron repintado-en-islast (acotado a i_maxShowFlip). Nivel
// confirmado de cambio de rol (soporte<->resistencia). Linea horizontal corta al nivel + etiqueta
// 'FLIP ↑/↓' (alcista = nivel paso a SOPORTE; bajista = a RESISTENCIA). Direccional teal/rojo (familia estructura, §5.2), lo distingue del
// resto. Anclado por bar_time desde la barra de confirmacion, extendido a la derecha.
var array<line>  SMC_flipLines  = array.new<line>()
var array<label> SMC_flipLabels = array.new<label>()
if i_showFlip and barstate.islast
    for l in SMC_flipLines
        line.delete(l)
    for lb in SMC_flipLabels
        label.delete(lb)
    array.clear(SMC_flipLines)
    array.clear(SMC_flipLabels)
    int nF = array.size(SMC_flipEvents)
    if nF > 0
        int flipCap = f_famOK(FAM_EST) ? i_maxShowFlip : 2                                                  // Operacion: solo flips vigentes (§8.2 F1 flips-P)
        int firstF = math.max(0, nF - flipCap)
        int flipOffMs = 8 * (time - time[1])
        for i = firstF to nF - 1
            SMC_Event fp = array.get(SMC_flipEvents, i)
            bool bullFlip = fp.dir == DIR_BULL
            color fcol = color.new(bullFlip ? COL_BULL : COL_BEAR, 35)
            array.push(SMC_flipLines, line.new(fp.barTime, fp.price, fp.barTime + flipOffMs, fp.price, xloc = xloc.bar_time, color = fcol, style = line.style_solid, width = 1))
            string ftxt = bullFlip ? "FLIP ↑" : "FLIP ↓"
            array.push(SMC_flipLabels, label.new(fp.barTime + flipOffMs, fp.price, ftxt, style = label.style_label_left, color = color.new(bullFlip ? COL_BULL : COL_BEAR, 80), textcolor = bullFlip ? COL_BULL : COL_BEAR, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de rebote en EMA [T23 · §4.3 #41]. Mismo patron repintado-en-islast (acotado a
// i_maxShowRej por reuso del cap de eventos puntuales). El precio toco una EMA y cerro de vuelta con
// mecha en la direccion de la tendencia. Direccional teal/rojo (§5.2), marca en la punta de la mecha.
var array<label> SMC_emaBounceLabels = array.new<label>()
if i_showEmaBounce and f_famOK(FAM_EST) and barstate.islast                                                 // Rebote EMA = Estudio+ (§F2)
    for lb in SMC_emaBounceLabels
        label.delete(lb)
    array.clear(SMC_emaBounceLabels)
    int nB = array.size(SMC_emaBounces)
    if nB > 0
        int firstB = math.max(0, nB - i_maxShowRej)
        for i = firstB to nB - 1
            SMC_Event bo = array.get(SMC_emaBounces, i)
            bool bullBo = bo.dir == DIR_BULL
            string botxt = bullBo ? "↩ EMA ↑" : "↩ EMA ↓"
            array.push(SMC_emaBounceLabels, label.new(bo.barTime, bo.price, botxt, style = bullBo ? label.style_label_up : label.style_label_down, color = color.new(bullBo ? COL_BULL : COL_BEAR, 70), textcolor = bullBo ? COL_BULL : COL_BEAR, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de cruce de EMA por par [T23 · §4.3]. Punto pequeno con la etiqueta del par (la dir va en
// color: ↑ azul claro / ↓ gris-azul). Todos los cruces dejan seña para verlos y contabilizarlos.
var array<label> SMC_emaCrossLabels = array.new<label>()
if i_showEmaCross and f_famOK(FAM_EST) and barstate.islast                                                  // Cruce EMA = Estudio+ (§F2)
    for lb in SMC_emaCrossLabels
        label.delete(lb)
    array.clear(SMC_emaCrossLabels)
    int nX = array.size(SMC_emaCrosses)
    if nX > 0
        int firstX = math.max(0, nX - i_maxShowEmaX)
        for i = firstX to nX - 1
            SMC_Event xe = array.get(SMC_emaCrosses, i)
            bool bx = xe.dir == DIR_BULL
            color xcol = color.new(COL_GHOST, 55)
            array.push(SMC_emaCrossLabels, label.new(xe.barTime, xe.price, "× " + xe.tf, style = label.style_label_center, color = color.new(color.gray, 100), textcolor = xcol, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de Stack Flip [T23 · §4.3]. Evento de cambio de regimen (20 y 50 cruzan la 200): seña
// reforzada. Verde (alcista) / rojo (bajista), recuadro visible para distinguirlo del cruce de par.
var array<label> SMC_emaStackLabels = array.new<label>()
if i_showEmaStack and f_famOK(FAM_EST) and barstate.islast                                                  // Stack Flip EMA = Estudio+ (§F2)
    for lb in SMC_emaStackLabels
        label.delete(lb)
    array.clear(SMC_emaStackLabels)
    int nS = array.size(SMC_emaStacks)
    if nS > 0
        int firstS = math.max(0, nS - i_maxShowEmaX)
        for i = firstS to nS - 1
            SMC_Event se = array.get(SMC_emaStacks, i)
            bool bs = se.dir == DIR_BULL
            color scol2 = bs ? COL_BULL : COL_BEAR
            string stxt2 = bs ? "⊗ Stack ↑" : "⊗ Stack ↓"
            array.push(SMC_emaStackLabels, label.new(se.barTime, se.price, stxt2, style = bs ? label.style_label_up : label.style_label_down, color = color.new(scol2, 60), textcolor = color.white, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de False Breakout [T24 · §3.7 #14]. Mismo patron repintado-en-islast (acotado a i_maxShowFB).
// La direccion es la REVERSION (la real): FB alcista (rompio abajo y volvio) marca abajo; bajista marca
// arriba. Direccional teal/rojo (la reversion, familia estructura §5.2), anclado al nivel roto en la barra de confirmacion del retorno.
var array<label> SMC_fbLabels = array.new<label>()
if i_showFalseBreak and f_famOK(FAM_EST) and barstate.islast                                                // False Break = Estudio+ (§F1)
    for lb in SMC_fbLabels
        label.delete(lb)
    array.clear(SMC_fbLabels)
    int nFB = array.size(SMC_fbreakEvents)
    if nFB > 0
        int firstFB = math.max(0, nFB - i_maxShowFB)
        for i = firstFB to nFB - 1
            SMC_Event fbe = array.get(SMC_fbreakEvents, i)
            bool bullFB = fbe.dir == DIR_BULL
            string fbtxt = bullFB ? "FB ↑" : "FB ↓"
            array.push(SMC_fbLabels, label.new(fbe.barTime, fbe.price, fbtxt, style = bullFB ? label.style_label_up : label.style_label_down, color = color.new(bullFB ? COL_BULL : COL_BEAR, 70), textcolor = bullFB ? COL_BULL : COL_BEAR, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de tramo Impulsivo/Correctivo [T25 · §4.4]. Mismo patron repintado-en-islast (acotado a
// i_maxShowLegs). IMP = expansion (displacement + ruptura alineada/MSS) -> verde/rojo segun dir, fuerte;
// CORR = retroceso contra-sesgo -> gris tenue. Anclado a la barra de la ruptura. Desplazado ~5 barras a
// la derecha (legOffMs) + style_label_left -> no tapa la vela. Registra QUE/DONDE paso (pref. usuario).
var array<label> SMC_legLabels = array.new<label>()
if i_showLegs and f_famOK(FAM_EST) and barstate.islast                                                      // tramos IMP/CORR = Estudio+ (§F2)
    for lb in SMC_legLabels
        label.delete(lb)
    array.clear(SMC_legLabels)
    int nL = array.size(SMC_legs)
    if nL > 0
        int firstL = math.max(0, nL - i_maxShowLegs)
        int legOffMs = 5 * (time - time[1])
        for i = firstL to nL - 1
            SMC_Event lg = array.get(SMC_legs, i)
            bool impulsive = lg.kind == KIND_IMPULSIVE
            bool bullLeg = lg.dir == DIR_BULL
            color lcol = impulsive ? (bullLeg ? COL_BULL : COL_BEAR) : COL_GHOST
            string ltxt = (impulsive ? "IMP " : "CORR ") + (bullLeg ? "↑" : "↓")
            array.push(SMC_legLabels, label.new(lg.barTime + legOffMs, lg.price, ltxt, style = label.style_label_left, color = color.new(lcol, 75), textcolor = lcol, size = size.tiny, xloc = xloc.bar_time))

// Marcadores de Inside Day [T37 · §5.12]. Compresion D1 -> etiqueta gris "ID" en el medio del rango
// interior, anclada al dia. Acotado a i_maxShowID, repintado-en-islast.
var array<label> SMC_idLabels = array.new<label>()
if i_showInsideDay and f_famOK(FAM_EST) and barstate.islast                                                 // Inside Day = Estudio+ (§F2)
    for lb in SMC_idLabels
        label.delete(lb)
    array.clear(SMC_idLabels)
    int nID = array.size(SMC_insideDays)
    if nID > 0
        int firstID = math.max(0, nID - i_maxShowID)
        for i = firstID to nID - 1
            SMC_Event idv = array.get(SMC_insideDays, i)
            array.push(SMC_idLabels, label.new(idv.barTime, idv.price, "ID", style = label.style_label_down, color = color.new(COL_GHOST, 65), textcolor = color.white, size = size.tiny, xloc = xloc.bar_time))

// Proyeccion Standard Deviation [T36 · §5.11] (solo Visual): objetivos de CONTINUACION de la pierna
// dominante (rango operativo trailing). A=origen / B=extremo segun el sesgo dominante (bajista: top->bottom;
// alcista: bottom->top). Lineas punteadas grises extendidas a la derecha + etiqueta del multiplo. Es una
// HERRAMIENTA (no confluencia): proyecta TPs. Off por defecto.
var array<line>  SMC_stdLines  = array.new<line>()
var array<label> SMC_stdLabels = array.new<label>()
if i_showStdDev and barstate.islast
    for l in SMC_stdLines
        line.delete(l)
    for lb in SMC_stdLabels
        label.delete(lb)
    array.clear(SMC_stdLines)
    array.clear(SMC_stdLabels)
    if structMajor.bias != 0 and not na(trailing.top) and not na(trailing.bottom) and trailing.top > trailing.bottom
        float aAnchor = structMajor.bias == DIR_BEAR ? trailing.top : trailing.bottom
        float bAnchor = structMajor.bias == DIR_BEAR ? trailing.bottom : trailing.top
        array<float> stdMults = array.from(i_stdMult1, i_stdMult2, i_stdMult3, i_stdMult4)
        for m in stdMults
            float lvl = f_projStdDev(aAnchor, bAnchor, m)
            array.push(SMC_stdLines, line.new(bar_index - 1, lvl, bar_index, lvl, xloc = xloc.bar_index, color = color.new(COL_GHOST, 40), style = line.style_dotted, width = 1, extend = extend.right))
            array.push(SMC_stdLabels, label.new(bar_index, lvl, "σ" + str.tostring(m), style = label.style_label_left, color = color.new(COL_GHOST, 88), textcolor = COL_GHOST, size = size.tiny, xloc = xloc.bar_index))
// f_drawOB: caja del Order Block coloreada por estado [T05] (solo Visual). Origen =
// vela del OB; se extiende a la derecha hasta la barra actual (la zona vive; el
// origen no repinta). Alcista/bajista por TONO del AZUL de familia (§5.2, COL_OB_BULL/BEAR);
// el label + la forma lo separan de la estructura. Transparencia por estado: activa solida,
// parcial mas tenue, mitigada gris. La invalida no se dibuja (pasa a breaker en su tarea).
f_drawOB(SMC_Zone z) =>
    col = z.dir == DIR_BULL ? COL_OB_BULL : COL_OB_BEAR
    int transp = z.state == ZS_ACTIVE ? 75 : z.state == ZS_PARTIAL ? 83 : 90
    color bg = z.state == ZS_MITIGATED ? color.new(color.gray, 90) : color.new(col, transp)
    box.new(left = z.barIdx, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = bg, border_color = color.new(col, 50), border_width = 1, xloc = xloc.bar_index)

// En la ultima barra limpia y repinta las cajas vivas (evita acumulacion por tick).
// Cajas <= MAX_ZONES. Las zonas mitigadas se muestran tenues; las invalidadas se
// omiten (su rol pasa a breaker en §Tier2).
var array<box>   SMC_obBoxes  = array.new<box>()
var array<label> SMC_obLabels = array.new<label>()
if i_showOB and barstate.islast
    for b in SMC_obBoxes
        box.delete(b)
    for lb in SMC_obLabels
        label.delete(lb)
    array.clear(SMC_obBoxes)
    array.clear(SMC_obLabels)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            if z.kind == KIND_OB and z.state != ZS_INVALID and f_densOK(z.strength, i == anchorHiIdx or i == anchorLoIdx)
                array.push(SMC_obBoxes, f_drawOB(z))
                // Nombre del OB (pref. usuario): texto CENTRADO dentro de la caja (medio
                // horizontal entre origen y barra actual, medio vertical), sin recuadro.
                color obCol = z.dir == DIR_BULL ? COL_OB_BULL : COL_OB_BEAR
                // Propulsion [T34]: OB de continuacion anidado -> etiqueta "OB⇈" (mayor peso) vs "OB".
                string obTxt = z.propulsion ? "OB⇈" : "OB"
                array.push(SMC_obLabels, label.new(math.round((z.barIdx + bar_index) / 2.0), (z.top + z.bottom) / 2.0, obTxt, style = label.style_label_center, color = color.new(color.gray, 100), textcolor = obCol, size = size.small, xloc = xloc.bar_index))

// f_drawBreaker: caja del Breaker [T19 · §2.6] (solo Visual). Un OB invalidado renacido con polaridad
// invertida. AZUL de familia (§5.2, como el OB) distinguido por borde PUNTEADO + label BRK; borde
// PUNTEADO (re-rol, no zona original). dir = la NUEVA direccion (resistencia bajista / soporte alcista).
// left = origen del OB padre (se conserva en barIdx); se extiende a la derecha hasta la barra actual.
f_drawBreaker(SMC_Zone z) =>
    col = z.dir == DIR_BULL ? COL_OB_BULL : COL_OB_BEAR
    int transp = z.state == ZS_ACTIVE ? 78 : z.state == ZS_PARTIAL ? 85 : 91
    color bg = z.state == ZS_MITIGATED ? color.new(color.gray, 91) : color.new(col, transp)
    box.new(left = z.barIdx, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = bg, border_color = color.new(col, 45), border_width = 1, border_style = line.style_dashed, xloc = xloc.bar_index)

// En la ultima barra limpia y repinta las cajas de breaker vivas (KIND_BREAKER, no invalidadas).
var array<box>   SMC_brkBoxes  = array.new<box>()
var array<label> SMC_brkLabels = array.new<label>()
if i_showBreaker and barstate.islast
    for b in SMC_brkBoxes
        box.delete(b)
    for lb in SMC_brkLabels
        label.delete(lb)
    array.clear(SMC_brkBoxes)
    array.clear(SMC_brkLabels)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            if z.kind == KIND_BREAKER and z.state != ZS_INVALID and f_densOK(z.strength, i == anchorHiIdx or i == anchorLoIdx)
                array.push(SMC_brkBoxes, f_drawBreaker(z))
                color brkCol = z.dir == DIR_BULL ? COL_OB_BULL : COL_OB_BEAR
                string brkTxt = z.dir == DIR_BULL ? "BRK ↑" : "BRK ↓"
                array.push(SMC_brkLabels, label.new(math.round((z.barIdx + bar_index) / 2.0), (z.top + z.bottom) / 2.0, brkTxt, style = label.style_label_center, color = color.new(color.gray, 100), textcolor = brkCol, size = size.small, xloc = xloc.bar_index))

// f_drawIFVG: caja del Inversion FVG [T27 · §5.2] (solo Visual). Un FVG invalidado renacido con
// polaridad invertida. NARANJA de familia (§5.2, como el FVG) con borde PUNTEADO + label IFVG para
// distinguirlo. dir = la NUEVA direccion. Origen = vela del FVG padre; se extiende a la barra actual.
f_drawIFVG(SMC_Zone z) =>
    col = z.dir == DIR_BULL ? COL_FVG_BULL : COL_FVG_BEAR
    int transp = z.state == ZS_ACTIVE ? 80 : z.state == ZS_PARTIAL ? 86 : 92
    color bg = z.state == ZS_MITIGATED ? color.new(color.gray, 92) : color.new(col, transp)
    box.new(left = z.barIdx, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = bg, border_color = color.new(col, 50), border_width = 1, border_style = line.style_dashed, xloc = xloc.bar_index)

// En la ultima barra limpia y repinta las cajas IFVG vivas (KIND_IFVG, no invalidadas).
var array<box>   SMC_ifvgBoxes  = array.new<box>()
var array<label> SMC_ifvgLabels = array.new<label>()
if i_showIFVG and barstate.islast
    for b in SMC_ifvgBoxes
        box.delete(b)
    for lb in SMC_ifvgLabels
        label.delete(lb)
    array.clear(SMC_ifvgBoxes)
    array.clear(SMC_ifvgLabels)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            if z.kind == KIND_IFVG and z.state != ZS_INVALID and f_densOK(z.strength, false)
                array.push(SMC_ifvgBoxes, f_drawIFVG(z))
                color ifvgCol = z.dir == DIR_BULL ? COL_FVG_BULL : COL_FVG_BEAR
                array.push(SMC_ifvgLabels, label.new(math.round((z.barIdx + bar_index) / 2.0), (z.top + z.bottom) / 2.0, "IFVG", style = label.style_label_center, color = color.new(color.gray, 100), textcolor = ifvgCol, size = size.small, xloc = xloc.bar_index))

// f_drawBPR: caja del Balanced Price Range [T28 · §5.3] (solo Visual). Interseccion de FVG opuestos =
// zona de reaccion fuerte. NARANJA de familia (§5.2, base; es bidireccional), borde solido + label BPR
// para distinguirla del FVG/IFVG. Origen = barra de creacion; se extiende a la barra actual.
f_drawBPR(SMC_Zone z) =>
    col = COL_FVG
    int transp = z.state == ZS_ACTIVE ? 78 : z.state == ZS_PARTIAL ? 85 : 91
    color bg = z.state == ZS_MITIGATED ? color.new(color.gray, 91) : color.new(col, transp)
    box.new(left = z.barIdx, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = bg, border_color = color.new(col, 45), border_width = 1, xloc = xloc.bar_index)

// En la ultima barra limpia y repinta las cajas BPR vivas (KIND_BPR, no invalidadas).
var array<box>   SMC_bprBoxes  = array.new<box>()
var array<label> SMC_bprLabels = array.new<label>()
if i_showBPR and barstate.islast
    for b in SMC_bprBoxes
        box.delete(b)
    for lb in SMC_bprLabels
        label.delete(lb)
    array.clear(SMC_bprBoxes)
    array.clear(SMC_bprLabels)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            if z.kind == KIND_BPR and z.state != ZS_INVALID and f_famOK(FAM_EST) and f_densOK(z.strength, false)
                array.push(SMC_bprBoxes, f_drawBPR(z))
                array.push(SMC_bprLabels, label.new(math.round((z.barIdx + bar_index) / 2.0), (z.top + z.bottom) / 2.0, "BPR", style = label.style_label_center, color = color.new(color.gray, 100), textcolor = COL_FVG, size = size.small, xloc = xloc.bar_index))

// Cajas de Volume Imbalance [T31 · §5.5] (solo Visual). Micro -> cajitas finas violeta tenue, solo las
// i_maxShowVI mas recientes vivas (P4 present-mode, anti-saturacion). Off por defecto (i_showVI false:
// son muchas; se encienden para inspeccion). Anclado por bar_index.
var array<box> SMC_viBoxes = array.new<box>()
if i_showVI and barstate.islast
    for b in SMC_viBoxes
        box.delete(b)
    array.clear(SMC_viBoxes)
    int nVI = array.size(SMC_vi)
    if nVI > 0
        int firstVI = math.max(0, nVI - i_maxShowVI)
        for i = firstVI to nVI - 1
            SMC_Zone z = array.get(SMC_vi, i)
            if z.state != ZS_INVALID and f_famOK(FAM_TODO) and f_densOK(z.strength, false)
                color vcol = z.dir == DIR_BULL ? COL_FVG_BULL : COL_FVG_BEAR
                int vtransp = z.state == ZS_MITIGATED ? 92 : 82
                array.push(SMC_viBoxes, box.new(left = z.barIdx, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = color.new(vcol, vtransp), border_color = color.new(vcol, 60), border_width = 1, xloc = xloc.bar_index))

// Niveles de gap de apertura [T30 · §5.10] (solo Visual): NWOG/NDOG/NYMO en NARANJA (familia opening-gaps
// §5.2, COL_FVG; se distinguen por el label) como lineas S/R desde su ancla hasta ahora. Marcadores Breakaway
// (BAG ↑/↓) acotados a i_maxShowBag. Repintado-en-islast.
var array<line>  SMC_ogLines  = array.new<line>()
var array<label> SMC_ogLabels = array.new<label>()
if i_showOpenGaps and barstate.islast
    for l in SMC_ogLines
        line.delete(l)
    for lb in SMC_ogLabels
        label.delete(lb)
    array.clear(SMC_ogLines)
    array.clear(SMC_ogLabels)
    if not na(nwogLvl)
        array.push(SMC_ogLines, line.new(nwogT, nwogLvl, time, nwogLvl, xloc = xloc.bar_time, color = color.new(COL_FVG, 30), style = line.style_dashed, width = 1))
        array.push(SMC_ogLabels, label.new(time, nwogLvl, "NWOG", style = label.style_label_left, color = color.new(COL_FVG, 85), textcolor = COL_FVG, size = size.tiny, xloc = xloc.bar_time))
    if not na(ndogLvl)
        array.push(SMC_ogLines, line.new(ndogT, ndogLvl, time, ndogLvl, xloc = xloc.bar_time, color = color.new(COL_FVG, 30), style = line.style_dashed, width = 1))
        array.push(SMC_ogLabels, label.new(time, ndogLvl, "NDOG", style = label.style_label_left, color = color.new(COL_FVG, 85), textcolor = COL_FVG, size = size.tiny, xloc = xloc.bar_time))
    if not na(nymoLvl)
        array.push(SMC_ogLines, line.new(nymoT, nymoLvl, time, nymoLvl, xloc = xloc.bar_time, color = color.new(COL_FVG, 30), style = line.style_dashed, width = 1))
        array.push(SMC_ogLabels, label.new(time, nymoLvl, "NYMO", style = label.style_label_left, color = color.new(COL_FVG, 85), textcolor = COL_FVG, size = size.tiny, xloc = xloc.bar_time))
    int nBag = array.size(SMC_bag)
    if nBag > 0 and f_famOK(FAM_EST)                                                                        // Breakaway BAG = Estudio+ (§F4); las lineas NWOG/NDOG/NYMO (gaps-P) SI van en Operacion
        int firstBag = math.max(0, nBag - i_maxShowBag)
        for i = firstBag to nBag - 1
            SMC_Event bg = array.get(SMC_bag, i)
            bool bullBag = bg.dir == DIR_BULL
            string bagtxt = bullBag ? "BAG ↑" : "BAG ↓"
            array.push(SMC_ogLabels, label.new(bg.barTime, bg.price, bagtxt, style = bullBag ? label.style_label_up : label.style_label_down, color = color.new(COL_FVG, 65), textcolor = color.white, size = size.tiny, xloc = xloc.bar_time))

// f_drawMB: caja del Mitigation Block [T-mb · §2.8] (solo Visual). Relleno de desequilibrio sin barrido.
// AZUL de familia (§5.2, como OB) distinguido por borde PUNTEADO + label MB. Origen = vela del bloque;
// se extiende a la derecha hasta la barra actual. Transparencia por estado; la invalidada no se dibuja.
f_drawMB(SMC_Zone z) =>
    col = z.dir == DIR_BULL ? COL_OB_BULL : COL_OB_BEAR
    int transp = z.state == ZS_ACTIVE ? 80 : z.state == ZS_PARTIAL ? 86 : 92
    color bg = z.state == ZS_MITIGATED ? color.new(color.gray, 92) : color.new(col, transp)
    box.new(left = z.barIdx, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = bg, border_color = color.new(col, 50), border_width = 1, border_style = line.style_dotted, xloc = xloc.bar_index)

// En la ultima barra limpia y repinta las cajas de mitigation block vivas (KIND_MITIGATION, no invalidadas).
var array<box>   SMC_mbBoxes  = array.new<box>()
var array<label> SMC_mbLabels = array.new<label>()
if i_showMB and barstate.islast
    for b in SMC_mbBoxes
        box.delete(b)
    for lb in SMC_mbLabels
        label.delete(lb)
    array.clear(SMC_mbBoxes)
    array.clear(SMC_mbLabels)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            if z.kind == KIND_MITIGATION and z.state != ZS_INVALID and f_famOK(FAM_EST) and f_densOK(z.strength, false)
                array.push(SMC_mbBoxes, f_drawMB(z))
                color mbCol = z.dir == DIR_BULL ? COL_OB_BULL : COL_OB_BEAR
                array.push(SMC_mbLabels, label.new(math.round((z.barIdx + bar_index) / 2.0), (z.top + z.bottom) / 2.0, "MB", style = label.style_label_center, color = color.new(color.gray, 100), textcolor = mbCol, size = size.small, xloc = xloc.bar_index))

// Cajas de Vacuum Block [T33 · §5.7] (solo Visual). Vacio de apertura (gap grande) = iman de retorno.
// AZUL de familia (§5.2, base COL_OB), borde punteado. No invalidada. Origen = barra del gap; se extiende a la actual.
var array<box>   SMC_vacBoxes  = array.new<box>()
var array<label> SMC_vacLabels = array.new<label>()
if i_showVacuum and barstate.islast
    for b in SMC_vacBoxes
        box.delete(b)
    for lb in SMC_vacLabels
        label.delete(lb)
    array.clear(SMC_vacBoxes)
    array.clear(SMC_vacLabels)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            if z.kind == KIND_VACUUM and z.state != ZS_INVALID and f_famOK(FAM_EST) and f_densOK(z.strength, false)
                color vacc = z.state == ZS_MITIGATED ? color.new(color.gray, 92) : color.new(COL_OB, 84)
                array.push(SMC_vacBoxes, box.new(left = z.barIdx, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = vacc, border_color = color.new(COL_OB, 45), border_width = 1, border_style = line.style_dotted, xloc = xloc.bar_index))
                array.push(SMC_vacLabels, label.new(math.round((z.barIdx + bar_index) / 2.0), (z.top + z.bottom) / 2.0, "VAC", style = label.style_label_center, color = color.new(color.gray, 100), textcolor = COL_OB, size = size.small, xloc = xloc.bar_index))

// Zona IPR vigente [T35 · §5.9] (solo Visual): rango desbalanceado (contexto de bias). Borde fino sin
// relleno (es contexto, no zona de entrada), color por dir. Solo la actual (currentIpr), repintada-en-islast.
var box   SMC_iprBox = na
var label SMC_iprLbl = na
if i_showIPR and barstate.islast
    box.delete(SMC_iprBox)
    label.delete(SMC_iprLbl)
    if not na(currentIpr) and f_famOK(FAM_TODO) and f_densOK(currentIpr.strength, false)
        color iprc = currentIpr.dir == DIR_BULL ? COL_FVG_BULL : COL_FVG_BEAR
        SMC_iprBox := box.new(left = currentIpr.barIdx - i_iprWindow, top = currentIpr.top, right = bar_index, bottom = currentIpr.bottom, bgcolor = color.new(iprc, 95), border_color = color.new(iprc, 40), border_width = 1, border_style = line.style_dotted, xloc = xloc.bar_index)
        SMC_iprLbl := label.new(bar_index, currentIpr.dir == DIR_BULL ? currentIpr.top : currentIpr.bottom, "IPR", style = label.style_label_left, color = color.new(iprc, 85), textcolor = iprc, size = size.tiny, xloc = xloc.bar_index)

// f_drawFVG: caja del Fair Value Gap coloreada por estado [T06] (solo Visual). left =
// vela media (z.barIdx-1, cf. LuxAlgo lastTime=time[1]) para cubrir el desplazamiento
// que crea el gap; se extiende a la derecha hasta la barra actual (la zona vive). FVG
// alcista/bajista por TONO del NARANJA de familia (§5.2, COL_FVG_BULL/BEAR). Transparencia por
// estado (activa solida, parcial mas tenue, mitigada gris). La invalida no se dibuja.
// La linea CE (50%) se dibuja aparte en el loop (nivel de entrada de referencia #26).
f_drawFVG(SMC_Zone z) =>
    col = z.dir == DIR_BULL ? COL_FVG_BULL : COL_FVG_BEAR
    int transp = z.state == ZS_ACTIVE ? 80 : z.state == ZS_PARTIAL ? 86 : 92
    color bg = z.state == ZS_MITIGATED ? color.new(color.gray, 92) : color.new(col, transp)
    box.new(left = z.barIdx - 1, top = z.top, right = bar_index, bottom = z.bottom, bgcolor = bg, border_color = color.new(col, 60), border_width = 1, xloc = xloc.bar_index)

// En la ultima barra limpia y repinta las cajas FVG + lineas CE vivas. Las mitigadas se
// muestran tenues sin CE; las invalidadas se omiten (el gap quedo rellenado por completo).
var array<box>   SMC_fvgBoxes   = array.new<box>()
var array<line>  SMC_fvgCELines = array.new<line>()
var array<label> SMC_fvgLabels  = array.new<label>()
if i_showFVG and barstate.islast
    for b in SMC_fvgBoxes
        box.delete(b)
    for l in SMC_fvgCELines
        line.delete(l)
    for lb in SMC_fvgLabels
        label.delete(lb)
    array.clear(SMC_fvgBoxes)
    array.clear(SMC_fvgCELines)
    array.clear(SMC_fvgLabels)
    if array.size(SMC_zones) > 0
        for i = 0 to array.size(SMC_zones) - 1
            SMC_Zone z = array.get(SMC_zones, i)
            if z.kind == KIND_FVG and z.state != ZS_INVALID and f_densOK(z.strength, i == anchorHiIdx or i == anchorLoIdx)
                array.push(SMC_fvgBoxes, f_drawFVG(z))
                // Nombre del FVG (pref. usuario): texto CENTRADO dentro de la caja (medio
                // horizontal entre origen y barra actual, medio vertical), sin recuadro.
                color fvgCol = z.dir == DIR_BULL ? COL_FVG_BULL : COL_FVG_BEAR
                // True FVG [T26]: vela media = displacement -> etiqueta "T.FVG" (alta calidad) vs "FVG".
                string fvgTxt = (z.trueFvg ? "T.FVG" : "FVG") + (z.gradedFvg ? "·g" : "")
                array.push(SMC_fvgLabels, label.new(math.round((z.barIdx - 1 + bar_index) / 2.0), (z.top + z.bottom) / 2.0, fvgTxt, style = label.style_label_center, color = color.new(color.gray, 100), textcolor = fvgCol, size = size.small, xloc = xloc.bar_index))
                if i_showCE and z.state != ZS_MITIGATED
                    float ce = (z.top + z.bottom) / 2.0
                    color ceCol = z.dir == DIR_BULL ? COL_FVG_BULL : COL_FVG_BEAR
                    array.push(SMC_fvgCELines, line.new(z.barIdx - 1, ce, bar_index, ce, color = color.new(ceCol, 20), style = line.style_dotted, width = 1, xloc = xloc.bar_index))

// --- §6.5 · DESALOJO DETERMINISTA de eventos nativos L3 [Eje2 · Paso 6 · S090] ---
// Punto unico: todas las familias nativas discrecionales ya estan construidas + top-N'd; la capa MTF
// (mandatoria §7.1) aun NO dibuja. Se recorta el excedente de labels al presupuesto restante (eventCap =
// budget - reservaMTF - marco). PRIORIDAD de conservacion: EQHL > pools > sweep > flip > gaps; dentro de
// cada familia caen primero las MAS VIEJAS. En M5 (doble MTF) eventCap≈0 -> el ruido nativo cede a la
// herencia; en H1 (una MTF) sobra sitio para ~8 nativos; en D1 (sin MTF) se conservan todos. Sin arrays
// nuevos. Los desalojados se cuentan (gEvtCut) y afloran en la fila "Ocultos" del panel T14 (§10-#8).
if barstate.islast
    [g1, c1] = f_capLbls(SMC_eqLabels, SMC_eqLines, gEvtLbl, eventCap)
    gEvtLbl := g1
    [g2, c2] = f_capLblsOnly(SMC_poolLabels, gEvtLbl, eventCap)
    gEvtLbl := g2
    [g3, c3] = f_capLblsOnly(SMC_sweepLabels, gEvtLbl, eventCap)
    gEvtLbl := g3
    [g4, c4] = f_capLbls(SMC_flipLabels, SMC_flipLines, gEvtLbl, eventCap)
    gEvtLbl := g4
    [g5, c5] = f_capLbls(SMC_ogLabels, SMC_ogLines, gEvtLbl, eventCap)
    gEvtLbl := g5
    gEvtCut := c1 + c2 + c3 + c4 + c5

// --- Mapa MTF: niveles heredados de HTF en cascada [T13a · ESQUELETO-P3 §2.5] (Visual-only) ---
// Dibujo DIFERENCIADO: lineas P/D del HTF punteadas + tenues con prefijo de TF, para no
// confundirlas con el TF propio. La herencia es solo hacia TF MENORES (mtfShowD1/H1 filtran por
// timeframe). T13a = escalares (P/D high/mid/low + bias); el mapa rico (zonas) es T13b. De
// presentacion -> vive fuera del LIBRARY CORE byte-identico (no rompe check-core-sync).
f_drawMTFState(SMC_TFState s, string tf, color col, array<line> lines, array<label> labels) =>
    if not na(s.pdHigh) and not na(s.pdLow) and s.pdHigh > s.pdLow
        float mid = na(s.pdMid) ? (s.pdHigh + s.pdLow) / 2.0 : s.pdMid
        array.push(lines, line.new(bar_index - 1, s.pdHigh, bar_index, s.pdHigh, xloc = xloc.bar_index, color = color.new(col, 35), style = line.style_dotted, width = 1, extend = extend.left))
        array.push(lines, line.new(bar_index - 1, mid,      bar_index, mid,      xloc = xloc.bar_index, color = color.new(col, 60), style = line.style_dotted, width = 1, extend = extend.left))
        array.push(lines, line.new(bar_index - 1, s.pdLow,  bar_index, s.pdLow,  xloc = xloc.bar_index, color = color.new(col, 35), style = line.style_dotted, width = 1, extend = extend.left))
        array.push(labels, label.new(bar_index + 5, s.pdHigh, tf + ": Premium "  + str.tostring(s.pdHigh, format.mintick), style = label.style_label_left, color = color.new(col, 85), textcolor = col, size = size.small))
        array.push(labels, label.new(bar_index + 5, s.pdLow,  tf + ": Discount " + str.tostring(s.pdLow,  format.mintick), style = label.style_label_left, color = color.new(col, 85), textcolor = col, size = size.small))
    // §6.5: el label de bias MTF es redundante con la fila "Bias" del panel T14 -> en Operacion se
    // suelta para ahorrar presupuesto de labels (≤25); en Estudio+/Todo se conserva.
    if i_densidad != "Operación"
        string biasTxt = s.bias == DIR_BULL ? "Alcista" : s.bias == DIR_BEAR ? "Bajista" : "—"
        float  biasY   = not na(s.pdHigh) and not na(s.pdLow) ? (s.pdHigh + s.pdLow) / 2.0 : close
        array.push(labels, label.new(bar_index + 5, biasY, tf + " bias: " + biasTxt, style = label.style_label_left, color = color.new(col, 92), textcolor = col, size = size.small))

// f_drawMTFZones [T13c · ADR-010]: dibuja el buffer generico heredado del HTF reconstruyendo la
// FORMA NATIVA de cada concepto, ANCLADA POR TIEMPO (xloc.bar_time -> cae en su barra real del LTF,
// porque el bar_index del contexto HTF NO mapea al chart). switch sobre kind: OB/FVG = caja (tono
// distinto); EQH/EQL = linea de tramo tA->tB punteada; BOS/CHoCH = linea origen->ruptura; pool =
// linea al nivel; sweep = marca triangulo en su barra. tA/tB vienen en epoch-ms (casteo a int).
// Presentacion -> fuera del CORE byte-identico. Ya capado a MTF_K en el transporte.
f_drawMTFZones(string tf, color col, array<int> kinds, array<float> tops, array<float> bots, array<int> dirs, array<int> tas, array<int> tbs, array<line> lines, array<label> labels, array<box> boxes, array<SMC_Event> majEvents, float majTol, float mssLvl, int mssDir) =>
    int nowT = time
    // §6.5 dedup SIN arrays (array.push dentro de esta funcion dispara RE10045 en este script grande):
    // acumulador de string con las claves (kind,dir) ya dibujadas + str.contains. En Operacion deja
    // top-1 por (kind,dir) — mata los duplicados D1:EQH x2 / ▼ x2 del buffer capN. Estudio+/Todo: sin
    // recorte (opMode=false). D1 y H1 deduplican por separado (seen es local, fresco por llamada).
    string seen  = ""
    bool opMode = i_densidad == "Operación"
    int  mtfW = tf == "D1" ? 3 : 2                                                                          // §7.2 procedencia: grosor codifica TF de origen (hue sin cambios §1-6)
    for i = 0 to array.size(kinds) - 1
        int   k  = array.get(kinds, i)
        float tp = array.get(tops, i)
        float bt = array.get(bots, i)
        int   dr = array.get(dirs, i)
        int   tA = na(array.get(tas, i)) ? na : int(array.get(tas, i))
        int   tB = na(array.get(tbs, i)) ? na : int(array.get(tbs, i))
        bool labelKind = k == KIND_EQH or k == KIND_EQL or k == KIND_POOL or k == KIND_SWEEP or k == KIND_BOS or k == KIND_CHOCH
        string key = "|" + str.tostring(k) + "_" + str.tostring(dr) + "|"
        bool dup = opMode and labelKind and not na(tp) and str.contains(seen, key)
        if opMode and labelKind and not na(tp) and not dup
            seen := seen + key
        if k != 0 and not na(tp) and not na(bt) and not na(tA) and not dup
            switch
                k == KIND_OB or k == KIND_FVG =>
                    // Anclaje vela-a-vela EXACTO (pref. usuario S042): tA ya es la vela origen (OB) o la
                    // vela media del gap (FVG, time[1] desde el productor). Caja extendida a la derecha
                    // (zona viva) + linea 50% (CE) suave + nombre CENTRADO, como el dibujo nativo.
                    int rgt = na(tB) ? nowT : tB
                    float ce = (tp + bt) / 2.0
                    color bgc = k == KIND_OB ? color.new(col, 85) : color.new(color.orange, 88)
                    array.push(boxes, box.new(tA, tp, rgt, bt, xloc = xloc.bar_time, border_color = color.new(col, 60), border_width = mtfW, bgcolor = bgc, text = tf + ": " + (k == KIND_OB ? "OB" : "FVG"), text_color = col, text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
                    array.push(lines, line.new(tA, ce, rgt, ce, xloc = xloc.bar_time, color = color.new(col, 55), style = line.style_dotted, width = 1))
                k == KIND_EQH or k == KIND_EQL =>
                    // Estilo NATIVO de f_drawEQHL: AZUL + etiqueta SIN nube (fondo transparente). Linea de
                    // toque a toque (tA->tB = los dos pivotes iguales del HTF). Etiqueta al CENTRO de la
                    // linea: EQH encima / EQL debajo (pref. usuario S042), con prefijo TF.
                    int rgt = na(tB) ? nowT : tB
                    int mid = math.round((tA + rgt) / 2.0)
                    array.push(lines, line.new(tA, tp, rgt, tp, xloc = xloc.bar_time, color = color.blue, style = line.style_dotted, width = mtfW))
                    array.push(labels, label.new(mid, tp, tf + ": " + (k == KIND_EQH ? "EQH" : "EQL"), xloc = xloc.bar_time, style = k == KIND_EQH ? label.style_label_down : label.style_label_up, color = color.new(color.blue, 100), textcolor = color.blue, size = size.tiny))
                k == KIND_BOS or k == KIND_CHOCH =>
                    int rgt = na(tB) ? nowT : tB
                    int mid = math.round((tA + rgt) / 2.0)
                    // ANTI-DUPLICADO (pref. usuario S042): si este BOS/CHoCH del HTF COINCIDE con un evento
                    // de estructura grande del M5 (misma dir, nivel +-majTol, ruptura dentro del tramo), el
                    // nativo ya lo dibuja como "BOS+/CHoCH+" -> la capa MTF NO dibuja nada (evita el nombre
                    // duplicado). Si NO coincide, es una estructura SOLO-HTF: se dibuja linea + etiqueta al
                    // CENTRO, arriba (alcista) / abajo (bajista), con su TF. CHoCH MSS si matchea el MSS del TF.
                    bool merged = false
                    if array.size(majEvents) > 0
                        for mi = 0 to array.size(majEvents) - 1
                            SMC_Event me = array.get(majEvents, mi)
                            if me.dir == dr and math.abs(me.price - tp) <= majTol and me.barTime >= tA and me.barTime <= nowT
                                merged := true
                                break
                    if not merged
                        bool isMSS = k == KIND_CHOCH and not na(mssLvl) and mssDir == dr and math.abs(mssLvl - tp) <= majTol
                        string baseTxt = k == KIND_CHOCH ? (isMSS ? "CHoCH MSS" : "CHoCH") : "BOS"
                        array.push(lines, line.new(tA, tp, rgt, tp, xloc = xloc.bar_time, color = color.new(col, 20), style = line.style_solid, width = mtfW))
                        array.push(labels, label.new(mid, tp, baseTxt + " (" + tf + ")", xloc = xloc.bar_time, style = dr == DIR_BULL ? label.style_label_down : label.style_label_up, color = color.new(col, 100), textcolor = col, size = size.small))
                k == KIND_POOL =>
                    array.push(lines, line.new(tA, tp, nowT, tp, xloc = xloc.bar_time, color = color.new(col, 45), style = line.style_dashed, width = mtfW))
                    array.push(labels, label.new(nowT, tp, tf + ": " + (dr == DIR_BULL ? "BSL" : "SSL"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(col, 90), textcolor = col, size = size.tiny))
                k == KIND_SWEEP =>
                    // §7.2: el sweep era la unica marca sin tag de TF -> se anade "(D1)"/"(H1)".
                    string mk = i_mtfSweepMark ? ((dr == DIR_BULL ? "▲" : "▼") + " (" + tf + ")") : (tf + ": Sweep")
                    array.push(labels, label.new(tA, tp, mk, xloc = xloc.bar_time, style = dr == DIR_BULL ? label.style_label_down : label.style_label_up, color = color.new(col, 100), textcolor = col, size = size.small))

// Cascada: el HTF solo se hereda si es estrictamente MAYOR que el chart (D1->{H1,M5}, H1->{M5}).
var array<line>  SMC_mtfLines  = array.new<line>()
var array<label> SMC_mtfLabels = array.new<label>()
var array<box>   SMC_mtfBoxes  = array.new<box>()
bool mtfShowD1 = i_showD1 and timeframe.in_seconds() < timeframe.in_seconds("D")
bool mtfShowH1 = i_showH1 and timeframe.in_seconds() < timeframe.in_seconds("60")
if barstate.islast and (mtfShowD1 or mtfShowH1)
    for l in SMC_mtfLines
        line.delete(l)
    for lb in SMC_mtfLabels
        label.delete(lb)
    for bx in SMC_mtfBoxes
        box.delete(bx)
    array.clear(SMC_mtfLines)
    array.clear(SMC_mtfLabels)
    array.clear(SMC_mtfBoxes)
    float mtfMajTol = atr14 * 0.3
    if mtfShowD1
        f_drawMTFState(d1State, "D1", color.new(color.blue, 0), SMC_mtfLines, SMC_mtfLabels)
        f_drawMTFZones("D1", color.new(color.blue, 0), d1Kind, d1Top, d1Bot, d1Dir, d1TA, d1TB, SMC_mtfLines, SMC_mtfLabels, SMC_mtfBoxes, SMC_eventsMajor, mtfMajTol, d1State.lastMSSPrice, d1State.lastMSSDir)
    if mtfShowH1
        f_drawMTFState(h1State, "H1", color.new(color.fuchsia, 0), SMC_mtfLines, SMC_mtfLabels)
        f_drawMTFZones("H1", color.new(color.fuchsia, 0), h1Kind, h1Top, h1Bot, h1Dir, h1TA, h1TB, SMC_mtfLines, SMC_mtfLabels, SMC_mtfBoxes, SMC_eventsMajor, mtfMajTol, h1State.lastMSSPrice, h1State.lastMSSDir)

// --- Helpers de panel [adelanto parcial de PINE-PLAN §5 / T14] (Visual-only) ---
// Buscan el evento/zona/pool mas relevante para mostrar en el panel. Son de PRESENTACION:
// viven aqui y NO en el === LIBRARY CORE === byte-identico (no rompen check-core-sync). En
// Sprint 2.1 (scoring) algunas podran promoverse a CORE puro y reutilizarse en Strategy.
// Devuelven na si no hay candidato (el llamador formatea "—").
f_pLastEvent(array<SMC_Event> a) =>
    array.size(a) > 0 ? array.last(a) : na

f_pNearZone(array<SMC_Zone> a, int kind, float price) =>
    SMC_Zone best = na
    float    bestD = na
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            SMC_Zone z = array.get(a, i)
            if z.kind == kind and z.state != ZS_INVALID
                float d = math.abs((z.top + z.bottom) / 2.0 - price)
                if na(bestD) or d < bestD
                    bestD := d
                    best  := z
    best

f_pNearPool(array<SMC_Pool> a, float price) =>
    SMC_Pool best = na
    float    bestD = na
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            SMC_Pool p = array.get(a, i)
            if not p.swept
                float d = math.abs(p.level - price)
                if na(bestD) or d < bestD
                    bestD := d
                    best  := p
    best

// --- Helpers multi-TF del panel [T14] (Visual-only) ---
// Formatean una celda por TF a partir del SMC_TFState (D1/H1) o del estado propio (M5). Los
// conceptos con snapshot escalar (bias/BOS/CHoCH/MSS/P-D/EMA) salen de los 3 TFs; los que solo
// viajan en el buffer geometrico MTF (OB/FVG/pool/sweep/EQ) se derivan con f_bufNear sobre los
// arrays d1*/h1* (T13b/c). El M5 usa los arrays nativos (SMC_zones/SMC_pools/SMC_sweeps/SMC_eqhl).
// Etiqueta corta del TF del chart para la cabecera de la columna propia (M5/M15/H1/H4/D1...).
f_tfLabel() =>
    string p = timeframe.period
    float  m = str.tonumber(p)
    p == "D" ? "D1" : p == "W" ? "W1" : p == "M" ? "MN" : na(m) ? p : m >= 60 ? "H" + str.tostring(int(m / 60)) : "M" + p
f_biasTxt(int b) => b == DIR_BULL ? "▲ Alcista" : b == DIR_BEAR ? "▼ Bajista" : "—"
f_dirCol(int d)  => d == DIR_BULL ? color.teal : d == DIR_BEAR ? color.red : color.gray
// Celda de evento estructural (BOS/CHoCH/MSS): "precio · dd-MM HH:mm".
f_evCell(float p, int t) => na(p) ? "—" : str.tostring(p, format.mintick) + " · " + str.format_time(t, "dd-MM HH:mm", "GMT")
// Celda Premium/Discount sobre un rango cualquiera (close = precio del chart contra el rango HTF).
f_pdCell(float hi, float lo) =>
    [z, pct] = f_premiumDiscount(close, hi, lo, 0.5 - i_pdEqBand / 100.0, 0.5 + i_pdEqBand / 100.0)
    string txt  = na(z) ? "—" : z == PD_PREMIUM ? "Premium" : z == PD_DISCOUNT ? "Discount" : "Equil."
    string cell = na(z) ? "—" : txt + (na(pct) ? "" : " " + str.tostring(math.round(pct * 100)) + "%")
    color  col  = z == PD_PREMIUM ? color.red : z == PD_DISCOUNT ? color.green : color.gray
    [cell, col]
// Celda de alineacion EMA: ⬆⬆⬆ stack alcista / ⬇⬇⬇ bajista / mixto.
f_emaCell(float e20, float e50, float e200) =>
    bool ok   = not na(e20) and not na(e50) and not na(e200)
    bool up   = ok and e20 > e50 and e50 > e200
    bool dn   = ok and e20 < e50 and e50 < e200
    string c  = not ok ? "—" : up ? "⬆⬆⬆" : dn ? "⬇⬇⬇" : "mixto"
    color  cl = up ? color.teal : dn ? color.red : color.gray
    [c, cl]
// Indice del elemento del buffer MTF (kind == want) cuyo centro esta mas cerca de price; -1 si no hay.
f_bufNear(array<int> kinds, array<float> tops, array<float> bots, int want, float price) =>
    int   best  = -1
    float bestD = na
    if array.size(kinds) > 0
        for i = 0 to array.size(kinds) - 1
            if array.get(kinds, i) == want
                float tp = array.get(tops, i)
                float bt = array.get(bots, i)
                if not na(tp) and not na(bt)
                    float d = math.abs((tp + bt) / 2.0 - price)
                    if na(bestD) or d < bestD
                        bestD := d
                        best  := i
    best
// Celda de zona [bot, top] desde el buffer MTF por kind (OB/FVG).
f_bufZoneCell(array<int> kinds, array<float> tops, array<float> bots, int want) =>
    int idx = f_bufNear(kinds, tops, bots, want, close)
    idx < 0 ? "—" : "[" + str.tostring(array.get(bots, idx), format.mintick) + ", " + str.tostring(array.get(tops, idx), format.mintick) + "]"
// §9-2 TEST: glifo de fuerza.
f_strGlyph(float s) => f_strengthLevel(s) == 2 ? " ●●●" : f_strengthLevel(s) == 1 ? " ●●○" : " ●○○"
// Conteo de EQH+EQL presentes en el buffer MTF.
f_bufCountEQ(array<int> kinds) =>
    int n = 0
    if array.size(kinds) > 0
        for i = 0 to array.size(kinds) - 1
            int k = array.get(kinds, i)
            if k == KIND_EQH or k == KIND_EQL
                n += 1
    n

// EMAs del chart para el panel [T14]: reutiliza las EMAs compartidas computadas en T23 (emaFast/Mid/
// Slow, periodos configurables) -> una sola ta.ema por periodo en todo el script.
float m5Ema20  = emaFast
float m5Ema50  = emaMid
float m5Ema200 = emaSlow

// === PANEL === [T14 · diseño PINE-PLAN §5 completo]
// Tabla multi-columna: Concepto | D1 | H1 | M5/chart. D1/H1 salen de d1State/h1State (escalares
// via request.security) + buffer geometrico (OB/FVG/pool/sweep); M5 de los arrays nativos. Conceptos
// solo-chart (Bias dom. 50, Kill Zone) muestran "—" en D1/H1. Controles en Ajustes (Pine no recibe
// clicks en chart): "Mostrar panel" lo apaga entero; "Panel compacto" lo MINIMIZA a header + Bias
// por TF (2 filas). Texto size.small para footprint reducido.
if i_showPanel and barstate.islast
    int nrows = i_panelCompact ? 2 : 15
    table panel = table.new(position.top_right, 4, nrows, border_width = 1)
    string modoTxt = i_densidad == "Operación" ? "Op" : i_densidad == "Estudio" ? "Est" : "Todo"           // §9-3: modo activo visible
    color  hdrBg = color.new(color.blue, 0)
    string tsz   = size.small
    // --- M5 / chart (estado propio) ---
    [m5Pd, m5PdCol]   = f_pdCell(trailing.top, trailing.bottom)
    [m5Ema, m5EmaCol] = f_emaCell(m5Ema20, m5Ema50, m5Ema200)
    string majTxt = f_biasTxt(structMajor.bias)
    SMC_Event mssE  = f_pLastEvent(SMC_eventsMSS)
    SMC_Zone  obZ   = f_pNearZone(SMC_zones, KIND_OB,  close)
    SMC_Zone  fvgZ  = f_pNearZone(SMC_zones, KIND_FVG, close)
    SMC_Pool  poolP = f_pNearPool(SMC_pools, close)
    SMC_Event swE   = f_pLastEvent(SMC_sweeps)
    string m5Ob   = na(obZ)  ? "—" : "[" + str.tostring(obZ.bottom, format.mintick)  + ", " + str.tostring(obZ.top, format.mintick)  + "]" + f_strGlyph(obZ.strength)
    string m5Fvg  = na(fvgZ) ? "—" : "[" + str.tostring(fvgZ.bottom, format.mintick) + ", " + str.tostring(fvgZ.top, format.mintick) + "]" + f_strGlyph(fvgZ.strength)
    string m5Pool = na(poolP) ? "—" : str.tostring(poolP.level, format.mintick) + " " + (poolP.dir == DIR_BULL ? "BSL" : "SSL") + " ·" + str.tostring(poolP.touches) + f_strGlyph(poolP.strength)
    string m5Sw   = na(swE) ? "—" : str.tostring(swE.price, format.mintick) + (swE.dir == DIR_BULL ? " ↑" : " ↓")
    string kzTxt  = curKZ == KZ_LONDON ? "London" : curKZ == KZ_NY ? "NY AM" : curKZ == KZ_TOKYO ? "Tokyo" : "—"
    string kzCell = curKZ == KZ_NONE ? "—" : kzTxt + (curKZFirst ? " (1ª½)" : "")
    // --- D1 / H1 (snapshots MTF) ---
    [d1Pd, d1PdCol]   = f_pdCell(d1State.pdHigh, d1State.pdLow)
    [h1Pd, h1PdCol]   = f_pdCell(h1State.pdHigh, h1State.pdLow)
    [d1Ema, d1EmaCol] = f_emaCell(d1State.ema20, d1State.ema50, d1State.ema200)
    [h1Ema, h1EmaCol] = f_emaCell(h1State.ema20, h1State.ema50, h1State.ema200)
    string d1Pool = (f_bufNear(d1Kind, d1Top, d1Bot, KIND_POOL, close) < 0) ? "—" : str.tostring(array.get(d1Top, f_bufNear(d1Kind, d1Top, d1Bot, KIND_POOL, close)), format.mintick) + (array.get(d1Dir, f_bufNear(d1Kind, d1Top, d1Bot, KIND_POOL, close)) == DIR_BULL ? " BSL" : " SSL")
    string h1Pool = (f_bufNear(h1Kind, h1Top, h1Bot, KIND_POOL, close) < 0) ? "—" : str.tostring(array.get(h1Top, f_bufNear(h1Kind, h1Top, h1Bot, KIND_POOL, close)), format.mintick) + (array.get(h1Dir, f_bufNear(h1Kind, h1Top, h1Bot, KIND_POOL, close)) == DIR_BULL ? " BSL" : " SSL")
    int    d1SwI  = f_bufNear(d1Kind, d1Top, d1Bot, KIND_SWEEP, close)
    int    h1SwI  = f_bufNear(h1Kind, h1Top, h1Bot, KIND_SWEEP, close)
    string d1Sw   = d1SwI < 0 ? "—" : str.tostring(array.get(d1Top, d1SwI), format.mintick) + (array.get(d1Dir, d1SwI) == DIR_BULL ? " ↑" : " ↓")
    string h1Sw   = h1SwI < 0 ? "—" : str.tostring(array.get(h1Top, h1SwI), format.mintick) + (array.get(h1Dir, h1SwI) == DIR_BULL ? " ↑" : " ↓")
    // --- pintado: fila 0 = cabecera con TF; columna 0 = concepto. Minimizado (i_panelCompact) =
    //     solo header + Bias por TF. text_size = tsz (size.small) en todas las celdas. ---
    table.cell(panel, 0, 0, "SMC · " + modoTxt, text_color = color.white, bgcolor = hdrBg, text_size = tsz)
    table.cell(panel, 1, 0, "D1", text_color = color.white, bgcolor = hdrBg, text_size = tsz)
    table.cell(panel, 2, 0, "H1", text_color = color.white, bgcolor = hdrBg, text_size = tsz)
    table.cell(panel, 3, 0, f_tfLabel(), text_color = color.white, bgcolor = hdrBg, text_size = tsz)
    int r = 1
    // Bias (los 3 TFs) — siempre visible (es la fila del modo minimizado)
    table.cell(panel, 0, r, "Bias", text_color = color.gray, text_size = tsz)
    table.cell(panel, 1, r, f_biasTxt(d1State.bias), text_color = f_dirCol(d1State.bias), text_size = tsz)
    table.cell(panel, 2, r, f_biasTxt(h1State.bias), text_color = f_dirCol(h1State.bias), text_size = tsz)
    table.cell(panel, 3, r, f_biasTxt(chartState.bias), text_color = f_dirCol(chartState.bias), text_size = tsz)
    r := r + 1
    if not i_panelCompact
        // Bias dominante (50) [T07B]: solo escala chart (no se transporta MTF) -> "—" en D1/H1.
        table.cell(panel, 0, r, "Bias dom. (50)", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, "—", text_color = color.gray, text_size = tsz)
        table.cell(panel, 2, r, "—", text_color = color.gray, text_size = tsz)
        table.cell(panel, 3, r, majTxt, text_color = f_dirCol(structMajor.bias), text_size = tsz)
        r := r + 1
        // Premium/Discount (los 3 TFs)
        table.cell(panel, 0, r, "Premium/Discount", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, d1Pd, text_color = d1PdCol, text_size = tsz)
        table.cell(panel, 2, r, h1Pd, text_color = h1PdCol, text_size = tsz)
        table.cell(panel, 3, r, m5Pd, text_color = m5PdCol, text_size = tsz)
        r := r + 1
        // Ultimo BOS
        table.cell(panel, 0, r, "Último BOS", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, f_evCell(d1State.lastBOSPrice, d1State.lastBOSTime), text_color = f_dirCol(d1State.lastBOSDir), text_size = tsz)
        table.cell(panel, 2, r, f_evCell(h1State.lastBOSPrice, h1State.lastBOSTime), text_color = f_dirCol(h1State.lastBOSDir), text_size = tsz)
        table.cell(panel, 3, r, f_evCell(chartState.lastBOSPrice, chartState.lastBOSTime), text_color = f_dirCol(chartState.lastBOSDir), text_size = tsz)
        r := r + 1
        // Ultimo CHoCH
        table.cell(panel, 0, r, "Último CHoCH", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, f_evCell(d1State.lastCHoCHPrice, d1State.lastCHoCHTime), text_color = f_dirCol(d1State.lastCHoCHDir), text_size = tsz)
        table.cell(panel, 2, r, f_evCell(h1State.lastCHoCHPrice, h1State.lastCHoCHTime), text_color = f_dirCol(h1State.lastCHoCHDir), text_size = tsz)
        table.cell(panel, 3, r, f_evCell(chartState.lastCHoCHPrice, chartState.lastCHoCHTime), text_color = f_dirCol(chartState.lastCHoCHDir), text_size = tsz)
        r := r + 1
        // Ultimo MSS (D1/H1 desde el state; M5 desde SMC_eventsMSS)
        table.cell(panel, 0, r, "Último MSS", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, f_evCell(d1State.lastMSSPrice, d1State.lastMSSTime), text_color = f_dirCol(d1State.lastMSSDir), text_size = tsz)
        table.cell(panel, 2, r, f_evCell(h1State.lastMSSPrice, h1State.lastMSSTime), text_color = f_dirCol(h1State.lastMSSDir), text_size = tsz)
        table.cell(panel, 3, r, na(mssE) ? "—" : f_evCell(mssE.price, mssE.barTime), text_color = na(mssE) ? color.gray : f_dirCol(mssE.dir), text_size = tsz)
        r := r + 1
        // OB cercano
        table.cell(panel, 0, r, "OB cercano", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, f_bufZoneCell(d1Kind, d1Top, d1Bot, KIND_OB), text_color = color.gray, text_size = tsz)
        table.cell(panel, 2, r, f_bufZoneCell(h1Kind, h1Top, h1Bot, KIND_OB), text_color = color.gray, text_size = tsz)
        table.cell(panel, 3, r, m5Ob, text_color = na(obZ) ? color.gray : f_dirCol(obZ.dir), text_size = tsz)
        r := r + 1
        // FVG cercano
        table.cell(panel, 0, r, "FVG cercano", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, f_bufZoneCell(d1Kind, d1Top, d1Bot, KIND_FVG), text_color = color.gray, text_size = tsz)
        table.cell(panel, 2, r, f_bufZoneCell(h1Kind, h1Top, h1Bot, KIND_FVG), text_color = color.gray, text_size = tsz)
        table.cell(panel, 3, r, m5Fvg, text_color = na(fvgZ) ? color.gray : f_dirCol(fvgZ.dir), text_size = tsz)
        r := r + 1
        // Pool cercano
        table.cell(panel, 0, r, "Pool cercano", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, d1Pool, text_color = color.gray, text_size = tsz)
        table.cell(panel, 2, r, h1Pool, text_color = color.gray, text_size = tsz)
        table.cell(panel, 3, r, m5Pool, text_color = na(poolP) ? color.gray : f_dirCol(poolP.dir), text_size = tsz)
        r := r + 1
        // Ultimo Sweep
        table.cell(panel, 0, r, "Último Sweep", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, d1Sw, text_color = d1SwI < 0 ? color.gray : f_dirCol(array.get(d1Dir, d1SwI)), text_size = tsz)
        table.cell(panel, 2, r, h1Sw, text_color = h1SwI < 0 ? color.gray : f_dirCol(array.get(h1Dir, h1SwI)), text_size = tsz)
        table.cell(panel, 3, r, m5Sw, text_color = na(swE) ? color.gray : f_dirCol(swE.dir), text_size = tsz)
        r := r + 1
        // EMA 20/50/200 (alineacion por TF)
        table.cell(panel, 0, r, "EMA 20/50/200", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, d1Ema, text_color = d1EmaCol, text_size = tsz)
        table.cell(panel, 2, r, h1Ema, text_color = h1EmaCol, text_size = tsz)
        table.cell(panel, 3, r, m5Ema, text_color = m5EmaCol, text_size = tsz)
        r := r + 1
        // EQ H/L (conteo): D1/H1 del buffer, M5 del array nativo
        table.cell(panel, 0, r, "EQ H/L", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, str.tostring(f_bufCountEQ(d1Kind)), text_color = color.gray, text_size = tsz)
        table.cell(panel, 2, r, str.tostring(f_bufCountEQ(h1Kind)), text_color = color.gray, text_size = tsz)
        table.cell(panel, 3, r, str.tostring(array.size(SMC_eqhl)), text_color = color.gray, text_size = tsz)
        r := r + 1
        // Kill Zone (basada en tiempo: misma para todos los TFs -> solo columna chart)
        table.cell(panel, 0, r, "Kill Zone", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, "—", text_color = color.gray, text_size = tsz)
        table.cell(panel, 2, r, "—", text_color = color.gray, text_size = tsz)
        table.cell(panel, 3, r, kzCell, text_color = curKZ == KZ_NONE ? color.gray : color.aqua, text_size = tsz)
        r := r + 1
        // Ocultos [§9-1 · Paso 8]: contador de lo detectado-pero-NO-dibujado en el modo activo (nada
        // desaparece en silencio, §1-7 / checklist §10-#8). En "Todo" todo se ve => 0. Est/EQ = recortes
        // top-N vigente; Ref = refinamientos Estudio+ ocultos en Operacion; Liq = sweeps > 1; µ = micro
        // (vi/ipr) solo-Todo. Fila unica concatenada (limitacion table, per impl §9).
        int hidRef = f_famOK(FAM_EST) ? 0 : array.size(SMC_displacements) + array.size(SMC_emaBounces) + array.size(SMC_emaCrosses) + array.size(SMC_fbreakEvents) + array.size(SMC_insideDays) + array.size(SMC_bag) + array.size(SMC_idm) + array.size(SMC_ir) + array.size(SMC_cisd) + array.size(SMC_legs) + array.size(SMC_judas) + array.size(SMC_rejections) + array.size(SMC_emaStacks)
        int hidMicro = f_famOK(FAM_TODO) ? 0 : array.size(SMC_vi) + array.size(SMC_ipr)
        int hidLiq = (f_famOK(FAM_EST) ? 0 : math.max(0, array.size(SMC_sweeps) - 1)) + hidPools
        string ocultosTxt = "Est " + str.tostring(hidStruct) + " · EQ " + str.tostring(hidEq) + " · Liq " + str.tostring(hidLiq) + " · Ref " + str.tostring(hidRef) + (hidGrad > 0 ? " · Grad " + str.tostring(hidGrad) : "") + (hidMicro > 0 ? " · µ " + str.tostring(hidMicro) : "") + (gEvtCut > 0 ? " · Desalojo " + str.tostring(gEvtCut) : "")
        table.cell(panel, 0, r, "Ocultos", text_color = color.gray, text_size = tsz)
        table.cell(panel, 1, r, ocultosTxt, text_color = color.gray, text_size = tsz)

// === ALERTAS === [F1-S1.4-T15 · PINE-PLAN §5 línea 213]
// Cobertura SMC completa via alertcondition(). Cada concepto+dirección es su propia
// condición porque alertcondition() exige mensaje CONSTANTE (no se puede inyectar la
// dirección en runtime en una sola condición); por eso el set es paralelo a las 16 del
// LuxAlgo base. Plantilla §5: "{{ticker}} | <concepto> <dir> @ {{close}} | TF={{interval}} | {{timenow}}"
// ({{ticker}}/{{close}}/{{interval}}/{{timenow}} los resuelve TradingView al disparar).
// ANTI-REPAINT [D-PINE-03]: todos los eventos enganchados se producen SOLO en barras
// confirmadas (evStruct*/evMSS/evSweepAlert/evEq* son na fuera de barstate.isconfirmed);
// las condiciones por estado (Kill Zone, entrada a zona, Premium/Discount) se cierran con
// barstate.isconfirmed explícito. Sección 100% Visual — no toca el CORE.

// --- Disparadores de estructura (chart-TF, escala swing) ---
bool alBosBull   = not na(evStructSwing) and evStructSwing.kind == KIND_BOS   and evStructSwing.dir == DIR_BULL
bool alBosBear   = not na(evStructSwing) and evStructSwing.kind == KIND_BOS   and evStructSwing.dir == DIR_BEAR
bool alChochBull = not na(evStructSwing) and evStructSwing.kind == KIND_CHOCH and evStructSwing.dir == DIR_BULL
bool alChochBear = not na(evStructSwing) and evStructSwing.kind == KIND_CHOCH and evStructSwing.dir == DIR_BEAR
// Estructura interna (escala menor)
bool alIntBull   = not na(evStructInt) and evStructInt.dir == DIR_BULL
bool alIntBear   = not na(evStructInt) and evStructInt.dir == DIR_BEAR
// Estructura DOMINANTE (50) [T07B]
bool alMajBull   = not na(evStructMajor) and evStructMajor.dir == DIR_BULL
bool alMajBear   = not na(evStructMajor) and evStructMajor.dir == DIR_BEAR
// MSS confirmado [T12]
bool alMssBull   = not na(evMSS) and evMSS.dir == DIR_BULL
bool alMssBear   = not na(evMSS) and evMSS.dir == DIR_BEAR
// Sweep / barrido de liquidez [T10] (dir = lado de la reversión esperada)
bool alSweepBull = not na(evSweepAlert) and evSweepAlert.dir == DIR_BULL
bool alSweepBear = not na(evSweepAlert) and evSweepAlert.dir == DIR_BEAR
// Equal Highs / Equal Lows [T08]
bool alEqh       = not na(evEqHigh)
bool alEql       = not na(evEqLow)

// --- Kill Zone recién abierta (transición NONE/otra -> sesión activa) [T11] ---
bool alKzLondon = barstate.isconfirmed and curKZ == KZ_LONDON and curKZ[1] != KZ_LONDON
bool alKzNY     = barstate.isconfirmed and curKZ == KZ_NY     and curKZ[1] != KZ_NY
bool alKzTokyo  = barstate.isconfirmed and curKZ == KZ_TOKYO  and curKZ[1] != KZ_TOKYO

// --- Precio entra a zona activa OB/FVG [T05/T06] ---
// Detecta cruce de ENTRADA: el cierre cae dentro de [bottom,top] de una zona viva
// (state < ZS_MITIGATED) habiendo estado fuera la barra previa. Se agrega por kind+dir.
bool alEnterOBBull  = false
bool alEnterOBBear  = false
bool alEnterFVGBull = false
bool alEnterFVGBear = false
if barstate.isconfirmed and array.size(SMC_zones) > 0
    for i = 0 to array.size(SMC_zones) - 1
        SMC_Zone z = array.get(SMC_zones, i)
        if z.state < ZS_MITIGATED
            bool nowIn  = close <= z.top and close >= z.bottom
            bool prevOut = close[1] > z.top or close[1] < z.bottom
            if nowIn and prevOut
                if z.kind == KIND_OB
                    if z.dir == DIR_BULL
                        alEnterOBBull := true
                    else
                        alEnterOBBear := true
                else if z.kind == KIND_FVG
                    if z.dir == DIR_BULL
                        alEnterFVGBull := true
                    else
                        alEnterFVGBear := true

// --- Premium / Discount: transición de zona del precio [T07] ---
[alPdZone, alPdPct] = f_premiumDiscount(close, chartState.pdHigh, chartState.pdLow, 0.5 - i_pdEqBand / 100.0, 0.5 + i_pdEqBand / 100.0)
bool alEnterPremium  = barstate.isconfirmed and alPdZone == PD_PREMIUM  and alPdZone[1] != PD_PREMIUM
bool alEnterDiscount = barstate.isconfirmed and alPdZone == PD_DISCOUNT and alPdZone[1] != PD_DISCOUNT

// --- alertcondition() — set completo SMC ---
alertcondition(alBosBull,      "BOS alcista",        "{{ticker}} | BOS alcista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alBosBear,      "BOS bajista",        "{{ticker}} | BOS bajista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alChochBull,    "CHoCH alcista",      "{{ticker}} | CHoCH alcista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alChochBear,    "CHoCH bajista",      "{{ticker}} | CHoCH bajista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alIntBull,      "Estructura interna alcista", "{{ticker}} | Estructura interna alcista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alIntBear,      "Estructura interna bajista", "{{ticker}} | Estructura interna bajista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alMajBull,      "Estructura dominante alcista", "{{ticker}} | Estructura dominante alcista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alMajBear,      "Estructura dominante bajista", "{{ticker}} | Estructura dominante bajista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alMssBull,      "MSS alcista",        "{{ticker}} | MSS alcista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alMssBear,      "MSS bajista",        "{{ticker}} | MSS bajista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alSweepBull,    "Sweep alcista",      "{{ticker}} | Sweep alcista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alSweepBear,    "Sweep bajista",      "{{ticker}} | Sweep bajista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alEqh,          "Equal Highs (EQH)",  "{{ticker}} | EQH formado @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alEql,          "Equal Lows (EQL)",   "{{ticker}} | EQL formado @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alKzLondon,     "Kill Zone London abierta", "{{ticker}} | Kill Zone London abierta @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alKzNY,         "Kill Zone NY abierta",     "{{ticker}} | Kill Zone NY abierta @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alKzTokyo,      "Kill Zone Tokyo abierta",  "{{ticker}} | Kill Zone Tokyo abierta @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alEnterOBBull,  "Precio entra OB alcista",  "{{ticker}} | Precio entra OB alcista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alEnterOBBear,  "Precio entra OB bajista",  "{{ticker}} | Precio entra OB bajista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alEnterFVGBull, "Precio entra FVG alcista", "{{ticker}} | Precio entra FVG alcista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alEnterFVGBear, "Precio entra FVG bajista", "{{ticker}} | Precio entra FVG bajista @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alEnterPremium, "Precio entra Premium",     "{{ticker}} | Precio entra Premium @ {{close}} | TF={{interval}} | {{timenow}}")
alertcondition(alEnterDiscount,"Precio entra Discount",    "{{ticker}} | Precio entra Discount @ {{close}} | TF={{interval}} | {{timenow}}")
