strategy("SMC Engine — Strategy", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 1, commission_type = strategy.commission.cash_per_contract, process_orders_on_close = true)

// === INPUTS ===
// Grupos canonicos (reglas-dev §1.3). Esqueleto: solo inputs base; el resto
// (toggles por concepto, pesos w_* del scoring) llega en sus tareas.
GRP_STRUCT = "Estructura"
GRP_OB     = "Order Blocks"
GRP_FVG    = "Fair Value Gaps"
GRP_SCORE  = "Scoring"
GRP_KZ     = "Kill Zones / Sesiones"
GRP_MTF    = "Mapa MTF"
// Estructura DOMINANTE (swing grande = LuxAlgo getCurrentStructure(50), ref :782).
// NUESTRO swingLen=5 ~= interno de LuxAlgo; esta capa es la que faltaba [T07B].
i_majorLen    = input.int(50, "Swing dominante (estructura grande)", minval = 10, group = GRP_STRUCT)
i_swingLen    = input.int(5, "Swing length",    minval = 2, group = GRP_STRUCT)
i_internalLen = input.int(3, "Internal length", minval = 1, group = GRP_STRUCT)
i_mssDispFactor= input.float(1.5,  "MSS: rango vela ruptura (x ATR14)", minval = 0.5, step = 0.1, group = GRP_STRUCT)
i_mssBodyPct   = input.float(0.70, "MSS: cuerpo minimo (frac. rango)", minval = 0.1, maxval = 1.0, step = 0.05, group = GRP_STRUCT)
// Displacement [§4.1 · T16]: knobs propios (independientes del MSS) para scoring/Fase 3.
i_dispFactor      = input.float(1.5,  "Displacement: rango (x ATR14)", minval = 0.5, step = 0.1, group = GRP_STRUCT)
i_dispBodyPct     = input.float(0.70, "Displacement: cuerpo minimo (frac. rango)", minval = 0.1, maxval = 1.0, step = 0.05, group = GRP_STRUCT)
i_dispContraction = input.bool(true,  "Displacement: exigir contraccion previa (>=3 velas)", group = GRP_STRUCT)
i_obHighVolFactor = input.float(2.0, "Filtro volatilidad (x ATR200)", minval = 0.5, step = 0.1, group = GRP_OB)
i_obMitClose     = input.bool(false, "Mitigacion por cierre (vs mecha)",  group = GRP_OB)
i_fvgThreshold = input.float(0.25, "Umbral tamaño FVG (x ATR14)", minval = 0.0, step = 0.05, group = GRP_FVG)
i_pdSwingLen  = input.int(50, "Swing P/D (rango dominante)", minval = 10, group = GRP_SCORE)
i_pdEqBand    = input.float(5.0, "Banda equilibrium P/D (± %)", minval = 0.0, maxval = 25.0, step = 0.5, group = GRP_SCORE)
i_scoreThresh = input.int(0, "Score threshold (calibrar Fase 3)", group = GRP_SCORE)
i_eqThreshold = input.float(0.1, "Umbral igualdad EQH/EQL (x ATR14)", minval = 0.0, maxval = 0.5, step = 0.05, group = GRP_SCORE)
i_eqlLength   = input.int(3, "Barras confirmacion EQH/EQL", minval = 1, group = GRP_SCORE)
i_poolTol     = input.float(0.1, "Tolerancia cluster pools (x ATR14)", minval = 0.0, maxval = 0.5, step = 0.05, group = GRP_SCORE)
i_minTouches  = input.int(2, "Toques minimos para pool", minval = 2, group = GRP_SCORE)
i_judasBars   = input.int(6, "Judas: max velas sweep->displacement (§3.5)", minval = 1, group = GRP_SCORE)
i_rejWickFactor = input.float(2.0, "Rejection: mecha minima (x cuerpo) §2.7", minval = 0.5, step = 0.1, group = GRP_SCORE)
i_rejTouchTol   = input.float(0.1, "Rejection: tolerancia toque nivel (x ATR14)", minval = 0.0, maxval = 0.5, step = 0.05, group = GRP_SCORE)
i_oteR1 = input.float(0.50,  "OTE fib inicio GP (50%)", minval = 0.0, maxval = 1.0, step = 0.001, group = GRP_SCORE)
i_oteR2 = input.float(0.618, "OTE fib GP/OTE (61.8%)",  minval = 0.0, maxval = 1.0, step = 0.001, group = GRP_SCORE)
i_oteR3 = input.float(0.79,  "OTE fib fin OTE (79%)",   minval = 0.0, maxval = 1.0, step = 0.001, group = GRP_SCORE)
i_emaFast      = input.int(20,  "EMA rapida", minval = 1, group = GRP_SCORE)
i_emaMid       = input.int(50,  "EMA media",  minval = 1, group = GRP_SCORE)
i_emaSlow      = input.int(200, "EMA lenta",  minval = 1, group = GRP_SCORE)
i_emaCrossBars = input.int(20,  "EMA: antiguedad max cruce (velas) §4.3 #40", minval = 1, group = GRP_SCORE)
i_raidTouches  = input.int(3, "Raid: toques minimos del pool (§3.7 #16)", minval = 2, group = GRP_SCORE)
i_fbBars       = input.int(2, "False Breakout: max velas para revertir (§3.7 #14)", minval = 1, group = GRP_SCORE)
i_bprWindow    = input.int(20, "BPR: ventana max entre FVG opuestos (velas, §5.3)", minval = 1, group = GRP_SCORE)
i_bprMinOverlap= input.float(0.05, "BPR: solape minimo (x ATR14)", minval = 0.0, maxval = 0.5, step = 0.01, group = GRP_SCORE)
i_irFactor     = input.float(1.0, "IR: rango vela impulso (x ATR14, §5.4)", minval = 0.3, step = 0.1, group = GRP_SCORE)
i_irBodyPct    = input.float(0.60, "IR: cuerpo minimo (frac. rango)", minval = 0.1, maxval = 1.0, step = 0.05, group = GRP_SCORE)
i_viThreshold  = input.float(0.05, "VI: gap minimo de cuerpo (x ATR14, §5.5)", minval = 0.0, maxval = 0.5, step = 0.01, group = GRP_SCORE)
i_iprWindow    = input.int(10, "IPR: ventana (velas, §5.9)", minval = 2, group = GRP_SCORE)
i_iprMinGaps   = input.int(3,  "IPR: FVG min. mismo lado", minval = 2, group = GRP_SCORE)
i_gapMin       = input.float(0.5, "Gap apertura medible / Breakaway (x ATR14, §5.10)", minval = 0.0, step = 0.1, group = GRP_SCORE)
i_cisdMinRun   = input.int(2, "CISD: velas minimas del run de delivery (§5.6)", minval = 1, group = GRP_SCORE)
i_propOverlap  = input.float(0.5, "Propulsion: solape minimo en OB previo (§5.8)", minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_SCORE)
i_vacuumFactor = input.float(0.5, "Vacuum: gap minimo de apertura (x ATR14, §5.7)", minval = 0.1, step = 0.1, group = GRP_SCORE)
i_sessionProfile = input.string("FX-London-NY", "Perfil de sesión", options = ["FX-London-NY", "FX-Asia", "None"], group = GRP_KZ)
i_rthEnable    = input.bool(false, "RTH/ETH activo (indices/futuros; off=FX 24h) §5.15", group = GRP_KZ)
i_rthStart     = input.int(570, "RTH inicio (min del dia, hora NY; 570=09:30)", minval = 0, maxval = 1439, group = GRP_KZ)
i_rthEnd       = input.int(960, "RTH fin (min del dia, hora NY; 960=16:00)", minval = 0, maxval = 1440, group = GRP_KZ)
i_mtfCapOB    = input.int(2, "Traspaso OB por HTF (0-10, 0=off)",    minval = 0, maxval = 10, group = GRP_MTF)
i_mtfCapFVG   = input.int(2, "Traspaso FVG por HTF (0-10, 0=off)",   minval = 0, maxval = 10, group = GRP_MTF)
i_mtfCapPool  = input.int(2, "Traspaso Pools por HTF (0-10, 0=off)", minval = 0, maxval = 10, group = GRP_MTF)
i_mtfCapSweep = input.int(2, "Traspaso Sweeps por HTF (0-10, 0=off)", minval = 0, maxval = 10, group = GRP_MTF)
