i_mtfCapCHoCH = input.int(1, "Traspaso CHoCH por HTF (0-10, 0=off)",   minval = 0, maxval = 10, group = GRP_MTF)
i_smtEnable   = input.bool(false, "SMT: activar (par correlacionado) §5.13/ADR-011", group = GRP_MTF)
i_smtSymbol   = input.symbol("GBPUSD", "SMT: simbolo correlacionado", group = GRP_MTF)
i_smtInverse  = input.bool(false, "SMT: correlacion inversa (DXY/USDCHF)", group = GRP_MTF)

// === LIBRARY CORE ===
// ---------------------------------------------------------------------------
// Nucleo de deteccion SMC/ICT. BYTE-IDENTICO en SMC-Visual y SMC-Strategy
// (lo vigila scripts/check-core-sync.ps1 — regla dura #2). El core NO dibuja y
// NO llama request.security(): solo tipos, constantes y funciones puras
// (entradas -> detecciones). La version exportable equivalente vive en
// SMC-Library.pine [D-PINE-01]. Esqueleto F1-S1.1-T01: tipos + constantes +
// arrays acotados; las f_detect*/f_compute* se añaden en T02+.
// ---------------------------------------------------------------------------
// Constantes 'kind' por categoria [reglas-dev §1.2 · PINE-PLAN §2]
KIND_OB          = 1
KIND_FVG         = 2
KIND_BREAKER     = 3
KIND_REJECTION   = 4
KIND_MITIGATION  = 5
KIND_OTE         = 6
KIND_GP          = 7
KIND_POOL         = 8
KIND_BOS          = 20
KIND_CHOCH        = 21
KIND_MSS          = 22
KIND_SWEEP        = 23
KIND_GRAB         = 24
KIND_JUDAS        = 25
KIND_DISPLACEMENT = 26
KIND_IDM          = 27
KIND_EMACROSS     = 28
KIND_EMABOUNCE    = 29
KIND_FLIP         = 30
KIND_FALSEBREAK   = 31
KIND_SPRING       = 32
KIND_RAID         = 33
KIND_IMPULSIVE    = 34
KIND_CORRECTIVE   = 35
KIND_EMASTACK     = 36
KIND_IFVG         = 37
KIND_BPR          = 38
KIND_IR           = 39
KIND_HH = 40
KIND_HL = 41
KIND_LH = 42
KIND_LL = 43
KIND_EQH = 44
KIND_EQL = 45
KIND_VI  = 46
KIND_BAG = 47
KIND_CISD = 48
KIND_VACUUM = 49
KIND_IPR  = 50
KIND_INSIDEDAY = 51
KIND_SMT  = 52
KIND_GRADIENT  = 53
DIR_BULL     = 1
DIR_BEAR     = -1
ZS_ACTIVE    = 0
ZS_PARTIAL   = 1
ZS_MITIGATED = 2
ZS_INVALID   = 3
LF_PENDING = 0
LF_FLIPPED = 1
LF_INVALID = 2
PD_DISCOUNT    = -1
PD_EQUILIBRIUM = 0
PD_PREMIUM     = 1
GRAD_SRC_PD         = 0
GRAD_SRC_SUSPENSION = 1
GRAD_SRC_OPENGAP    = 2
KZ_NONE   = 0
KZ_LONDON = 1
KZ_NY     = 2
KZ_TOKYO  = 3
SP_NONE      = 0
SP_LONDON_NY = 1
SP_ASIA      = 2
MAX_ZONES  = 50
MAX_EVENTS = 100
MAX_SWINGS = 100
MAX_POOLS  = 50
MAX_BARBUF = 500
MAX_FLIPS  = 30
